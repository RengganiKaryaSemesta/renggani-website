---
import Layout from "../../layouts/Layout.astro";
import BukuBatikHero from "@components/organisms/BukuBatikHero.astro";
import BukuBatikShowcase from "@components/organisms/BukuBatikShowcase.astro";
import PricingList from "@components/organisms/PricingList.astro";
import CallToAction from "@components/organisms/CallToAction.astro";

const pageTitle = "BukuBatik — Sistem Akuntansi Modern & Terpadu Perusahaan | Renggani";
const pageDescription = "BukuBatik adalah sistem akuntansi terpadu untuk perusahaan dan UMKM. Terinspirasi dari ketelitian buku akuntansi sampul batik klasik, kini hadir lengkap dengan kalkulasi HPP, Purchase Order (PO), Kartu Piutang, Laporan Keuangan, dan Rekonsiliasi Bank.";
const pageKeywords = "buku batik, bukubatik, sistem akuntansi perusahaan, aplikasi akuntansi, aplikasi pembukuan usaha, kalkulasi hpp produk, kartu piutang pelanggan, purchase order, rekonsiliasi bank otomatis, software house banyuwangi, cv renggani karya semesta";
const ogImageUrl = "https://www.rengganikaryasemesta.com/buku-batik.png";

// JSON-LD Structured Data Schema.org for Google Search Rich Snippets
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "BukuBatik",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Web, Cloud",
      "offers": {
        "@type": "AggregateOffer",
        "lowPrice": "300000",
        "highPrice": "1000000",
        "priceCurrency": "IDR",
        "offerCount": "3"
      },
      "description": pageDescription,
      "publisher": {
        "@type": "Organization",
        "name": "CV. Renggani Karya Semesta",
        "url": "https://www.rengganikaryasemesta.com"
      },
      "featureList": [
        "Siklus Pembelian (Invoice, Payment, Return, PO, PR, Quote)",
        "Siklus Penjualan (Invoice, Payment, Return, SO, Quote)",
        "Persediaan & Valuasi HPP (Average Cost & FIFO)",
        "Kartu Piutang & Customer Ledger",
        "Laporan Keuangan & General Ledger (Buku Besar, Neraca, Laba Rugi)",
        "Rekonsiliasi Bank & Pencocokan Otomatis",
        "Manajemen Aset Tetap & Penyusutan",
        "Multi-Cabang & Hak Akses Berjenjang"
      ]
    },
    {
      "@type": "Product",
      "name": "BukuBatik Accounting System",
      "image": ogImageUrl,
      "description": pageDescription,
      "brand": {
        "@type": "Brand",
        "name": "BukuBatik"
      },
      "seller": {
        "@type": "Organization",
        "name": "CV. Renggani Karya Semesta"
      }
    }
  ]
};
---

<Layout
    title={pageTitle}
    description={pageDescription}
    keywords={pageKeywords}
    image={ogImageUrl}
    type="product"
    isSolid={true}
>
    <!-- JSON-LD Structured Data for Rich Search Snippets -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} slot="head" />

    <!-- 1. Hero: Apa itu BukuBatik & Dasbor Preview -->
    <BukuBatikHero />

    <!-- 2. Showcase: Modul Inti & Arsitektur Akuntansi Terpadu (Asymmetric Bento) -->
    <BukuBatikShowcase />

    <!-- 3. Paket & Harga Lengkap (Starter, Bisnis, Enterprise + Matriks 29 Fitur) -->
    <div id="paket-harga" class="scroll-mt-16">
        <PricingList />
    </div>

    <!-- 4. Penutup CTA -->
    <CallToAction />
</Layout>
