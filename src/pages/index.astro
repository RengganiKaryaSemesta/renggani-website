---
import Layout from "../layouts/Layout.astro";
import HomeHero from "@components/organisms/HomeHero.astro";
import HomeProducts from "@components/organisms/HomeProducts.astro";
import CaseStudyTabs from "@components/organisms/CaseStudyTabs.astro";
import VisualFeatureRows from "@components/organisms/VisualFeatureRows.astro";
import CtaBand from "@components/organisms/CtaBand.astro";
import StatTile from "@components/atoms/StatTile.astro";
import SectionHeader from "@components/molecules/SectionHeader.astro";
import ScreenshotFrame from "@components/molecules/ScreenshotFrame.astro";
import MobileFrame from "@components/molecules/MobileFrame.astro";
import FaqAccordion from "@components/molecules/FaqAccordion.astro";
import TechLogoStrip from "@components/molecules/TechLogoStrip.astro";

import dashboardScreen from "@assets/buku-batik/dashboard-screen.png";
import penjualanScreen from "@assets/buku-batik/penjualan-screen.png";
import mobileAbsensi from "@assets/rksworkmate/mobile-absensi-facerecognition.png";
import mobileHome from "@assets/rksworkmate/mobile-home.png";
import reportAbsensi from "@assets/rksworkmate/report-absensi.png";
import laravel from "@assets/stacks/laravel.svg";
import next from "@assets/stacks/next.svg";
import react from "@assets/stacks/react.svg";
import vue from "@assets/stacks/vue.svg";
import flutter from "@assets/stacks/flutter.svg";
import docker from "@assets/stacks/docker.svg";
import nodejs from "@assets/stacks/nodejs.svg";
import python from "@assets/stacks/python.svg";
import tailwind from "@assets/stacks/tailwind.svg";
import aws from "@assets/stacks/aws.svg";

const whatsappHref = "https://api.whatsapp.com/send?phone=6289512589756&text=Halo%20Renggani%2C%20saya%20mau%20konsultasi%20kebutuhan%20software.";
const homeSchema = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "WebSite", "@id": "https://rengganikaryasemesta.com/#website", "url": "https://rengganikaryasemesta.com/", "name": "CV. Renggani Karya Semesta", "description": "Software house & digital engineering partner terpercaya di Indonesia. Membangun produk SaaS BukuBatik dan RKSWorkmate untuk operasional bisnis.", "potentialAction": { "@type": "SearchAction", "target": "https://rengganikaryasemesta.com/blogs/?q={search_term_string}", "query-input": "required name=search_term_string" } },
    { "@type": "ProfessionalService", "@id": "https://rengganikaryasemesta.com/#localservice", "name": "CV. Renggani Karya Semesta", "image": "https://rengganikaryasemesta.com/logo_color.webp", "url": "https://rengganikaryasemesta.com/", "telephone": "+6289512589756", "priceRange": "11951", "address": { "@type": "PostalAddress", "streetAddress": "Jl. Kemiren, Kemiren, Kec. Glagah", "addressLocality": "Kabupaten Banyuwangi", "addressRegion": "Jawa Timur", "postalCode": "68432", "addressCountry": "ID" } }
  ]
};

const products = [
  { title: "BukuBatik", line: "Kasir, stok, dan laporan keuangan dalam satu aplikasi.", href: "/bukubatik", linkLabel: "Lihat BukuBatik", image: dashboardScreen, alt: "Dashboard akuntansi BukuBatik" },
  { title: "RKSWorkmate", line: "Presensi GPS dan payroll otomatis.", href: "/rksworkmate", linkLabel: "Lihat RKSWorkmate", image: mobileHome, alt: "Aplikasi mobile RKSWorkmate" },
];

const caseStudies = [
  { id: "bukubatik", tabTitle: "BukuBatik", tabSubtitle: "Multi-tenant SaaS", badge: "Akuntansi & kasir", badgeState: "Live production", headline: "Akuntansi dan kasir untuk transaksi bervolume tinggi", body: "Data terisolasi per tenant dengan antrean worker asinkron.", image: dashboardScreen, alt: "Dashboard BukuBatik", caption: "BukuBatik - modul dashboard", stats: [{ value: "100.000+", label: "Nota per bulan" }, { value: "Zero leak", label: "Isolasi data tenant" }], stack: ["Go", "Laravel", "PostgreSQL", "Redis"] },
  { id: "payroll", tabTitle: "HRIS & Payroll", tabSubtitle: "Multi-cabang", badge: "SDM", badgeState: "Live production", headline: "Payroll otomatis dan ekspor batch bank", body: "Lembur berlapis, potongan pajak, dan presensi face recognition.", image: reportAbsensi, alt: "Laporan absensi RKSWorkmate", caption: "RKSWorkmate - laporan absensi", stats: [{ value: "1 klik", label: "Batch transfer" }, { value: "Compliance", label: "Potongan pajak" }], stack: ["Laravel", "Vue.js", "PostgreSQL"] },
];

const logos = [
  { src: laravel, alt: "Laravel", name: "Laravel" }, { src: next, alt: "Next.js", name: "Next.js" }, { src: react, alt: "React", name: "React" }, { src: vue, alt: "Vue", name: "Vue" }, { src: flutter, alt: "Flutter", name: "Flutter" }, { src: docker, alt: "Docker", name: "Docker" }, { src: nodejs, alt: "Node.js", name: "Node.js" }, { src: python, alt: "Python", name: "Python" }, { src: tailwind, alt: "Tailwind CSS", name: "Tailwind CSS" }, { src: aws, alt: "AWS", name: "AWS" },
];

const faqs = [
  { q: "Apakah source code jadi milik klien?", a: "Ya, seluruh source code, database, dan dokumentasi menjadi aset perusahaan Anda setelah proyek selesai." },
  { q: "Bisa bayar bertahap?", a: "Bisa, pembayaran dibagi per milestone hasil kerja nyata." },
  { q: "Ada garansi setelah rilis?", a: "Ada, garansi perbaikan bug 30 sampai 90 hari setelah go-live." },
];
---

<Layout title="Renggani Karya Semesta - Software House & Produk Digital Terpercaya" description="Solusi software bisnis andalan: BukuBatik SaaS kasir & akuntansi, RKSWorkmate HRIS payroll, serta jasa pembuatan web app & sistem ERP kustom teruji." keywords="software house banyuwangi, bukubatik, rksworkmate, jasa pembuatan website, aplikasi kasir, sistem erp pergudangan, cv renggani karya semesta" isSolid={true}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(homeSchema)} slot="head" />

  <HomeHero eyebrow="Software house & mitra rekayasa sistem bisnis" title={{ lead: "Software bisnis yang", accent: "langsung jalan" }} subtitle="Dua produk SaaS untuk operasional harian: akuntansi BukuBatik dan HR serta payroll RKSWorkmate." primary={{ label: "Konsultasi via WhatsApp", href: whatsappHref }} secondary={{ label: "Lihat produk", href: "#produk" }} accent="blue">
    <div slot="visual" class="relative px-2 sm:px-6">
      <ScreenshotFrame image={dashboardScreen} alt="Dashboard produksi BukuBatik" caption="BukuBatik - dashboard produksi" priority />
    </div>
    <div slot="mobile-left"><MobileFrame image={mobileHome} alt="Beranda mobile RKSWorkmate" tilt="left" /></div>
    <div slot="mobile-right"><MobileFrame image={mobileAbsensi} alt="Presensi mobile RKSWorkmate" tilt="right" /></div>
  </HomeHero>

  <section id="produk" class="py-6 md:py-8">
    <div class="max-w-6xl mx-auto grid grid-cols-1 gap-3 px-5 sm:grid-cols-3 lg:px-8">
      <StatTile value="100.000+" label="Nota per bulan" icon="mdi:receipt-text-outline" tone="blue" class="p-3" />
      <StatTile value="100%" label="Source code milik Anda" icon="mdi:shield-check-outline" tone="blue" class="p-3" />
      <StatTile value="2" label="Produk SaaS aktif" icon="mdi:server-outline" tone="blue" class="p-3" />
    </div>
  </section>

  <HomeProducts title="Pilih titik mulai Anda" items={products} accent="blue" />

  <section id="case-studies" class="bg-slate-50 border-y border-slate-200/80 py-16 md:py-24">
    <div class="max-w-6xl mx-auto px-5 lg:px-8">
      <SectionHeader title="Dua produk SaaS yang sudah berjalan" description="BukuBatik untuk operasional akuntansi dan RKSWorkmate untuk HR serta payroll." />
      <CaseStudyTabs items={caseStudies} accent="blue" class="mt-10" />
    </div>
  </section>

  <section class="py-16 md:py-24">
    <div class="max-w-6xl mx-auto px-5 lg:px-8">
      <SectionHeader title="Sistem yang dekat dengan alur kerja Anda" />
      <VisualFeatureRows class="mt-10" accent="blue" items={[{ title: "BukuBatik: operasional harian", body: "Penjualan, pembelian, piutang, dan rekonsiliasi bank dalam satu alur.", bullets: ["Multi-cabang dan multi-gudang", "Barcode dan printer termal", "Laporan siap audit"], media: { kind: "screenshot", image: penjualanScreen, alt: "Modul penjualan BukuBatik", caption: "BukuBatik - modul penjualan" }, href: "/bukubatik", hrefLabel: "Lihat modul" }, { title: "RKSWorkmate: presensi dan payroll", body: "Absensi GPS dan wajah, gaji dihitung otomatis.", bullets: ["Anti fake GPS", "Payroll satu klik", "Ekspor batch bank"], media: { kind: "mobile", images: [{ image: mobileAbsensi, alt: "Presensi face recognition RKSWorkmate" }, { image: mobileHome, alt: "Beranda RKSWorkmate" }] }, href: "/rksworkmate", hrefLabel: "Lihat RKSWorkmate" }]} />
    </div>
  </section>

  <section class="bg-slate-50 border-y border-slate-200/80 py-16 md:py-24">
    <div class="max-w-6xl mx-auto px-5 lg:px-8">
      <SectionHeader title="Stack yang kami pakai setiap hari" />
      <TechLogoStrip logos={logos} class="mt-10" />
    </div>
  </section>


  <section class="bg-slate-50 border-y border-slate-200/80 py-16 md:py-24">
    <div class="max-w-4xl mx-auto px-5 lg:px-8">
      <SectionHeader title="Pertanyaan yang sering ditanyakan" align="center" />
      <FaqAccordion items={faqs} class="mt-10" />
    </div>
  </section>

  <CtaBand title="Punya proses yang masih manual?" line="Ceritakan alurnya, kami petakan sistem yang pas." primary={{ label: "Konsultasi via WhatsApp", href: whatsappHref }} secondary={{ label: "Kirim email", href: "mailto:contact@rengganikaryasemesta.com" }} accent="blue" />
</Layout>
