---
import Layout from "../layouts/Layout.astro";
import { Icon } from "astro-icon/components";

const lastUpdated = "3 Agustus 2026";
---

<Layout
    title="Kebijakan Privasi - CV. Renggani Karya Semesta"
    description="Kebijakan Privasi CV. Renggani Karya Semesta. Informasi mengenai pengumpulan, penggunaan, penyimpanan, dan perlindungan data pribadi serta verifikasi OTP WhatsApp."
>
    <!-- Hero Banner -->
    <header class="relative pt-32 pb-16 bg-gradient-to-br from-blue-900 via-blue-950 to-gray-900 text-white overflow-hidden">
        <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-blue-500/10 via-transparent to-transparent"></div>
        <div class="max-w-7xl mx-auto px-5 lg:px-20 relative z-10">
            <!-- Breadcrumb -->
            <nav class="flex items-center gap-2 text-sm text-blue-200/80 mb-6">
                <a href="/" class="hover:text-white transition-colors">Beranda</a>
                <Icon name="mdi:chevron-right" class="text-base" />
                <span class="text-white font-medium">Kebijakan Privasi</span>
            </nav>

            <div class="max-w-3xl space-y-4">
                <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-blue-500/20 border border-blue-400/30 text-blue-200 text-xs font-semibold uppercase tracking-wider">
                    <Icon name="mdi:shield-check" class="text-base text-blue-400" />
                    <span>Perlindungan Data & Privasi</span>
                </div>
                <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight leading-tight">
                    Kebijakan Privasi
                </h1>
                <p class="text-lg text-blue-100/90 font-medium">
                    CV. Renggani Karya Semesta
                </p>
                <div class="pt-2 flex items-center gap-2 text-sm text-blue-200/80">
                    <Icon name="mdi:calendar-clock" class="text-lg text-blue-400" />
                    <span>Terakhir diperbarui: <strong>{lastUpdated}</strong></span>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Content Area -->
    <main class="bg-gray-50 dark:bg-gray-950 py-12 lg:py-16 font-roboto transition-colors">
        <div class="max-w-7xl mx-auto px-5 lg:px-20">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
                
                <!-- Navigation Sidebar (Table of Contents) -->
                <aside class="lg:col-span-4 order-2 lg:order-1">
                    <div class="lg:sticky lg:top-28 space-y-6">
                        <div class="bg-white dark:bg-gray-900 p-6 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-800">
                            <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-4 flex items-center gap-2">
                                <Icon name="mdi:format-list-bulleted" class="text-blue-600 dark:text-blue-400" />
                                <span>Daftar Isi</span>
                            </h3>
                            <nav class="space-y-1">
                                <a href="#pendahuluan" class="flex items-center gap-3 px-3 py-2 text-sm text-gray-600 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 hover:bg-blue-50/50 dark:hover:bg-gray-800 rounded-lg transition-all font-medium">
                                    <span class="w-6 h-6 flex items-center justify-center text-xs font-bold bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300 rounded-md">1</span>
                                    <span>Pendahuluan</span>
                                </a>
                                <a href="#informasi" class="flex items-center gap-3 px-3 py-2 text-sm text-gray-600 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 hover:bg-blue-50/50 dark:hover:bg-gray-800 rounded-lg transition-all font-medium">
                                    <span class="w-6 h-6 flex items-center justify-center text-xs font-bold bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300 rounded-md">2</span>
                                    <span>Informasi yang Kami Kumpulkan</span>
                                </a>
                                <a href="#penggunaan" class="flex items-center gap-3 px-3 py-2 text-sm text-gray-600 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 hover:bg-blue-50/50 dark:hover:bg-gray-800 rounded-lg transition-all font-medium">
                                    <span class="w-6 h-6 flex items-center justify-center text-xs font-bold bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300 rounded-md">3</span>
                                    <span>Penggunaan Informasi</span>
                                </a>
                                <a href="#pihak-ketiga" class="flex items-center gap-3 px-3 py-2 text-sm text-gray-600 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 hover:bg-blue-50/50 dark:hover:bg-gray-800 rounded-lg transition-all font-medium">
                                    <span class="w-6 h-6 flex items-center justify-center text-xs font-bold bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300 rounded-md">4</span>
                                    <span>Berbagi dengan Pihak Ketiga</span>
                                </a>
                                <a href="#penyimpanan-keamanan" class="flex items-center gap-3 px-3 py-2 text-sm text-gray-600 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 hover:bg-blue-50/50 dark:hover:bg-gray-800 rounded-lg transition-all font-medium">
                                    <span class="w-6 h-6 flex items-center justify-center text-xs font-bold bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300 rounded-md">5</span>
                                    <span>Penyimpanan & Keamanan Data</span>
                                </a>
                                <a href="#hak-anda" class="flex items-center gap-3 px-3 py-2 text-sm text-gray-600 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 hover:bg-blue-50/50 dark:hover:bg-gray-800 rounded-lg transition-all font-medium">
                                    <span class="w-6 h-6 flex items-center justify-center text-xs font-bold bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300 rounded-md">6</span>
                                    <span>Hak Anda</span>
                                </a>
                                <a href="#perubahan-kebijakan" class="flex items-center gap-3 px-3 py-2 text-sm text-gray-600 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 hover:bg-blue-50/50 dark:hover:bg-gray-800 rounded-lg transition-all font-medium">
                                    <span class="w-6 h-6 flex items-center justify-center text-xs font-bold bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300 rounded-md">7</span>
                                    <span>Perubahan Kebijakan</span>
                                </a>
                                <a href="#kontak-kami" class="flex items-center gap-3 px-3 py-2 text-sm text-gray-600 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 hover:bg-blue-50/50 dark:hover:bg-gray-800 rounded-lg transition-all font-medium">
                                    <span class="w-6 h-6 flex items-center justify-center text-xs font-bold bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300 rounded-md">8</span>
                                    <span>Kontak Kami</span>
                                </a>
                            </nav>
                        </div>

                        <!-- Contact Support Box -->
                        <div class="p-6 bg-gradient-to-br from-blue-600 to-blue-800 rounded-2xl text-white shadow-lg space-y-4">
                            <div class="flex items-center gap-3">
                                <div class="p-3 bg-white/10 rounded-xl">
                                    <Icon name="mdi:help-circle-outline" class="text-2xl" />
                                </div>
                                <div>
                                    <h4 class="font-bold text-base">Ada Pertanyaan?</h4>
                                    <p class="text-xs opacity-90">Tim kami siap membantu Anda.</p>
                                </div>
                            </div>
                            <p class="text-xs text-blue-100 leading-relaxed">
                                Jika Anda memiliki pertanyaan seputar Kebijakan Privasi atau penggunaan data pribadi Anda, jangan ragu untuk menghubungi kami.
                            </p>
                            <a 
                                href="https://api.whatsapp.com/send?phone=6289512589756" 
                                target="_blank" 
                                rel="noopener noreferrer"
                                class="flex items-center justify-center gap-2 w-full py-3 bg-white text-blue-800 font-bold text-sm rounded-xl hover:bg-blue-50 transition-colors shadow-md"
                            >
                                <Icon name="mdi:whatsapp" class="text-lg text-emerald-600" />
                                <span>Hubungi via WhatsApp</span>
                            </a>
                        </div>
                    </div>
                </aside>

                <!-- Policy Sections Content -->
                <div class="lg:col-span-8 order-1 lg:order-2 space-y-8">
                    
                    <!-- Section 1: Pendahuluan -->
                    <section id="pendahuluan" class="scroll-mt-32 bg-white dark:bg-gray-900 p-6 md:p-8 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-800 space-y-4">
                        <div class="flex items-center gap-3 pb-3 border-b border-gray-100 dark:border-gray-800">
                            <div class="w-10 h-10 rounded-xl bg-blue-100 dark:bg-blue-950 text-blue-600 dark:text-blue-400 flex items-center justify-center font-bold text-lg">
                                1
                            </div>
                            <h2 class="text-2xl font-bold text-gray-900 dark:text-white">
                                Pendahuluan
                            </h2>
                        </div>
                        <div class="text-gray-700 dark:text-gray-300 leading-relaxed space-y-4">
                            <p>
                                <strong>CV. Renggani Karya Semesta</strong> ("kami", "perusahaan") menghormati privasi Anda dan berkomitmen untuk melindungi data pribadi yang Anda berikan saat menggunakan layanan kami, termasuk fitur verifikasi nomor telepon melalui WhatsApp (One-Time Password/OTP).
                            </p>
                            <p>
                                Kebijakan Privasi ini menjelaskan bagaimana kami mengumpulkan, menggunakan, menyimpan, dan melindungi informasi Anda ketika berinteraksi dengan sistem dan platform layanan kami.
                            </p>
                        </div>
                    </section>

                    <!-- Section 2: Informasi yang Kami Kumpulkan -->
                    <section id="informasi" class="scroll-mt-32 bg-white dark:bg-gray-900 p-6 md:p-8 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-800 space-y-4">
                        <div class="flex items-center gap-3 pb-3 border-b border-gray-100 dark:border-gray-800">
                            <div class="w-10 h-10 rounded-xl bg-blue-100 dark:bg-blue-950 text-blue-600 dark:text-blue-400 flex items-center justify-center font-bold text-lg">
                                2
                            </div>
                            <h2 class="text-2xl font-bold text-gray-900 dark:text-white">
                                Informasi yang Kami Kumpulkan
                            </h2>
                        </div>
                        <div class="text-gray-700 dark:text-gray-300 leading-relaxed space-y-4">
                            <p>
                                Dalam menjalankan layanan, kami dapat mengumpulkan informasi berikut:
                            </p>
                            <ul class="space-y-3">
                                <li class="flex items-start gap-3 p-3 bg-gray-50 dark:bg-gray-800/50 rounded-xl">
                                    <Icon name="mdi:cellphone-message" class="text-2xl text-blue-600 dark:text-blue-400 shrink-0 mt-0.5" />
                                    <div>
                                        <strong class="text-gray-900 dark:text-white">Nomor telepon:</strong> 
                                        <span>yang Anda daftarkan, digunakan untuk mengirimkan pesan transaksional dan kode verifikasi (OTP) melalui WhatsApp.</span>
                                    </div>
                                </li>
                                <li class="flex items-start gap-3 p-3 bg-gray-50 dark:bg-gray-800/50 rounded-xl">
                                    <Icon name="mdi:account-details-outline" class="text-2xl text-blue-600 dark:text-blue-400 shrink-0 mt-0.5" />
                                    <div>
                                        <strong class="text-gray-900 dark:text-white">Data identitas dasar:</strong> 
                                        <span>seperti nama, yang Anda berikan saat pendaftaran akun atau transaksi.</span>
                                    </div>
                                </li>
                                <li class="flex items-start gap-3 p-3 bg-gray-50 dark:bg-gray-800/50 rounded-xl">
                                    <Icon name="mdi:server-security" class="text-2xl text-blue-600 dark:text-blue-400 shrink-0 mt-0.5" />
                                    <div>
                                        <strong class="text-gray-900 dark:text-white">Log aktivitas teknis:</strong> 
                                        <span>seperti waktu permintaan OTP, status pengiriman pesan, dan alamat IP, untuk keperluan keamanan dan pencegahan penyalahgunaan.</span>
                                    </div>
                                </li>
                            </ul>
                            
                            <!-- Important Note Box -->
                            <div class="p-4 bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-900/50 rounded-xl flex items-start gap-3 text-amber-900 dark:text-amber-200 text-sm">
                                <Icon name="mdi:shield-alert-outline" class="text-2xl text-amber-600 dark:text-amber-400 shrink-0 mt-0.5" />
                                <p>
                                    Kami <strong>TIDAK</strong> mengumpulkan isi percakapan WhatsApp pribadi Anda di luar proses pengiriman kode OTP.
                                </p>
                            </div>
                        </div>
                    </section>

                    <!-- Section 3: Bagaimana Kami Menggunakan Informasi Anda -->
                    <section id="penggunaan" class="scroll-mt-32 bg-white dark:bg-gray-900 p-6 md:p-8 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-800 space-y-4">
                        <div class="flex items-center gap-3 pb-3 border-b border-gray-100 dark:border-gray-800">
                            <div class="w-10 h-10 rounded-xl bg-blue-100 dark:bg-blue-950 text-blue-600 dark:text-blue-400 flex items-center justify-center font-bold text-lg">
                                3
                            </div>
                            <h2 class="text-2xl font-bold text-gray-900 dark:text-white">
                                Bagaimana Kami Menggunakan Informasi Anda
                            </h2>
                        </div>
                        <div class="text-gray-700 dark:text-gray-300 leading-relaxed space-y-4">
                            <p>
                                Informasi yang dikumpulkan digunakan secara spesifik untuk tujuan berikut:
                            </p>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div class="p-4 border border-gray-100 dark:border-gray-800 rounded-xl bg-gray-50/50 dark:bg-gray-800/30 space-y-2">
                                    <div class="flex items-center gap-2 text-blue-600 dark:text-blue-400 font-bold">
                                        <Icon name="mdi:message-lock-outline" class="text-xl" />
                                        <span>Verifikasi Identitas & OTP</span>
                                    </div>
                                    <p class="text-sm text-gray-600 dark:text-gray-400">
                                        Mengirimkan pesan (termasuk kode OTP) guna memverifikasi identitas atau nomor telepon Anda, serta menyampaikan notifikasi terkait layanan kami.
                                    </p>
                                </div>
                                <div class="p-4 border border-gray-100 dark:border-gray-800 rounded-xl bg-gray-50/50 dark:bg-gray-800/30 space-y-2">
                                    <div class="flex items-center gap-2 text-blue-600 dark:text-blue-400 font-bold">
                                        <Icon name="mdi:lock-check-outline" class="text-xl" />
                                        <span>Keamanan Akun</span>
                                    </div>
                                    <p class="text-sm text-gray-600 dark:text-gray-400">
                                        Mengamankan akun Anda dari akses yang tidak sah dan mencegah aktivitas ilegal.
                                    </p>
                                </div>
                                <div class="p-4 border border-gray-100 dark:border-gray-800 rounded-xl bg-gray-50/50 dark:bg-gray-800/30 space-y-2">
                                    <div class="flex items-center gap-2 text-blue-600 dark:text-blue-400 font-bold">
                                        <Icon name="mdi:speedometer" class="text-xl" />
                                        <span>Pencegahan Penyalahgunaan</span>
                                    </div>
                                    <p class="text-sm text-gray-600 dark:text-gray-400">
                                        Mencegah penyalahgunaan sistem, termasuk pembatasan jumlah permintaan OTP (cooldown) untuk keamanan server.
                                    </p>
                                </div>
                                <div class="p-4 border border-gray-100 dark:border-gray-800 rounded-xl bg-gray-50/50 dark:bg-gray-800/30 space-y-2">
                                    <div class="flex items-center gap-2 text-blue-600 dark:text-blue-400 font-bold">
                                        <Icon name="mdi:gavel" class="text-xl" />
                                        <span>Kepatuhan Hukum</span>
                                    </div>
                                    <p class="text-sm text-gray-600 dark:text-gray-400">
                                        Memenuhi kewajiban hukum atau permintaan resmi dari pihak berwenang, bila diperlukan sesuai peraturan.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- Section 4: Berbagi Informasi dengan Pihak Ketiga -->
                    <section id="pihak-ketiga" class="scroll-mt-32 bg-white dark:bg-gray-900 p-6 md:p-8 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-800 space-y-4">
                        <div class="flex items-center gap-3 pb-3 border-b border-gray-100 dark:border-gray-800">
                            <div class="w-10 h-10 rounded-xl bg-blue-100 dark:bg-blue-950 text-blue-600 dark:text-blue-400 flex items-center justify-center font-bold text-lg">
                                4
                            </div>
                            <h2 class="text-2xl font-bold text-gray-900 dark:text-white">
                                Berbagi Informasi dengan Pihak Ketiga
                            </h2>
                        </div>
                        <div class="text-gray-700 dark:text-gray-300 leading-relaxed space-y-4">
                            <p>
                                Untuk mengirimkan OTP melalui WhatsApp, kami menggunakan layanan penyedia API pesan pihak ketiga. Nomor telepon Anda dapat diproses oleh penyedia layanan tersebut semata-mata untuk tujuan pengiriman pesan, dan tunduk pada kebijakan privasi masing-masing penyedia.
                            </p>
                            <div class="p-4 bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-900/50 rounded-xl flex items-start gap-3 text-emerald-900 dark:text-emerald-200 text-sm font-medium">
                                <Icon name="mdi:check-decagram" class="text-2xl text-emerald-600 dark:text-emerald-400 shrink-0 mt-0.5" />
                                <p>
                                    Kami <strong>TIDAK MENJUAL</strong> atau menyewakan data pribadi Anda kepada pihak ketiga mana pun untuk tujuan pemasaran atau komersial.
                                </p>
                            </div>
                        </div>
                    </section>

                    <!-- Section 5: Penyimpanan dan Keamanan Data -->
                    <section id="penyimpanan-keamanan" class="scroll-mt-32 bg-white dark:bg-gray-900 p-6 md:p-8 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-800 space-y-4">
                        <div class="flex items-center gap-3 pb-3 border-b border-gray-100 dark:border-gray-800">
                            <div class="w-10 h-10 rounded-xl bg-blue-100 dark:bg-blue-950 text-blue-600 dark:text-blue-400 flex items-center justify-center font-bold text-lg">
                                5
                            </div>
                            <h2 class="text-2xl font-bold text-gray-900 dark:text-white">
                                Penyimpanan dan Keamanan Data
                            </h2>
                        </div>
                        <div class="text-gray-700 dark:text-gray-300 leading-relaxed space-y-4">
                            <ul class="space-y-3">
                                <li class="flex items-start gap-3">
                                    <Icon name="mdi:database-lock-outline" class="text-xl text-blue-600 dark:text-blue-400 shrink-0 mt-1" />
                                    <span>
                                        Data disimpan pada server yang kami kelola dengan langkah-langkah keamanan yang wajar, termasuk <strong>enkripsi saat transit</strong> (in-transit encryption) dan pembatasan akses internal yang ketat.
                                    </span>
                                </li>
                                <li class="flex items-start gap-3">
                                    <Icon name="mdi:timer-sand" class="text-xl text-blue-600 dark:text-blue-400 shrink-0 mt-1" />
                                    <span>
                                        Kode OTP bersifat sementara dan akan kedaluwarsa dalam waktu singkat (umumnya beberapa menit) setelah diterbitkan.
                                    </span>
                                </li>
                                <li class="flex items-start gap-3">
                                    <Icon name="mdi:clock-check-outline" class="text-xl text-blue-600 dark:text-blue-400 shrink-0 mt-1" />
                                    <span>
                                        Kami menyimpan data pribadi hanya selama diperlukan untuk tujuan yang dijelaskan dalam kebijakan ini, atau sesuai ketentuan hukum yang berlaku.
                                    </span>
                                </li>
                            </ul>
                        </div>
                    </section>

                    <!-- Section 6: Hak Anda -->
                    <section id="hak-anda" class="scroll-mt-32 bg-white dark:bg-gray-900 p-6 md:p-8 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-800 space-y-4">
                        <div class="flex items-center gap-3 pb-3 border-b border-gray-100 dark:border-gray-800">
                            <div class="w-10 h-10 rounded-xl bg-blue-100 dark:bg-blue-950 text-blue-600 dark:text-blue-400 flex items-center justify-center font-bold text-lg">
                                6
                            </div>
                            <h2 class="text-2xl font-bold text-gray-900 dark:text-white">
                                Hak Anda
                            </h2>
                        </div>
                        <div class="text-gray-700 dark:text-gray-300 leading-relaxed space-y-4">
                            <p>
                                Sebagai pemilik data pribadi, Anda memiliki hak-hak berikut:
                            </p>
                            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                                <div class="p-4 border border-gray-100 dark:border-gray-800 rounded-xl bg-gray-50/50 dark:bg-gray-800/30 text-center space-y-2">
                                    <div class="w-10 h-10 mx-auto rounded-full bg-blue-100 dark:bg-blue-900/50 flex items-center justify-center text-blue-600 dark:text-blue-400">
                                        <Icon name="mdi:eye-outline" class="text-xl" />
                                    </div>
                                    <h4 class="font-bold text-gray-900 dark:text-white text-sm">Hak Akses</h4>
                                    <p class="text-xs text-gray-600 dark:text-gray-400">
                                        Meminta akses terhadap data pribadi yang kami simpan tentang Anda.
                                    </p>
                                </div>
                                <div class="p-4 border border-gray-100 dark:border-gray-800 rounded-xl bg-gray-50/50 dark:bg-gray-800/30 text-center space-y-2">
                                    <div class="w-10 h-10 mx-auto rounded-full bg-blue-100 dark:bg-blue-900/50 flex items-center justify-center text-blue-600 dark:text-blue-400">
                                        <Icon name="mdi:pencil-outline" class="text-xl" />
                                    </div>
                                    <h4 class="font-bold text-gray-900 dark:text-white text-sm">Hak Koreksi</h4>
                                    <p class="text-xs text-gray-600 dark:text-gray-400">
                                        Meminta koreksi atas data pribadi yang tidak akurat atau tidak lengkap.
                                    </p>
                                </div>
                                <div class="p-4 border border-gray-100 dark:border-gray-800 rounded-xl bg-gray-50/50 dark:bg-gray-800/30 text-center space-y-2">
                                    <div class="w-10 h-10 mx-auto rounded-full bg-blue-100 dark:bg-blue-900/50 flex items-center justify-center text-blue-600 dark:text-blue-400">
                                        <Icon name="mdi:delete-outline" class="text-xl" />
                                    </div>
                                    <h4 class="font-bold text-gray-900 dark:text-white text-sm">Hak Penghapusan</h4>
                                    <p class="text-xs text-gray-600 dark:text-gray-400">
                                        Meminta penghapusan data pribadi Anda, sepanjang tidak bertentangan dengan hukum.
                                    </p>
                                </div>
                            </div>
                            <p class="text-sm text-gray-600 dark:text-gray-400 italic">
                                Permintaan untuk pelaksanaan hak dapat diajukan melalui kontak resmi kami yang tercantum pada Bagian 8.
                            </p>
                        </div>
                    </section>

                    <!-- Section 7: Perubahan Kebijakan -->
                    <section id="perubahan-kebijakan" class="scroll-mt-32 bg-white dark:bg-gray-900 p-6 md:p-8 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-800 space-y-4">
