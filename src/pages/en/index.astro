---
import Layout from "../../layouts/Layout.astro";
import HomeHero from "@components/organisms/HomeHero.astro";
import CaseStudyTabs from "@components/organisms/CaseStudyTabs.astro";
import PainContrast from "@components/organisms/PainContrast.astro";
import TimezoneOverlap from "@components/organisms/TimezoneOverlap.astro";
import EngagementPlans from "@components/organisms/EngagementPlans.astro";
import LeadershipBand from "@components/organisms/LeadershipBand.astro";
import CtaBand from "@components/organisms/CtaBand.astro";
import StatTile from "@components/atoms/StatTile.astro";
import SectionHeader from "@components/molecules/SectionHeader.astro";
import ScreenshotFrame from "@components/molecules/ScreenshotFrame.astro";
import MobileFrame from "@components/molecules/MobileFrame.astro";
import FaqAccordion from "@components/molecules/FaqAccordion.astro";
import TechLogoStrip from "@components/molecules/TechLogoStrip.astro";

import dashboardScreen from "@assets/buku-batik/dashboard-screen.png";
import mobileAbsensi from "@assets/rksworkmate/mobile-absensi-facerecognition.png";
import mobileHome from "@assets/rksworkmate/mobile-home.png";
import reportAbsensi from "@assets/rksworkmate/report-absensi.png";
import laravel from "@assets/stacks/laravel.svg";
import next from "@assets/stacks/next.svg";
import react from "@assets/stacks/react.svg";
import vue from "@assets/stacks/vue.svg";
import flutter from "@assets/stacks/flutter.svg";
import docker from "@assets/stacks/docker.svg";
import nodejs from "@assets/stacks/nodejs.svg";
import python from "@assets/stacks/python.svg";
import tailwind from "@assets/stacks/tailwind.svg";
import aws from "@assets/stacks/aws.svg";

const introHref = "https://api.whatsapp.com/send?phone=6289512589756&text=Hi%20Ach%20Rizal%2C%20we%20are%20an%20Australian%20agency%20interested%20in%20scaling%20our%20dev%20capacity.";
const aussieSchema = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "WebSite", "@id": "https://rengganikaryasemesta.com/en/#website", "url": "https://rengganikaryasemesta.com/en/", "name": "Renggani - Engineering Partner for Australian Digital Agencies", "description": "Expand your development team with senior Laravel, Go, Next.js, and Flutter engineers with real-time Australian timezone overlap.", "inLanguage": "en-AU" },
    { "@type": "ProfessionalService", "@id": "https://rengganikaryasemesta.com/en/#business", "name": "CV. Renggani Karya Semesta", "image": "https://rengganikaryasemesta.com/logo_color.webp", "url": "https://rengganikaryasemesta.com/en/", "telephone": "+6289512589756", "priceRange": "AUD", "address": { "@type": "PostalAddress", "addressLocality": "Banyuwangi", "addressRegion": "East Java", "addressCountry": "ID" }, "areaServed": [{ "@type": "Country", "name": "Australia" }] }
  ]
};

const caseStudies = [
  { id: "bukubatik", tabTitle: "BukuBatik", tabSubtitle: "Multi-tenant SaaS", badge: "Accounting", badgeState: "Live production", headline: "Accounting and invoicing built for high transaction volume", body: "Per-tenant data isolation with asynchronous worker queues.", image: dashboardScreen, alt: "BukuBatik dashboard", caption: "BukuBatik - dashboard module", stats: [{ value: "100,000+", label: "Invoices per month" }, { value: "Zero leak", label: "Tenant isolation" }], stack: ["Go", "Laravel", "PostgreSQL", "Redis"] },
  { id: "payroll", tabTitle: "HRIS & Payroll", tabSubtitle: "Multi-branch", badge: "People ops", badgeState: "Live production", headline: "Automated payroll and bank batch export", body: "Tiered overtime, tax deductions, and face-recognition attendance.", image: reportAbsensi, alt: "RKSWorkmate attendance report", caption: "RKSWorkmate - attendance report", stats: [{ value: "1 click", label: "Transfer batch" }, { value: "Compliance", label: "Statutory deductions" }], stack: ["Laravel", "Vue.js", "PostgreSQL"] },
];

const logos = [
  { src: laravel, alt: "Laravel", name: "Laravel" }, { src: next, alt: "Next.js", name: "Next.js" }, { src: react, alt: "React", name: "React" }, { src: vue, alt: "Vue", name: "Vue" }, { src: flutter, alt: "Flutter", name: "Flutter" }, { src: docker, alt: "Docker", name: "Docker" }, { src: nodejs, alt: "Node.js", name: "Node.js" }, { src: python, alt: "Python", name: "Python" }, { src: tailwind, alt: "Tailwind CSS", name: "Tailwind CSS" }, { src: aws, alt: "AWS", name: "AWS" },
];

const faqs = [
  { q: "How do we communicate during Australian hours?", a: "We work inside your Slack, GitHub, and Jira; standups and PR reviews happen live." },
  { q: "Who owns the IP?", a: "You do, in full, after invoice settlement, backed by a mutual NDA." },
  { q: "Can we start small?", a: "Yes, most agencies start with a 2-week paid pilot sprint." },
];

const plans = [
  { name: "Dedicated engineer", kind: "Dedicated capacity", priceLine: "Fixed monthly retainer, quoted per engagement", bullets: ["160 hours per month of senior development", "Synchronous Australian working hours", "Direct Slack, GitHub, and Jira access"], ctaLabel: "Request a quote", ctaHref: "https://api.whatsapp.com/send?phone=6289512589756&text=Hi%20Ach%20Rizal%2C%20we%20want%20to%20reserve%20a%20dedicated%20developer%20retainer.", featured: true },
  { name: "Project sprint", kind: "Fixed scope", priceLine: "Milestone-based quote", bullets: ["Statement of work with delivery schedule", "Backend, frontend, database, and API", "30-day post-deployment bug warranty"], ctaLabel: "Request a quote", ctaHref: "https://api.whatsapp.com/send?phone=6289512589756&text=Hi%20Ach%20Rizal%2C%20I%20have%20a%20project%20spec%20to%20quote.", featured: false },
];
---

<Layout lang="en" title="Renggani - Dedicated Software Engineering Partner for Australian Agencies" description="Scale your development capacity with senior Laravel, Go, Next.js, and mobile engineers with real-time Australian timezone overlap." keywords="software engineering partner australia, hire laravel developer australia, white label digital agency partner, golang developers perth sydney, cv renggani karya semesta" isSolid={true}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(aussieSchema)} slot="head" />

  <HomeHero eyebrow="Engineering partner for Australian agencies" title={{ lead: "Senior engineers for Australian agencies,", accent: "without the local contractor rate" }} subtitle="Laravel, Go, Next.js, and Flutter engineers who join your Slack, GitHub, and sprint standups." primary={{ label: "Book a 20-min intro call", href: introHref }} secondary={{ label: "See live systems", href: "#case-studies" }} accent="blue">
    <div slot="visual" class="relative px-2 sm:px-6">
      <ScreenshotFrame image={dashboardScreen} alt="BukuBatik production dashboard" caption="BukuBatik - production dashboard" priority />
    </div>
    <div slot="mobile-left"><MobileFrame image={mobileHome} alt="RKSWorkmate mobile home" tilt="left" /></div>
    <div slot="mobile-right"><MobileFrame image={mobileAbsensi} alt="RKSWorkmate mobile attendance" tilt="right" /></div>
  </HomeHero>

  <section class="py-6 md:py-8">
    <div class="max-w-6xl mx-auto grid grid-cols-1 gap-3 px-5 sm:grid-cols-3 lg:px-8">
      <StatTile value="0h" label="Difference with Perth" icon="mdi:clock-outline" tone="blue" class="p-3" />
      <StatTile value="4-5h" label="Synchronous overlap with Sydney" icon="mdi:account-clock-outline" tone="blue" class="p-3" />
      <StatTile value="100%" label="IP transfer to your agency" icon="mdi:file-document-check-outline" tone="blue" class="p-3" />
    </div>
  </section>

  <PainContrast title="Why traditional outsourcing fails" beforeLabel="The old way" afterLabel="With Renggani" items={[{ before: "Local contractors price the project out.", after: "One senior engineer, fixed monthly retainer." }, { before: "Offshore teams reply hours after you log off.", after: "Same-day replies inside your workday." }, { before: "Freelancers disappear mid-sprint.", after: "The lead architect joins every call." }]} />

  <TimezoneOverlap id="timezone" title="Real-time collaboration without the 8-hour lag" description="Our team works WIB (UTC+7). Here is the overlap with your office." rows={[{ city: "Perth", zone: "AWST", offset: "UTC+8", window: "09:00 - 17:00 AWST", overlapLabel: "Identical working hours", startPct: 37.5, widthPct: 33.3, tone: "emerald" }, { city: "Sydney", zone: "AEST", offset: "UTC+10", window: "11:00 - 18:00 AEST", overlapLabel: "5 hours overlap", startPct: 45.8, widthPct: 29.2, tone: "blue" }]} />

  <section id="case-studies" class="py-16 md:py-24">
    <div class="max-w-6xl mx-auto px-5 lg:px-8">
      <SectionHeader title="Two SaaS products running in production" description="BukuBatik for accounting operations and RKSWorkmate for HR and payroll workflows." />
      <CaseStudyTabs items={caseStudies} accent="blue" class="mt-10" />
    </div>
  </section>

  <section id="services" class="bg-slate-50 border-y border-slate-200/80 py-16 md:py-24">
    <div class="max-w-6xl mx-auto px-5 lg:px-8">
      <SectionHeader title="Stacks we ship with weekly" />
      <TechLogoStrip logos={logos} class="mt-10" />
    </div>
  </section>

  <EngagementPlans id="pricing" title="Predictable engagement" description="Monthly invoicing in AUD via Wise Business. No lock-in." plans={plans} />

  <section id="why-us" class="bg-slate-50 border-y border-slate-200/80 py-16 md:py-24">
    <div class="max-w-4xl mx-auto px-5 lg:px-8">
      <LeadershipBand name="Ach Rizal, S.Kom., M.Kom." role="Director & lead architect" quote="You speak directly with the senior engineer who architects your software." statement="Database design, security, and performance are reviewed by the lead architect from day one." linkedin="https://linkedin.com/in/achrizal15" github="https://github.com/achrizal15" accent="blue" />
    </div>
  </section>

  <section class="py-16 md:py-24">
    <div class="max-w-4xl mx-auto px-5 lg:px-8">
      <SectionHeader title="Common questions from Australian agencies" align="center" />
      <FaqAccordion items={faqs} class="mt-10" />
    </div>
  </section>

  <CtaBand id="contact" title="Ready to add senior capacity this sprint?" line="Bring your backlog, we map the first sprint together." primary={{ label: "Book a 20-min intro call", href: introHref }} secondary={{ label: "Send an email", href: "mailto:contact@rengganikaryasemesta.com?subject=Partnership%20Inquiry%20from%20Australia" }} accent="blue" />
</Layout>
