---
import Layout from "@layouts/Layout.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

const blogs = await getCollection("blogs");
const sortedBlogs = blogs.sort((a, b) => b.data.created_at.getTime() - a.data.created_at.getTime());

const featuredBlog = sortedBlogs[0];
const otherBlogs = sortedBlogs.slice(1);

const categories = [...new Set(blogs.map(blog => blog.data.category))];
---

<Layout title="Blog | CV Renggani Karya Semesta" description="Tips dan trik terbaru seputar bisnis dan teknologi dari CV Renggani Karya Semesta.">
    <main class="bg-white dark:bg-gray-900 pt-32 pb-20">
        <div class="max-w-7xl mx-auto px-5 lg:px-20">
            <div class="flex flex-col lg:flex-row gap-10">
                <!-- Sidebar -->
                <aside class="lg:w-1/3 space-y-10">
                    <div class="space-y-5">
                        <h1 class="text-3xl font-bold text-blue-900 dark:text-white font-roboto uppercase leading-tight">
                            RENGGANI <br/> <span class="text-blue-600">INSIGHTS</span>
                        </h1>
                        <p class="text-gray-600 dark:text-gray-400 font-roboto">
                            Dapatkan tips, trik, dan berita terbaru seputar teknologi, bisnis, dan solusi IT dari tim ahli kami.
                        </p>
                        
                        <div class="relative group">
                            <input 
                                type="text" 
                                placeholder="Cari artikel di sini..." 
                                class="w-full pl-5 pr-20 py-3 rounded-lg border-2 border-gray-100 dark:border-gray-700 dark:bg-gray-800 dark:text-white focus:border-blue-600 outline-none transition-all font-roboto"
                            />
                            <button class="absolute right-2 top-2 bottom-2 px-6 bg-blue-600 text-white rounded-md font-semibold hover:bg-blue-700 transition-colors font-roboto">
                                Cari
                            </button>
                        </div>
                    </div>

                    <div class="space-y-5">
                        <h2 class="text-xl font-bold dark:text-white font-roboto border-b-2 border-gray-100 dark:border-gray-700 pb-3">Topik</h2>
                        <ul class="space-y-3">
                            {categories.map(category => (
                                <li>
                                    <a href={`/blogs?category=${category}`} class="text-gray-700 dark:text-gray-300 hover:text-blue-600 transition-colors font-roboto block">
                                        {category}
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </div>

                    <div class="p-6 bg-blue-50 dark:bg-gray-800 rounded-2xl space-y-4">
                        <h3 class="font-bold text-lg dark:text-white font-roboto">Berlangganan Newsletter</h3>
                        <p class="text-sm text-gray-600 dark:text-gray-400 font-roboto">Dapatkan kurasi artikel terbaik langsung ke email Anda.</p>
                        <button class="w-full py-3 border-2 border-blue-600 text-blue-600 dark:text-blue-400 font-bold rounded-lg hover:bg-blue-600 hover:text-white transition-all font-roboto">
                            Subscribe
                        </button>
                    </div>
                </aside>

                <!-- Main Content -->
                <div class="lg:w-2/3 space-y-12">
                    <!-- Featured Blog -->
                    {featuredBlog && (
                        <a href={`/blogs/${featuredBlog.slug}`} class="block group relative overflow-hidden rounded-3xl shadow-2xl transition-transform duration-500 hover:-translate-y-2">
                            <div class="relative h-[400px] lg:h-[500px]">
                                <Image 
                                    src={featuredBlog.data.banner} 
                                    alt={featuredBlog.data.title}
                                    class="w-full h-full object-cover"
                                    width={1200}
                                    height={800}
                                />
                                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
                                <div class="absolute bottom-0 left-0 p-8 lg:p-12 text-white space-y-4 w-full">
                                    <span class="px-4 py-1 bg-blue-600 rounded-full text-sm font-semibold uppercase tracking-wider">
                                        {featuredBlog.data.category}
                                    </span>
                                    <h2 class="text-3xl lg:text-4xl font-bold font-roboto group-hover:text-blue-400 transition-colors">
                                        {featuredBlog.data.title}
                                    </h2>
                                    <p class="text-gray-200 line-clamp-2 font-roboto max-w-2xl">
                                        {featuredBlog.data.description}
                                    </p>
                                    <div class="flex items-center gap-3 pt-4">
                                        <div class="w-10 h-10 rounded-full bg-blue-500 flex items-center justify-center font-bold">
                                            {featuredBlog.data.author.charAt(0)}
                                        </div>
                                        <span class="font-medium font-roboto">{featuredBlog.data.author}</span>
                                    </div>
                                </div>
                            </div>
                        </a>
                    )}

                    <!-- Articles Grid -->
                    <div class="space-y-8">
                        <div class="flex items-center justify-between">
                            <h2 class="text-3xl font-bold dark:text-white font-roboto">Artikel</h2>
                            <a href="#" class="text-blue-600 font-bold flex items-center gap-2 hover:gap-3 transition-all font-roboto">
                                Lihat semua <Icon name="mdi:arrow-right" />
                            </a>
                        </div>
                        <div class="grid md:grid-cols-2 gap-8">
                            {otherBlogs.map(blog => (
                                <a href={`/blogs/${blog.slug}`} class="group space-y-4 block">
                                    <div class="relative h-56 overflow-hidden rounded-2xl shadow-lg">
                                        <Image 
                                            src={blog.data.banner} 
                                            alt={blog.data.title}
                                            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                                            width={600}
                                            height={400}
                                        />
                                    </div>
                                    <div class="space-y-2">
                                        <span class="text-blue-600 font-bold text-sm uppercase tracking-wider font-roboto">
                                            {blog.data.category}
                                        </span>
                                        <h3 class="text-xl font-bold dark:text-white font-roboto group-hover:text-blue-600 transition-colors leading-tight">
                                            {blog.data.title}
                                        </h3>
                                        <div class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400 font-roboto">
                                            <span>{blog.data.created_at.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
                                            <span>•</span>
                                            <span>5 mins read</span>
                                        </div>
                                    </div>
                                </a>
                            ))}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>
</Layout>
