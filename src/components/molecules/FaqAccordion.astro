---
import { Icon } from "astro-icon/components";

interface Props {
  items: { q: string; a: string }[];
  class?: string;
}

const { items, class: customClass = "" } = Astro.props;
---

<div class:list={["divide-y divide-slate-200 rounded-3xl border border-slate-200/80 bg-white", customClass]}>
  {items.map((item, index) => (
    <details class="group" open={index === 0}>
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-6 py-5 text-sm md:text-base font-bold text-slate-900 [&::-webkit-details-marker]:hidden">
        <span>{item.q}</span>
        <Icon
          name="mdi:chevron-down"
          class="shrink-0 text-xl text-slate-500 transition-transform duration-200 group-open:rotate-180"
        />
      </summary>
      <p class="px-6 pb-5 text-sm text-slate-600">{item.a}</p>
    </details>
  ))}
</div>
