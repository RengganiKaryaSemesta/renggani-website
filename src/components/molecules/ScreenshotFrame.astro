---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  image: ImageMetadata;
  alt: string;
  caption?: string;
  priority?: boolean;
  class?: string;
}

const { image, alt, caption, priority = false, class: customClass = "" } = Astro.props;
---

<figure class:list={["m-0", customClass]}>
  <div class="rounded-3xl border border-slate-200/90 bg-white p-2 shadow-xl">
    <Image
      src={image}
      alt={alt}
      width={1200}
      height={750}
      format="webp"
      quality={88}
      class="w-full h-auto rounded-2xl"
      loading={priority ? "eager" : "lazy"}
      decoding="async"
    />
  </div>
  {caption && <figcaption class="text-xs text-slate-500 mt-3">{caption}</figcaption>}
</figure>
