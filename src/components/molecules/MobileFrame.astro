---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  image: ImageMetadata;
  alt: string;
  tilt?: "left" | "right" | "none";
  class?: string;
}

const { image, alt, tilt = "none", class: customClass = "" } = Astro.props;

const tiltStyles = {
  left: "-rotate-3",
  right: "rotate-3",
  none: "",
};
---

<div
  class:list={[
    "w-36 md:w-44 rounded-[2rem] border-4 border-slate-900 overflow-hidden shadow-2xl bg-white",
    tiltStyles[tilt],
    customClass,
  ]}
>
  <Image src={image} alt={alt} width={400} height={800} format="webp" class="w-full h-auto" loading="lazy" decoding="async" />
</div>
