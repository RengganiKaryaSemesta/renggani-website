---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  badge: string;
  description: string;
  imageSrc: ImageMetadata;
  imageAlt: string;
  highlights: string[];
  reversed?: boolean;
}

const {
  title,
  badge,
  description,
  imageSrc,
  imageAlt,
  highlights,
  reversed = false,
} = Astro.props;
---

<div
  class:list={[
    "grid lg:grid-cols-12 gap-8 lg:gap-12 items-center p-6 lg:p-10 rounded-3xl border border-slate-200 dark:border-slate-800 bg-white/70 dark:bg-slate-900/60 backdrop-blur-md shadow-sm hover:shadow-xl hover:shadow-rose-900/5 transition-all duration-300",
  ]}
>
  <!-- Content Column -->
  <div class:list={["lg:col-span-6 space-y-5", reversed ? "lg:order-2" : "lg:order-1"]}>
    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold text-rose-900 dark:text-rose-300 bg-rose-900/10 border border-rose-900/20">
      <span class="w-1.5 h-1.5 rounded-full bg-rose-700 animate-pulse"></span>
      {badge}
    </span>

    <h3 class="text-2xl lg:text-3xl font-bold text-slate-900 dark:text-white tracking-tight leading-snug">
      {title}
    </h3>

    <p class="text-sm lg:text-base text-slate-600 dark:text-slate-300 leading-relaxed">
      {description}
    </p>

    <ul class="space-y-2.5 pt-2">
      {
        highlights.map((item) => (
          <li class="flex items-center gap-3 text-sm text-slate-700 dark:text-slate-300">
            <span class="w-5 h-5 rounded-full bg-rose-900/15 text-rose-900 dark:text-rose-400 flex items-center justify-center shrink-0">
              <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
            </span>
            <span>{item}</span>
          </li>
        ))
      }
    </ul>
  </div>

  <!-- Asset Mockup Column -->
  <div class:list={["lg:col-span-6", reversed ? "lg:order-1" : "lg:order-2"]}>
    <div class="relative group rounded-2xl overflow-hidden border border-slate-200 dark:border-slate-800 bg-slate-100 dark:bg-slate-950 shadow-lg">
      <div class="absolute inset-0 bg-gradient-to-tr from-rose-900/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"></div>
      <Image
        src={imageSrc}
        alt={imageAlt}
        width={800}
        height={500}
        quality={90}
        format="webp"
        loading="lazy"
        class="w-full h-auto object-cover rounded-xl transition-transform duration-500 group-hover:scale-[1.02]"
      />
    </div>
  </div>
</div>
