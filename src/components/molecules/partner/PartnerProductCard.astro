---
import type { PartnerProduct } from 'src/data/partnerProducts';
import PartnerCtaButton from '@components/atoms/partner/PartnerCtaButton.astro';

interface Props {
  product: PartnerProduct;
}

const { product } = Astro.props;
---

<div class="flex flex-col justify-between rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 p-6 md:p-8 shadow-xs hover:shadow-md transition-shadow">
  <div>
    <!-- Top Meta -->
    <div class="flex items-center justify-between gap-3 mb-4">
      <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-blue-50 text-blue-700 dark:bg-blue-950/40 dark:text-blue-300 border border-blue-200/60 dark:border-blue-800/60">
        {product.category}
      </span>
      <span class="text-xs font-medium text-slate-500 dark:text-slate-400">
        {product.pricingLabel}
      </span>
    </div>

    <h3 class="font-sans text-xl font-bold text-slate-900 dark:text-white mb-1.5">
      {product.name}
    </h3>
    <p class="text-xs font-medium text-blue-800 dark:text-blue-400 mb-4">
      {product.tagline}
    </p>

    <p class="text-sm text-slate-600 dark:text-slate-300 mb-5 leading-relaxed">
      {product.description}
    </p>

    <!-- Target Market Pill -->
    <div class="rounded-xl bg-slate-50 dark:bg-slate-800/60 p-3 mb-6 border border-slate-100 dark:border-slate-800">
      <div class="text-xs text-slate-500 dark:text-slate-400 mb-1">Target Pasar Potensial:</div>
      <div class="text-xs font-semibold text-slate-800 dark:text-slate-200">{product.targetMarket}</div>
    </div>

    <!-- Highlights -->
    <div class="space-y-2 mb-6">
      <p class="text-xs font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500">
        Keunggulan Utama:
      </p>
      <ul class="space-y-2">
        {product.highlights.map((item) => (
          <li class="flex items-center gap-2 text-xs text-slate-700 dark:text-slate-300">
            <svg class="w-3.5 h-3.5 text-blue-600 dark:text-blue-400 shrink-0" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
            </svg>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div>
    <!-- Estimated recurring share -->
    <div class="rounded-xl bg-emerald-50 dark:bg-emerald-950/30 p-3 mb-5 border border-emerald-100 dark:border-emerald-800/50">
      <div class="flex items-center gap-2 text-xs font-bold text-emerald-800 dark:text-emerald-300">
        <svg class="w-4 h-4 shrink-0 text-emerald-600 dark:text-emerald-400" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
        </svg>
        <span>{product.commissionEstimate}</span>
      </div>
    </div>

    <PartnerCtaButton href={product.href} variant="outline" size="sm" target="_self" class="w-full">
      Pelajari Detail {product.name}
    </PartnerCtaButton>
  </div>
</div>
