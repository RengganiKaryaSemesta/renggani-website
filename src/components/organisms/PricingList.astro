---
import { Icon } from "astro-icon/components";
import FeatureCheckIcon from "@components/atoms/FeatureCheckIcon.astro";
import PlanBadge from "@components/atoms/PlanBadge.astro";

interface Plan {
  name: string;
  slug: string;
  monthlyPrice: string;
  yearlyPrice: string;
  yearlyPriceNumeric: string;
  monthlyPriceNumeric: string;
  savings: string;
  description: string;
  highlights: string[];
  maxBranch: string;
  additionalBranchFee: string;
  recommended: boolean;
  whatsappMsg: string;
}

const pricingPlans: Plan[] = [
  {
    name: "Starter",
    slug: "starter",
    monthlyPrice: "Rp300.000",
    yearlyPrice: "Rp3.000.000",
    monthlyPriceNumeric: "250k",
    yearlyPriceNumeric: "3.0M",
    savings: "Hemat Rp600.000",
    description: "Sangat cocok untuk usaha mikro & kecil yang baru memulai digitalisasi pencatatan penjualan, pembelian, dan keuangan usaha.",
    highlights: [
      "Purchase Invoice, Payment & Return",
      "Sales Invoice, Payment & Return",
      "Average Cost Valuation",
      "Biaya, Jurnal Umum & Tutup Buku",
      "Bank Transfer, Deposit & Withdrawal",
      "Asset Management & Penyusutan",
      "Kapasitas 1 Cabang Usaha",
    ],
    maxBranch: "1 Cabang",
    additionalBranchFee: "—",
    recommended: false,
    whatsappMsg: "Halo Renggani, saya tertarik dengan paket BukuBatik Starter (Rp300.000/bln). Mohon informasi penawaran dan demo sistemnya.",
  },
  {
    name: "Bisnis",
    slug: "bisnis",
    monthlyPrice: "Rp650.000",
    yearlyPrice: "Rp6.500.000",
    monthlyPriceNumeric: "541k",
    yearlyPriceNumeric: "6.5M",
    savings: "Hemat Rp1.300.000",
    description: "Paling populer untuk bisnis berkembang yang membutuhkan alur Purchase & Sales Order, Stock Opname, dan Multi-Cabang.",
    highlights: [
      "Seluruh fitur paket Starter",
      "Purchase Order & Sales Order",
      "Stock Opname Rutin",
      "Multi-Cabang (Maksimal 5 Cabang)",
      "Cabang Tambahan Berbayar",
      "Dukungan Manajemen Shift",
    ],
    maxBranch: "5 Cabang",
    additionalBranchFee: "Berbayar",
    recommended: true,
    whatsappMsg: "Halo Renggani, saya tertarik dengan paket BukuBatik Bisnis (Rp650.000/bln - Paling Populer). Mohon informasi penawaran dan jadwal demo sistemnya.",
  },
  {
    name: "Enterprise",
    slug: "enterprise",
    monthlyPrice: "Rp1.000.000",
    yearlyPrice: "Rp10.000.000",
    monthlyPriceNumeric: "833k",
    yearlyPriceNumeric: "10.0M",
    savings: "Hemat Rp2.000.000",
    description: "Solusi terlengkap untuk perusahaan dengan kebutuhan alur quote, FIFO, konversi produksi bahan baku, rekonsiliasi bank, dan cabang tak terbatas.",
    highlights: [
      "Seluruh fitur paket Bisnis",
      "Purchase Request & Quote",
      "Sales Quote",
      "Metode FIFO & Konversi / Produksi",
      "Rekonsiliasi Bank Otomatis",
      "Maksimal Cabang Unlimited (Berbayar)",
    ],
    maxBranch: "Unlimited",
    additionalBranchFee: "Berbayar",
    recommended: false,
    whatsappMsg: "Halo Renggani, saya tertarik dengan paket BukuBatik Enterprise (Rp1.000.000/bln). Mohon informasi penawaran korporasi dan jadwal konsultasi teknis.",
  },
];

interface FeatureRow {
  name: string;
  starter: boolean | string;
  bisnis: boolean | string;
  enterprise: boolean | string;
}

interface FeatureCategory {
  title: string;
  items: FeatureRow[];
}

const matrixCategories: FeatureCategory[] = [
  {
    title: "Pembelian",
    items: [
      { name: "Purchase Invoice", starter: true, bisnis: true, enterprise: true },
      { name: "Purchase Payment", starter: true, bisnis: true, enterprise: true },
      { name: "Purchase Return", starter: true, bisnis: true, enterprise: true },
      { name: "Purchase Order", starter: false, bisnis: true, enterprise: true },
      { name: "Purchase Request", starter: false, bisnis: false, enterprise: true },
      { name: "Purchase Quote", starter: false, bisnis: false, enterprise: true },
    ],
  },
  {
    title: "Penjualan",
    items: [
      { name: "Sales Invoice", starter: true, bisnis: true, enterprise: true },
      { name: "Sales Payment", starter: true, bisnis: true, enterprise: true },
      { name: "Sales Return", starter: true, bisnis: true, enterprise: true },
      { name: "Sales Order", starter: false, bisnis: true, enterprise: true },
      { name: "Sales Quote", starter: false, bisnis: false, enterprise: true },
    ],
  },
  {
    title: "Persediaan",
    items: [
      { name: "Stock Opname", starter: false, bisnis: true, enterprise: true },
      { name: "Average Cost", starter: true, bisnis: true, enterprise: true },
      { name: "FIFO", starter: false, bisnis: false, enterprise: true },
      { name: "Konversi / Produksi", starter: false, bisnis: false, enterprise: true },
    ],
  },
  {
    title: "Keuangan & Akuntansi",
    items: [
      { name: "Biaya / Expense", starter: true, bisnis: true, enterprise: true },
      { name: "Jurnal Umum", starter: true, bisnis: true, enterprise: true },
      { name: "Saldo Awal", starter: true, bisnis: true, enterprise: true },
      { name: "Kunci Periode", starter: true, bisnis: true, enterprise: true },
      { name: "Tutup Buku", starter: true, bisnis: true, enterprise: true },
    ],
  },
  {
    title: "Perbankan",
    items: [
      { name: "Bank Transfer", starter: true, bisnis: true, enterprise: true },
      { name: "Bank Deposit", starter: true, bisnis: true, enterprise: true },
      { name: "Bank Withdrawal", starter: true, bisnis: true, enterprise: true },
      { name: "Rekonsiliasi Bank", starter: false, bisnis: false, enterprise: true },
    ],
  },
  {
    title: "Aset",
    items: [
      { name: "Asset Management", starter: true, bisnis: true, enterprise: true },
      { name: "Penyusutan Aset", starter: true, bisnis: true, enterprise: true },
      { name: "Disposal Aset", starter: true, bisnis: true, enterprise: true },
    ],
  },
  {
    title: "Multi-Cabang",
    items: [
      { name: "Multi-cabang", starter: false, bisnis: true, enterprise: true },
      { name: "Maksimal Cabang", starter: "1", bisnis: "5", enterprise: "Unlimited" },
      { name: "Biaya Cabang Tambahan", starter: "—", bisnis: "Berbayar", enterprise: "Berbayar" },
    ],
  },
];
---

<section class="py-24 px-5 lg:px-20 bg-slate-50 dark:bg-slate-950 font-roboto transition-colors duration-300">
  <div class="max-w-7xl mx-auto space-y-20">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto space-y-4">
      <span class="text-xs font-mono font-bold uppercase tracking-[0.2em] text-purple-600 dark:text-purple-400 bg-purple-100 dark:bg-purple-950/80 px-4 py-1.5 rounded-full border border-purple-200 dark:border-purple-800">
        SKEMA HARGA TRANSPARAN
      </span>
      <h2 class="text-4xl lg:text-5xl font-black dark:text-white text-slate-900 tracking-tight leading-none">
        Investasi Tepat untuk Kendali Bisnis yang Kuat
      </h2>
      <p class="text-base lg:text-lg text-slate-600 dark:text-slate-400 leading-relaxed">
        Pilih paket yang sesuai dengan volume operasional Anda saat ini. Anda dapat melakukan migrasi paket seiring pertumbuhan bisnis.
      </p>
    </div>

    <!-- Monthly / Yearly Billing Toggle -->
    <div class="flex flex-col sm:flex-row justify-center items-center gap-4 sm:gap-6">
      <span class="text-sm font-bold text-slate-600 dark:text-slate-400 uppercase tracking-wider">Bayar Bulanan</span>
      
      <button 
        id="billing-toggle" 
        type="button" 
        class="relative inline-flex h-8 w-16 shrink-0 cursor-pointer rounded-full border-2 border-transparent bg-slate-200 dark:bg-slate-800 transition-colors duration-300 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:ring-offset-2 dark:focus:ring-offset-slate-950" 
        role="switch" 
        aria-checked="false"
      >
        <span class="sr-only">Ubah skema penagihan</span>
        <span 
          id="billing-toggle-thumb" 
          class="pointer-events-none inline-block h-7 w-7 transform rounded-full bg-white dark:bg-slate-100 shadow-md ring-0 transition duration-300 ease-in-out translate-x-0"
        ></span>
      </button>

      <div class="flex items-center gap-3">
        <span class="text-sm font-bold text-slate-600 dark:text-slate-400 uppercase tracking-wider">Bayar Tahunan</span>
        <span class="bg-emerald-100 dark:bg-emerald-950/80 text-emerald-700 dark:text-emerald-400 text-xs px-3 py-1 rounded-full font-extrabold border border-emerald-200 dark:border-emerald-800">
          Hemat s.d 17%
        </span>
      </div>
    </div>

    <!-- Pricing Cards Grid -->
    <div class="grid lg:grid-cols-3 gap-8 items-stretch pt-4">
      {pricingPlans.map((plan) => (
        <div 
          class={`relative flex flex-col justify-between p-8 lg:p-10 rounded-3xl border-2 transition-all duration-300 hover:shadow-2xl ${
            plan.recommended 
              ? 'bg-white dark:bg-slate-900 border-purple-500 shadow-xl shadow-purple-500/10 dark:shadow-purple-500/5 lg:scale-105 z-10' 
              : 'bg-white dark:bg-slate-900 border-slate-200 dark:border-slate-800 hover:border-purple-300 dark:hover:border-purple-800'
          }`}
        >
          {plan.recommended && (
            <div class="absolute -top-4 left-1/2 transform -translate-x-1/2">
              <PlanBadge text="Paling Populer" isPopular={true} variant="purple" />
            </div>
          )}

          <div>
            <!-- Header Card -->
            <div class="border-b border-slate-100 dark:border-slate-800/80 pb-6 mb-6">
              <h3 class="text-2xl font-black text-slate-900 dark:text-white">{plan.name}</h3>
              <p class="text-xs text-slate-500 dark:text-slate-400 mt-2 min-h-[36px]">{plan.description}</p>
              
              <!-- Price Indicator -->
              <div class="mt-6 min-h-[80px] flex items-baseline">
                <!-- Monthly Price Block -->
                <div class="monthly-price-block transition-opacity duration-200">
                  <span class="text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white font-mono">{plan.monthlyPrice}</span>
                  <span class="text-sm font-semibold text-slate-500 dark:text-slate-400 ml-1">/bulan</span>
                </div>
                <!-- Yearly Price Block (Hidden by default) -->
                <div class="yearly-price-block hidden transition-opacity duration-200">
                  <div class="flex items-baseline">
                    <span class="text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white font-mono">{plan.yearlyPrice}</span>
                    <span class="text-sm font-semibold text-slate-500 dark:text-slate-400 ml-1">/tahun</span>
                  </div>
                  <div class="text-xs text-emerald-600 dark:text-emerald-400 font-bold mt-1.5 flex items-center gap-1">
                    <Icon name="mdi:sparkles" class="text-sm" />
                    <span>{plan.savings} (Setara {plan.monthlyPriceNumeric}/bln)</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Feature Highlights -->
            <ul class="space-y-3.5 mb-8">
              {plan.highlights.map((feat) => (
                <li class="flex items-center gap-3">
                  <div class="rounded-full p-0.5 bg-emerald-100 dark:bg-emerald-950 shrink-0 border border-emerald-200 dark:border-emerald-900">
                    <Icon name="mdi:check" class="text-emerald-600 dark:text-emerald-400 text-sm w-4 h-4" />
                  </div>
                  <span class="text-sm text-slate-700 dark:text-slate-300 font-medium">{feat}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Bottom Section Card -->
          <div>
            <div class="bg-slate-50 dark:bg-slate-950 rounded-2xl p-4 border border-slate-150 dark:border-slate-900 space-y-2 mb-8">
              <div class="flex justify-between text-xs font-semibold text-slate-500 dark:text-slate-400">
                <span>Maksimal Cabang</span>
                <span class="text-slate-800 dark:text-slate-200 font-bold">{plan.maxBranch}</span>
              </div>
              <div class="flex justify-between text-xs font-semibold text-slate-500 dark:text-slate-400 pt-2 border-t border-slate-200/50 dark:border-slate-800/50">
                <span>Biaya Cabang Tambahan</span>
                <span class="text-purple-600 dark:text-purple-400 font-bold">{plan.additionalBranchFee}</span>
              </div>
            </div>

            <a
              href={`https://api.whatsapp.com/send?phone=6289512589756&text=${encodeURIComponent(plan.whatsappMsg)}`}
              target="_blank"
              rel="noopener noreferrer"
              class={`block w-full py-4 px-6 rounded-xl font-bold text-center text-sm tracking-wide uppercase transition-all duration-300 active:scale-[0.98] ${
                plan.recommended
                  ? 'bg-gradient-to-r from-purple-600 to-indigo-600 text-white shadow-lg shadow-purple-500/20 hover:shadow-purple-500/35 hover:-translate-y-0.5'
                  : 'bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-800 dark:text-slate-200'
              }`}
            >
              Ajukan Penawaran {plan.name}
            </a>
          </div>
        </div>
      ))}
    </div>

    <!-- Complete Features Matrix Section -->
    <div class="pt-16 space-y-8" id="matriks-fitur-bukubatik">
      <div class="text-center max-w-2xl mx-auto space-y-2">
        <h3 class="text-2xl lg:text-3xl font-black text-slate-900 dark:text-white tracking-tight">
          Perbandingan Fitur Detail
        </h3>
        <p class="text-sm text-slate-500 dark:text-slate-400">
          Ulas secara mendalam modul dan spesifikasi fungsional di setiap paket sistem Akuntansi BukuBatik.
        </p>
      </div>

      <!-- Mobile Tab Switcher for Matrix -->
      <div class="block lg:hidden space-y-6" id="bukubatik-mobile-matrix">
        <div class="grid grid-cols-3 gap-2 p-1.5 bg-slate-200/80 dark:bg-slate-800 rounded-2xl border border-slate-300 dark:border-slate-700" role="tablist">
          {
            pricingPlans.map((plan, idx) => (
              <button
                type="button"
                role="tab"
                aria-selected={idx === 1 ? "true" : "false"}
                aria-controls={`bb-panel-${plan.slug}`}
                id={`bb-tab-${plan.slug}`}
                class:list={[
                  "bb-tab-btn py-2.5 px-2 rounded-xl text-xs font-bold transition-all text-center",
                  idx === 1
                    ? "bg-purple-600 text-white shadow-md shadow-purple-600/30"
                    : "text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white",
                ]}
                data-bb-target={plan.slug}
              >
                {plan.name}
              </button>
            ))
          }
        </div>

        {
          pricingPlans.map((plan, idx) => (
            <div
              id={`bb-panel-${plan.slug}`}
              role="tabpanel"
              aria-labelledby={`bb-tab-${plan.slug}`}
              class:list={[
                "bb-panel p-6 rounded-3xl border bg-white dark:bg-slate-900 shadow-xl space-y-6",
                plan.recommended ? "border-purple-500/50 ring-1 ring-purple-500/30" : "border-slate-200 dark:border-slate-800",
                idx !== 1 && "hidden",
              ]}
            >
              <div class="flex items-center justify-between">
                <div>
                  <span class="text-xs font-mono font-semibold uppercase text-slate-400">Paket Akuntansi</span>
                  <h4 class="text-2xl font-bold text-slate-900 dark:text-white">{plan.name}</h4>
                </div>
                {plan.recommended ? (
                  <PlanBadge text="Paling Populer" isPopular={true} variant="purple" />
                ) : (
                  <PlanBadge text={plan.name} variant="slate" />
                )}
              </div>

              <div class="space-y-6 pt-2">
                {
                  matrixCategories.map((cat) => (
                    <div class="space-y-3">
                      <h5 class="text-xs font-bold uppercase tracking-wider text-purple-600 dark:text-purple-400 border-b border-purple-100 dark:border-purple-900/50 pb-1.5">
                        {cat.title}
                      </h5>
                      <ul class="space-y-2.5 divide-y divide-slate-100 dark:divide-slate-800/80">
                        {cat.items.map((item) => {
                          const isAvailable =
                            plan.slug === "starter"
                              ? item.starter
                              : plan.slug === "bisnis"
                                ? item.bisnis
                                : item.enterprise;
                          const hasValue = typeof isAvailable === "string";

                          return (
                            <li class="flex items-center justify-between pt-2.5 text-sm">
                              <span class="text-slate-700 dark:text-slate-300 font-medium">{item.name}</span>
                              <div>
                                {hasValue ? (
                                  <span class="font-bold text-slate-900 dark:text-white bg-slate-100 dark:bg-slate-800 px-2.5 py-1 rounded-lg text-xs">
                                    {isAvailable}
                                  </span>
                                ) : (
                                  <FeatureCheckIcon checked={Boolean(isAvailable)} featureName={item.name} planName={plan.name} />
                                )}
                              </div>
                            </li>
                          );
                        })}
                      </ul>
                    </div>
                  ))
                }
              </div>

              <div class="pt-4">
                <a
                  href={`https://api.whatsapp.com/send?phone=6289512589756&text=${encodeURIComponent(plan.whatsappMsg)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="block w-full py-3.5 px-6 rounded-xl font-bold text-center text-sm tracking-wide uppercase bg-purple-600 hover:bg-purple-500 text-white shadow-lg shadow-purple-600/30"
                >
                  Pilih Paket {plan.name}
                </a>
              </div>
            </div>
          ))
        }
      </div>

      <!-- Desktop Comparison Matrix Table -->
      <div class="hidden lg:block border border-slate-200 dark:border-slate-800 rounded-3xl overflow-hidden shadow-lg bg-white dark:bg-slate-900">
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse" id="bukubatik-matrix-table">
            <thead>
              <tr class="bg-slate-50 dark:bg-slate-950 border-b border-slate-200 dark:border-slate-800 text-xs font-black text-slate-700 dark:text-slate-300 uppercase tracking-widest">
                <th scope="col" class="p-6 w-2/5">Fitur / Rincian Modul</th>
                <th scope="col" class="p-6 text-center w-1/5">Starter</th>
                <th scope="col" class="p-6 text-center w-1/5 bg-purple-50/50 dark:bg-purple-950/20 border-x border-purple-200 dark:border-purple-800/60">
                  <div class="space-y-1">
                    <span class="inline-block bg-purple-600 text-white text-[10px] font-bold px-2 py-0.5 rounded-full uppercase tracking-wider">
                      Paling Populer
                    </span>
                    <div class="text-sm font-bold text-slate-900 dark:text-white">Bisnis</div>
                  </div>
                </th>
                <th scope="col" class="p-6 text-center w-1/5">Enterprise</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-150 dark:divide-slate-800/60 text-sm">
              {
                matrixCategories.map((group) => (
                  <>
                    <!-- Group Header Row -->
                    <tr class="bg-slate-100/70 dark:bg-slate-950/80 text-xs font-bold uppercase tracking-wider">
                      <td colspan="4" class="p-4 pl-6 border-y border-slate-200 dark:border-slate-800/80 text-purple-700 dark:text-purple-400 font-mono">
                        {group.title}
                      </td>
                    </tr>

                    <!-- Group Items -->
                    {group.items.map((item, index) => (
                      <tr
                        class:list={[
                          "hover:bg-slate-50/40 dark:hover:bg-slate-950/20 transition-colors",
                          index % 2 === 0 ? "bg-white dark:bg-slate-900" : "bg-slate-50/20 dark:bg-slate-900/40",
                        ]}
                      >
                        <th scope="row" class="p-5 pl-6 font-medium text-slate-900 dark:text-slate-100">
                          {item.name}
                        </th>

                        <!-- Starter -->
                        <td class="p-5 text-center">
                          {typeof item.starter === "string" ? (
                            <span class="font-bold text-slate-800 dark:text-slate-200 bg-slate-100 dark:bg-slate-800 px-3 py-1 rounded-lg text-xs">
                              {item.starter}
                            </span>
                          ) : (
                            <FeatureCheckIcon checked={item.starter} featureName={item.name} planName="Starter" />
                          )}
                        </td>

                        <!-- Bisnis (Popular column highlight) -->
                        <td class="p-5 text-center bg-purple-50/30 dark:bg-purple-950/10 border-x border-purple-200/60 dark:border-purple-800/40">
                          {typeof item.bisnis === "string" ? (
                            <span class="font-bold text-purple-700 dark:text-purple-300 bg-purple-100 dark:bg-purple-900/60 px-3 py-1 rounded-lg text-xs">
                              {item.bisnis}
                            </span>
                          ) : (
                            <FeatureCheckIcon checked={item.bisnis} featureName={item.name} planName="Bisnis" />
                          )}
                        </td>

                        <!-- Enterprise -->
                        <td class="p-5 text-center">
                          {typeof item.enterprise === "string" ? (
                            <span class="font-bold text-slate-800 dark:text-slate-200 bg-slate-100 dark:bg-slate-800 px-3 py-1 rounded-lg text-xs">
                              {item.enterprise}
                            </span>
                          ) : (
                            <FeatureCheckIcon checked={item.enterprise} featureName={item.name} planName="Enterprise" />
                          )}
                        </td>
                      </tr>
                    ))}
                  </>
                ))
              }
            </tbody>
            <tfoot>
              <tr class="bg-slate-50 dark:bg-slate-950 border-t border-slate-200 dark:border-slate-800">
                <td class="p-6 text-xs text-slate-500 dark:text-slate-400">
                  Konsultasikan kebutuhan kustomisasi modul tambahan bersama tim sales kami.
                </td>
                {
                  pricingPlans.map((plan) => (
                    <td
                      class:list={[
                        "p-6 text-center",
                        plan.recommended ? "bg-purple-50/30 dark:bg-purple-950/10 border-x border-purple-200/60 dark:border-purple-800/40" : "",
                      ]}
                    >
                      <a
                        href={`https://api.whatsapp.com/send?phone=6289512589756&text=${encodeURIComponent(plan.whatsappMsg)}`}
                        target="_blank"
                        rel="noopener noreferrer"
                        class={`inline-block w-full py-2.5 px-4 rounded-xl text-xs font-bold uppercase transition-all ${
                          plan.recommended
                            ? "bg-purple-600 hover:bg-purple-500 text-white shadow-md shadow-purple-600/30"
                            : "bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-800 dark:text-slate-200"
                        }`}
                      >
                        Pilih {plan.name}
                      </a>
                    </td>
                  ))
                }
              </tr>
            </tfoot>
          </table>
        </div>
      </div>
    </div>

    <!-- FAQ Section -->
    <div class="pt-16 space-y-12">
      <div class="text-center max-w-3xl mx-auto space-y-2">
        <h3 class="text-3xl font-black text-slate-900 dark:text-white tracking-tight">
          FAQ & Rincian Informasi
