<script>
  // Astro View Transitions page-load hook
  function initBillingToggle() {
    const toggle = document.getElementById('billing-toggle');
    const thumb = document.getElementById('billing-toggle-thumb');
    const monthlyBlocks = document.querySelectorAll('.monthly-price-block');
    const yearlyBlocks = document.querySelectorAll('.yearly-price-block');

    if (toggle && thumb) {
      if (toggle.dataset.billingInitialized === 'true') return;
      toggle.dataset.billingInitialized = 'true';

      toggle.addEventListener('click', () => {
        const isYearly = toggle.getAttribute('aria-checked') === 'true';
        toggle.setAttribute('aria-checked', (!isYearly).toString());
        
        if (isYearly) {
          // Switch to monthly (Default State)
          toggle.classList.remove('bg-purple-600');
          toggle.classList.add('bg-slate-200', 'dark:bg-slate-800');
          thumb.classList.remove('translate-x-8');
          thumb.classList.add('translate-x-0');
          
          monthlyBlocks.forEach(block => block.classList.remove('hidden'));
          yearlyBlocks.forEach(block => block.classList.add('hidden'));
        } else {
          // Switch to yearly
          toggle.classList.remove('bg-slate-200', 'dark:bg-slate-800');
          toggle.classList.add('bg-purple-600');
          thumb.classList.remove('translate-x-0');
          thumb.classList.add('translate-x-8');
          
          monthlyBlocks.forEach(block => block.classList.add('hidden'));
          yearlyBlocks.forEach(block => block.classList.remove('hidden'));
        }
      });
    }
  }

  // Run on initial load and navigation
  initBillingToggle();
  document.addEventListener('astro:page-load', initBillingToggle);
</script>
