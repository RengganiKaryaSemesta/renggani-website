<!-- Client Script for Billing Toggle & Mobile Tabs -->
<script>
  function setupPricingInteractions() {
    // 1. Billing Toggle (Monthly / Yearly)
    const toggle = document.getElementById("billing-toggle");
    const thumb = document.getElementById("billing-toggle-thumb");
    const monthlyBlocks = document.querySelectorAll(".monthly-price-block");
    const yearlyBlocks = document.querySelectorAll(".yearly-price-block");

    if (toggle && thumb) {
      let isYearly = false;

      toggle.addEventListener("click", () => {
        isYearly = !isYearly;
        toggle.setAttribute("aria-checked", isYearly ? "true" : "false");

        if (isYearly) {
          thumb.classList.remove("translate-x-0");
          thumb.classList.add("translate-x-8");
          toggle.classList.remove("bg-slate-200", "dark:bg-slate-800");
          toggle.classList.add("bg-purple-600");

          monthlyBlocks.forEach((el) => el.classList.add("hidden"));
          yearlyBlocks.forEach((el) => el.classList.remove("hidden"));
        } else {
          thumb.classList.remove("translate-x-8");
          thumb.classList.add("translate-x-0");
          toggle.classList.remove("bg-purple-600");
          toggle.classList.add("bg-slate-200", "dark:bg-slate-800");

          monthlyBlocks.forEach((el) => el.classList.remove("hidden"));
          yearlyBlocks.forEach((el) => el.classList.add("hidden"));
        }
      });
    }

    // 2. Mobile Matrix Tabs
    const bbTabButtons = document.querySelectorAll<HTMLButtonElement>(".bb-tab-btn");
    const bbPanels = document.querySelectorAll<HTMLElement>(".bb-panel");

    bbTabButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const targetSlug = button.dataset.bbTarget;

        bbTabButtons.forEach((btn) => {
          btn.classList.remove("bg-purple-600", "text-white", "shadow-md", "shadow-purple-600/30");
          btn.classList.add("text-slate-600", "dark:text-slate-300");
          btn.setAttribute("aria-selected", "false");
        });

        button.classList.add("bg-purple-600", "text-white", "shadow-md", "shadow-purple-600/30");
        button.classList.remove("text-slate-600", "dark:text-slate-300");
        button.setAttribute("aria-selected", "true");

        bbPanels.forEach((panel) => {
          if (panel.id === `bb-panel-${targetSlug}`) {
            panel.classList.remove("hidden");
          } else {
            panel.classList.add("hidden");
          }
        });
      });
    });
  }

  document.addEventListener("astro:page-load", setupPricingInteractions);
  if (document.readyState === "complete" || document.readyState === "interactive") {
    setupPricingInteractions();
  }
</script>
