---
import { Icon } from "astro-icon/components";

interface Props {
  name: string;
  role: string;
  quote: string;
  statement: string;
  linkedin: string;
  github: string;
  accent?: "orange" | "blue";
  class?: string;
}

const { name, role, quote, statement, linkedin, github, accent = "orange", class: customClass = "" } = Astro.props;
const accentStyles = accent === "orange" ? "bg-orange-50 text-orange-700 border-orange-200" : "bg-blue-50 text-blue-700 border-blue-200";
const roleColor = accent === "orange" ? "text-orange-600" : "text-blue-600";
---

<div class:list={["rounded-3xl border border-slate-200/90 bg-white p-8 md:p-10 shadow-sm", customClass]}>
  <div class="grid md:grid-cols-12 gap-8 items-center">
    <div class="md:col-span-4 text-center md:text-left">
      <div class:list={["mx-auto md:mx-0 flex h-24 w-24 items-center justify-center rounded-2xl border text-3xl font-extrabold", accentStyles]}>AR</div>
      <h3 class="mt-4 text-lg font-extrabold text-slate-900">{name}</h3>
      <p class:list={["mt-0.5 text-xs font-semibold", roleColor]}>{role}</p>
      <div class="mt-3 flex justify-center gap-3 md:justify-start">
        <a href={linkedin} target="_blank" rel="noopener noreferrer" class="rounded-xl bg-slate-100 p-2 text-base text-slate-700 transition-colors hover:bg-slate-200" aria-label="LinkedIn">
          <Icon name="mdi:linkedin" />
        </a>
        <a href={github} target="_blank" rel="noopener noreferrer" class="rounded-xl bg-slate-100 p-2 text-base text-slate-700 transition-colors hover:bg-slate-200" aria-label="GitHub">
          <Icon name="mdi:github" />
        </a>
      </div>
    </div>
    <div class="md:col-span-8">
      <blockquote class="text-xl md:text-2xl font-bold leading-snug text-slate-900">"{quote}"</blockquote>
      <p class="mt-3 text-slate-600 text-sm">{statement}</p>
    </div>
  </div>
</div>
