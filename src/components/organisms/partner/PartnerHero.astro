---
import PartnerHeroIllustration from '@components/atoms/illustrations/PartnerHeroIllustration.astro';
import PartnerCtaButton from '@components/atoms/partner/PartnerCtaButton.astro';

const whatsappRegisterUrl =
  'https://api.whatsapp.com/send?phone=6289512589756&text=' +
  encodeURIComponent('Halo Tim Partnership Renggani, saya ingin mendaftar sebagai Mitra Afiliasi SaaS CV. Renggani Karya Semesta.');
---

<header class="relative overflow-hidden bg-gradient-to-b from-blue-900 via-slate-900 to-slate-950 text-white pt-28 pb-16 lg:pt-32 lg:pb-24">
  <!-- Subtle Background Grid Effect -->
  <div class="absolute inset-0 bg-[linear-gradient(to_right,#1e293b0a_1px,transparent_1px),linear-gradient(to_bottom,#1e293b0a_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)] pointer-events-none" aria-hidden="true"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      <!-- Left Content -->
      <div class="lg:col-span-6 space-y-6 text-center lg:text-left">
        <!-- Eyebrow Pill -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-500/10 border border-blue-400/20 backdrop-blur-md">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span class="text-xs font-semibold text-blue-200 tracking-wide uppercase">
            Program Kemitraan Resmi SaaS
          </span>
        </div>

        <!-- Headline -->
        <h1 class="font-sans text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white leading-tight">
          Dapatkan Komisi Berkelanjutan <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-sky-300 to-emerald-400">5% hingga 25%</span> Tiap Pembayaran Klien
        </h1>

        <!-- Subtext -->
        <p class="font-roboto text-base sm:text-lg text-slate-300 leading-relaxed max-w-xl mx-auto lg:mx-0">
          Rekomendasikan BukuBatik dan software SaaS Renggani kepada rekan bisnis Anda. Nikmati bagi hasil recurring bulanan tanpa batas waktu.
        </p>

        <!-- CTA Action Buttons -->
        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-3.5 pt-2">
          <PartnerCtaButton href={whatsappRegisterUrl} variant="emerald" size="lg" class="w-full sm:w-auto">
            Daftar Menjadi Mitra
          </PartnerCtaButton>
          <a
            href="#kalkulator"
            class="inline-flex items-center justify-center px-6 py-3.5 text-base font-semibold rounded-xl text-slate-200 bg-white/10 hover:bg-white/15 border border-white/20 backdrop-blur-sm transition-all hover:-translate-y-0.5 active:translate-y-0 w-full sm:w-auto"
          >
            Hitung Simulasi Komisi
          </a>
        </div>

        <!-- Trust Metric Counters -->
        <div class="pt-6 border-t border-slate-800/80 grid grid-cols-3 gap-4 text-center lg:text-left">
          <div>
            <div class="text-xl sm:text-2xl font-bold text-white font-sans">Hingga 25%</div>
            <div class="text-xs text-slate-400 mt-0.5">Komisi Recurring</div>
          </div>
          <div>
            <div class="text-xl sm:text-2xl font-bold text-emerald-400 font-sans">Tiap Tgl 10</div>
            <div class="text-xs text-slate-400 mt-0.5">Jadwal Payout Rutin</div>
          </div>
          <div>
            <div class="text-xl sm:text-2xl font-bold text-white font-sans">0 Rupiah</div>
            <div class="text-xs text-slate-400 mt-0.5">Biaya Pendaftaran</div>
          </div>
        </div>
      </div>

      <!-- Right Illustration -->
      <div class="lg:col-span-6 flex justify-center">
        <PartnerHeroIllustration />
      </div>
    </div>
  </div>
</header>
