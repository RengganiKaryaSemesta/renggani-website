---
import PartnerCommissionCalculator from '@components/molecules/partner/PartnerCommissionCalculator';
---

<section id="kalkulator" class="py-16 lg:py-24 bg-white dark:bg-slate-900 border-y border-slate-200/80 dark:border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mx-auto text-center mb-10 lg:mb-14">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 dark:bg-emerald-950/60 dark:text-emerald-300 border border-emerald-200/80 dark:border-emerald-800 text-xs font-semibold uppercase tracking-wider mb-3">
        Kalkulator Interaktif
      </div>
      <h2 class="font-sans text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        Simulasi Potensi Komisi Bulanan & Tahunan
      </h2>
      <p class="font-roboto text-sm sm:text-base text-slate-600 dark:text-slate-300 mt-3 max-w-2xl mx-auto leading-relaxed">
        Geser jumlah klien referal dan pilih estimasi paket SaaS untuk melihat live kalkulasi persentase tier serta proyeksi pendapatan pasif Anda.
      </p>
    </div>

    <PartnerCommissionCalculator client:load />
  </div>
</section>
