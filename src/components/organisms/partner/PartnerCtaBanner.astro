---
import PartnerCtaButton from '@components/atoms/partner/PartnerCtaButton.astro';

const whatsappUrl1 =
  'https://api.whatsapp.com/send?phone=6289512589756&text=' +
  encodeURIComponent('Halo Tim Partnership Renggani (+62 895-1258-9756), saya tertarik bergabung dalam Program Mitra & Afiliasi SaaS Renggani.');

const whatsappUrl2 =
  'https://api.whatsapp.com/send?phone=6285234104446&text=' +
  encodeURIComponent('Halo Tim Partnership Renggani (+62 852-3410-4446), saya tertarik bergabung dalam Program Mitra & Afiliasi SaaS Renggani.');
---

<section class="py-16 lg:py-20 bg-gradient-to-br from-blue-950 via-slate-900 to-blue-900 text-white relative overflow-hidden">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-400/20 backdrop-blur-md mb-6">
      <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
      <span class="text-xs font-semibold text-emerald-300 tracking-wide uppercase">
        Siap Memulai Kemitraan?
      </span>
    </div>

    <h2 class="font-sans text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white mb-4 leading-tight">
      Bangun Aliran Pendapatan Pasif Berkelanjutan Bersama Kami
    </h2>

    <p class="font-roboto text-base sm:text-lg text-slate-300 max-w-2xl mx-auto mb-8 leading-relaxed">
      Daftar sekarang tanpa biaya registrasi. Hubungi tim Partnership kami melalui saluran WhatsApp resmi untuk konsultasi dan penerbitan link referral Anda.
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <PartnerCtaButton href={whatsappUrl1} variant="emerald" size="lg" class="w-full sm:w-auto">
        <svg class="w-5 h-5 mr-1" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2z" />
        </svg>
        WhatsApp Partner Line 1 (+62 895-1258-9756)
      </PartnerCtaButton>

      <PartnerCtaButton href={whatsappUrl2} variant="dark-outline" size="lg" class="w-full sm:w-auto">
        <svg class="w-5 h-5 mr-1" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2z" />
        </svg>
        WhatsApp Partner Line 2 (+62 852-3410-4446)
      </PartnerCtaButton>
    </div>
  </div>
</section>
