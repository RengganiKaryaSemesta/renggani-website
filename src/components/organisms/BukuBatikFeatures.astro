---
import { Image } from "astro:assets";
import penjualanImg from "@assets/buku-batik/penjualan-screen.png";
import biayaImg from "@assets/buku-batik/biaya-screen.png";
import kontakImg from "@assets/buku-batik/kontak-screen.png";
import loginImg from "@assets/buku-batik/login-screen.png";
import kartuPiutangImg from "@assets/buku-batik/kartu-piutang-screen.png";
import laporanGeneralImg from "@assets/buku-batik/laporan-general-screen.png";
import laporanProductImg from "@assets/buku-batik/laporan-product-screen.png";
import rekonsiliasiBankImg from "@assets/buku-batik/rekonsiliasi-bank-screen.png";
import { Icon } from "astro-icon/components";

const waLinkPenawaran = "https://api.whatsapp.com/send?phone=6289512589756&text=Halo%20Renggani%2C%20saya%20tertarik%20dengan%20produk%20BukuBatik.%20Mohon%20informasi%20penawaran%20dan%20demo%20sistemnya.";
---

<section class="py-20 px-5 lg:px-20 bg-gray-50 dark:bg-gray-900 text-gray-800 dark:text-gray-100 font-roboto relative overflow-hidden">
    <div class="max-w-7xl mx-auto space-y-28">
        
        <!-- Section Header -->
        <div class="text-center max-w-3xl mx-auto space-y-4">
            <span class="text-xs font-semibold uppercase tracking-wider text-purple-600 dark:text-purple-400 bg-purple-100 dark:bg-purple-950/80 px-4 py-1.5 rounded-full border border-purple-200 dark:border-purple-800">
                Fitur & Modul Lengkap BukuBatik
            </span>
            <h2 class="text-3xl lg:text-5xl font-bold dark:text-white text-gray-900 tracking-tight">
                Solusi Akuntansi & Operasional Perusahaan / UMKM Terpadu
            </h2>
            <p class="text-base lg:text-lg text-gray-600 dark:text-gray-400 leading-relaxed">
                Dari kalkulasi HPP konversi produk bahan baku, Purchase Order (PO), Credit & Debit Memos, Rekonsiliasi Bank, hingga Kartu Piutang dan Laporan Keuangan Standar Akuntansi.
            </p>
        </div>

        <!-- Modul 1: HPP, Konversi Produk & Persediaan Gudang -->
        <div class="grid lg:grid-cols-12 gap-10 items-center">
            <div class="lg:col-span-5 space-y-6">
                <div class="w-12 h-12 rounded-2xl bg-gradient-to-r from-purple-600 to-indigo-600 text-white flex items-center justify-center shadow-lg shadow-purple-600/30">
                    <Icon name="mdi:calculator-variant" class="text-2xl" />
                </div>
                <h3 class="text-2xl lg:text-3xl font-bold dark:text-white text-gray-900">
                    Kalkulasi HPP & Konversi Produk Bahan Baku
                </h3>
                <p class="text-gray-600 dark:text-gray-300 leading-relaxed">
                    Sistem akuntansi terpadu untuk mencatat transaksi konversi bahan baku menjadi produk/barang jadi. Otomatis menghitung Nilai Persediaan dari formula <strong class="text-purple-500">HPP × Stok</strong> serta riwayat mutasi per periode secara presisi.
                </p>
                <ul class="space-y-3 text-sm text-gray-700 dark:text-gray-300">
                    <li class="flex items-center gap-3">
                        <Icon name="mdi:check-circle" class="text-purple-500 text-lg shrink-0" />
                        <span>Riwayat konversi produk bahan baku ke barang jadi</span>
                    </li>
                    <li class="flex items-center gap-3">
                        <Icon name="mdi:check-circle" class="text-purple-500 text-lg shrink-0" />
                        <span>Hitung nilai persediaan HPP × stok secara presisi</span>
                    </li>
                    <li class="flex items-center gap-3">
                        <Icon name="mdi:check-circle" class="text-purple-500 text-lg shrink-0" />
                        <span>Mutasi gudang (saldo awal, Qty masuk/keluar, saldo akhir)</span>
                    </li>
                </ul>
            </div>
            <div class="lg:col-span-7">
                <div class="rounded-2xl overflow-hidden shadow-2xl border border-gray-200 dark:border-gray-700 bg-gray-900 group">
                    <div class="flex items-center gap-2 px-4 py-2 bg-gray-800/90 border-b border-gray-700/80 text-xs text-gray-400 font-mono">
                        <span class="w-2.5 h-2.5 rounded-full bg-red-500 inline-block"></span>
                        <span class="w-2.5 h-2.5 rounded-full bg-yellow-500 inline-block"></span>
                        <span class="w-2.5 h-2.5 rounded-full bg-green-500 inline-block"></span>
                        <span class="ml-2">Laporan Konversi & HPP Produk</span>
                    </div>
                    <Image
                        src={laporanProductImg}
                        alt="Fitur HPP dan Konversi Produk BukuBatik"
                        class="w-full h-auto object-cover transform group-hover:scale-102 transition-transform duration-500"
                        quality={95}
                    />
                </div>
            </div>
        </div>

        <!-- Modul 2: Pembelian, Purchase Request (PR) & Purchase Order (PO) -->
        <div class="grid lg:grid-cols-12 gap-10 items-center">
            <div class="lg:col-span-7 order-2 lg:order-1">
                <div class="rounded-2xl overflow-hidden shadow-2xl border border-gray-200 dark:border-gray-700 bg-gray-900 group">
                    <div class="flex items-center gap-2 px-4 py-2 bg-gray-800/90 border-b border-gray-700/80 text-xs text-gray-400 font-mono">
                        <span class="w-2.5 h-2.5 rounded-full bg-red-500 inline-block"></span>
                        <span class="w-2.5 h-2.5 rounded-full bg-yellow-500 inline-block"></span>
                        <span class="w-2.5 h-2.5 rounded-full bg-green-500 inline-block"></span>
                        <span class="ml-2">Pengeluaran & Alur PO Pembelian</span>
                    </div>
                    <Image
                        src={biayaImg}
                        alt="Fitur Purchase Request dan Purchase Order BukuBatik"
                        class="w-full h-auto object-cover transform group-hover:scale-102 transition-transform duration-500"
                        quality={95}
                    />
                </div>
            </div>
            <div class="lg:col-span-5 space-y-6 order-1 lg:order-2">
                <div class="w-12 h-12 rounded-2xl bg-indigo-600 text-white flex items-center justify-center shadow-lg shadow-indigo-600/30">
                    <Icon name="mdi:cart-arrow-down" class="text-2xl" />
                </div>
                <h3 class="text-2xl lg:text-3xl font-bold dark:text-white text-gray-900">
                    Alur Pembelian: PR, PO & Kontrol Supplier
                </h3>
                <p class="text-gray-600 dark:text-gray-300 leading-relaxed">
                    Kelola rantai pasok pengadaan bahan baku & persediaan barang secara rapi. Dari draf pengajuan <strong class="text-indigo-500">Purchase Request (PR)</strong>, approval <strong class="text-indigo-500">Purchase Order (PO)</strong>, hingga penerimaan fisik stok di gudang.
                </p>
                <ul class="space-y-3 text-sm text-gray-700 dark:text-gray-300">
                    <li class="flex items-center gap-3">
                        <Icon name="mdi:check-circle" class="text-indigo-500 text-lg shrink-0" />
                        <span>Manajemen dokumen Purchase Request & Order</span>
                    </li>
                    <li class="flex items-center gap-3">
                        <Icon name="mdi:check-circle" class="text-indigo-500 text-lg shrink-0" />
                        <span>Verifikasi faktur pembelian vendor & retur barang</span>
                    </li>
                </ul>
            </div>
        </div>

        <!-- Modul 3: Kartu Piutang, Credit & Debit Memos -->
        <div class="grid lg:grid-cols-12 gap-10 items-center">
            <div class="lg:col-span-5 space-y-6">
                <div class="w-12 h-12 rounded-2xl bg-blue-600 text-white flex items-center justify-center shadow-lg shadow-blue-600/30">
                    <Icon name="mdi:card-account-details-outline" class="text-2xl" />
                </div>
                <h3 class="text-2xl lg:text-3xl font-bold dark:text-white text-gray-900">
                    Kartu Piutang, Credit & Debit Memos
                </h3>
                <p class="text-gray-600 dark:text-gray-300 leading-relaxed">
                    Pantau rincian saldo piutang per pelanggan (<em class="not-italic text-blue-500 font-semibold">Customer Ledger</em>). BukuBatik otomatis mencatat penambahan debit dari faktur baru, pelunasan kredit dari pembayaran & retur, serta penerbitan <strong class="text-blue-500">Credit Memo</strong> & <strong class="text-blue-500">Debit Memo</strong> untuk koreksi saldo berjalan.
                </p>
                <ul class="space-y-3 text-sm text-gray-700 dark:text-gray-300">
                    <li class="flex items-center gap-3">
                        <Icon name="mdi:check-circle" class="text-blue-500 text-lg shrink-0" />
                        <span>Laporan Kartu Piutang per pelanggan (mutasi debit/kredit)</span>
                    </li>
                    <li class="flex items-center gap-3">
                        <Icon name="mdi:check-circle" class="text-blue-500 text-lg shrink-0" />
                        <span>Penerbitan Debit & Credit Memos untuk retur/diskon</span>
                    </li>
                    <li class="flex items-center gap-3">
                        <Icon name="mdi:check-circle" class="text-blue-500 text-lg shrink-0" />
                        <span>Riwayat bukti transaksi & saldo akhir piutang real-time</span>
                    </li>
                </ul>
            </div>
            <div class="lg:col-span-7">
                <div class="rounded-2xl overflow-hidden shadow-2xl border border-gray-200 dark:border-gray-700 bg-gray-900 group">
                    <div class="flex items-center gap-2 px-4 py-2 bg-gray-800/90 border-b border-gray-700/80 text-xs text-gray-400 font-mono">
                        <span class="w-2.5 h-2.5 rounded-full bg-red-500 inline-block"></span>
                        <span class="w-2.5 h-2.5 rounded-full bg-yellow-500 inline-block"></span>
                        <span class="w-2.5 h-2.5 rounded-full bg-green-500 inline-block"></span>
                        <span class="ml-2">Laporan Kartu Piutang Pelanggan</span>
                    </div>
                    <Image
                        src={kartuPiutangImg}
                        alt="Fitur Kartu Piutang BukuBatik"
                        class="w-full h-auto object-cover transform group-hover:scale-102 transition-transform duration-500"
                        quality={95}
                    />
                </div>
            </div>
        </div>

        <!-- Modul 4: Laporan Keuangan Standar Akuntansi -->
        <div class="grid lg:grid-cols-12 gap-10 items-center">
            <div class="lg:col-span-7 order-2 lg:order-1">
                <div class="rounded-2xl overflow-hidden shadow-2xl border border-gray-200 dark:border-gray-700 bg-gray-900 group">
                    <div class="flex items-center gap-2 px-4 py-2 bg-gray-800/90 border-b border-gray-700/80 text-xs text-gray-400 font-mono">
                        <span class="w-2.5 h-2.5 rounded-full bg-red-500 inline-block"></span>
                        <span class="w-2.5 h-2.5 rounded-full bg-yellow-500 inline-block"></span>
                        <span class="w-2.5 h-2.5 rounded-full bg-green-500 inline-block"></span>
                        <span class="ml-2">Laporan Keuangan & General Ledger</span>
                    </div>
                    <Image
                        src={laporanGeneralImg}
                        alt="Fitur Laporan Keuangan Lengkap BukuBatik"
                        class="w-full h-auto object-cover transform group-hover:scale-102 transition-transform duration-500"
                        quality={95}
                    />
                </div>
            </div>
            <div class="lg:col-span-5 space-y-6 order-1 lg:order-2">
                <div class="w-12 h-12 rounded-2xl bg-purple-600 text-white flex items-center justify-center shadow-lg shadow-purple-600/30">
                    <Icon name="mdi:file-chart-outline" class="text-2xl" />
                </div>
                <h3 class="text-2xl lg:text-3xl font-bold dark:text-white text-gray-900">
                    Laporan Keuangan Komprehensif
                </h3>
                <p class="text-gray-600 dark:text-gray-300 leading-relaxed">
                    Hasilkan laporan keuangan yang akurat dan siap diunduh/dicetak kapan saja tanpa perlu menyusun jurnal manual yang rumit.
                </p>
                <div class="grid grid-cols-2 gap-3 text-xs font-medium text-gray-700 dark:text-gray-300">
                    <div class="p-3 bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 flex items-center gap-2">
                        <Icon name="mdi:notebook-outline" class="text-purple-500 text-base" />
                        <span>Buku Besar</span>
                    </div>
                    <div class="p-3 bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 flex items-center gap-2">
                        <Icon name="mdi:swap-horizontal" class="text-purple-500 text-base" />
                        <span>Jurnal Umum</span>
                    </div>
                    <div class="p-3 bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 flex items-center gap-2">
                        <Icon name="mdi:scale-balance" class="text-purple-500 text-base" />
                        <span>Neraca Saldo</span>
                    </div>
                    <div class="p-3 bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 flex items-center gap-2">
                        <Icon name="mdi:chart-line" class="text-purple-500 text-base" />
                        <span>Laba Rugi</span>
                    </div>
                    <div class="p-3 bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 flex items-center gap-2">
                        <Icon name="mdi:bank-transfer" class="text-purple-500 text-base" />
                        <span>Arus Kas</span>
                    </div>
                    <div class="p-3 bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 flex items-center gap-2">
                        <Icon name="mdi:account-cash" class="text-purple-500 text-base" />
                        <span>Perubahan Modal</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Modul 5: Rekonsiliasi Bank & Monitoring Biaya Operasional -->
        <div class="grid lg:grid-cols-12 gap-10 items-center">
            <div class="lg:col-span-5 space-y-6">
                <div class="w-12 h-12 rounded-2xl bg-indigo-600 text-white flex items-center justify-center shadow-lg shadow-indigo-600/30">
                    <Icon name="mdi:bank-check" class="text-2xl" />
                </div>
                <h3 class="text-2xl lg:text-3xl font-bold dark:text-white text-gray-900">
                    Rekonsiliasi Bank & Pencocokan Otomatis
                </h3>
                <p class="text-gray-600 dark:text-gray-300 leading-relaxed">
                    Cocokkan transaksi di rekening koran bank dengan catatan jurnal kas & bank bisnis Anda secara otomatis. Fitur <strong class="text-indigo-500">Pencocokan Otomatis</strong> BukuBatik mendeteksi sisa transaksi yang belum direkonsiliasi dalam hitungan detik.
                </p>
                <ul class="space-y-3 text-sm text-gray-700 dark:text-gray-300">
                    <li class="flex items-center gap-3">
                        <Icon name="mdi:check-circle" class="text-indigo-500 text-lg shrink-0" />
                        <span>Fitur Pencocokan Otomatis Rekening Koran & Jurnal</span>
                    </li>
                    <li class="flex items-center gap-3">
                        <Icon name="mdi:check-circle" class="text-indigo-500 text-lg shrink-0" />
                        <span>Monitoring saldo akhir kas & bank bisnis real-time</span>
                    </li>
                </ul>
            </div>
            <div class="lg:col-span-7">
                <div class="rounded-2xl overflow-hidden shadow-2xl border border-gray-200 dark:border-gray-700 bg-gray-900 group">
                    <div class="flex items-center gap-2 px-4 py-2 bg-gray-800/90 border-b border-gray-700/80 text-xs text-gray-400 font-mono">
                        <span class="w-2.5 h-2.5 rounded-full bg-red-500 inline-block"></span>
                        <span class="w-2.5 h-2.5 rounded-full bg-yellow-500 inline-block"></span>
                        <span class="w-2.5 h-2.5 rounded-full bg-green-500 inline-block"></span>
                        <span class="ml-2">Rekonsiliasi Bank Otomatis</span>
                    </div>
                    <Image
                        src={rekonsiliasiBankImg}
                        alt="Fitur Rekonsiliasi Bank BukuBatik"
                        class="w-full h-auto object-cover transform group-hover:scale-102 transition-transform duration-500"
                        quality={95}
                    />
                </div>
            </div>
        </div>

        <!-- Modul 6: Radar Performa & Analisis Kesehatan Pelanggan -->
        <div class="grid lg:grid-cols-12 gap-10 items-center">
            <div class="lg:col-span-7 order-2 lg:order-1">
                <div class="rounded-2xl overflow-hidden shadow-2xl border border-gray-200 dark:border-gray-700 bg-gray-900 group">
                    <div class="flex items-center gap-2 px-4 py-2 bg-gray-800/90 border-b border-gray-700/80 text-xs text-gray-400 font-mono">
                        <span class="w-2.5 h-2.5 rounded-full bg-red-500 inline-block"></span>
                        <span class="w-2.5 h-2.5 rounded-full bg-yellow-500 inline-block"></span>
                        <span class="w-2.5 h-2.5 rounded-full bg-green-500 inline-block"></span>
                        <span class="ml-2">Radar Kesehatan Pelanggan & Profil Kontak</span>
                    </div>
                    <Image
                        src={kontakImg}
                        alt="Radar Performa dan Kesehatan Pelanggan BukuBatik"
                        class="w-full h-auto object-cover transform group-hover:scale-102 transition-transform duration-500"
                        quality={95}
                    />
                </div>
            </div>
            <div class="lg:col-span-5 space-y-6 order-1 lg:order-2">
                <div class="w-12 h-12 rounded-2xl bg-purple-600 text-white flex items-center justify-center shadow-lg shadow-purple-600/30">
                    <Icon name="mdi:radar" class="text-2xl" />
                </div>
                <h3 class="text-2xl lg:text-3xl font-bold dark:text-white text-gray-900">
                    Radar Performa & Analisis Kesehatan Pelanggan
                </h3>
                <p class="text-gray-600 dark:text-gray-300 leading-relaxed">
                    Evaluasi performa transaksi tiap pelanggan dengan diagram radar 5-dimensi (Ketepatan Bayar, Kelancaran Piutang, Volume Transaksi, Kecepatan Pembayaran, dan Tingkat Retur) untuk menjaga kelancaran arus kas bisnis.
                </p>
                <ul class="space-y-3 text-sm text-gray-700 dark:text-gray-300">
                    <li class="flex items-center gap-3">
                        <Icon name="mdi:check-circle" class="text-purple-500 text-lg shrink-0" />
                        <span>Analisis visual skor kesehatan kredit mitra bisnis</span>
                    </li>
                    <li class="flex items-center gap-3">
                        <Icon name="mdi:check-circle" class="text-purple-500 text-lg shrink-0" />
                        <span>Riwayat pesanan & histori pelunasan terpusat</span>
                    </li>
                </ul>
            </div>
        </div>

        <!-- Modul 7: Keamanan Sistem & Otentikasi Multi-Role -->
        <div class="grid lg:grid-cols-12 gap-10 items-center">
            <div class="lg:col-span-5 space-y-6">
                <div class="w-12 h-12 rounded-2xl bg-slate-800 text-white flex items-center justify-center shadow-lg shadow-slate-800/30">
                    <Icon name="mdi:shield-check-outline" class="text-2xl" />
                </div>
                <h3 class="text-2xl lg:text-3xl font-bold dark:text-white text-gray-900">
                    Keamanan Berlapis & Akses Multi-Role
                </h3>
                <p class="text-gray-600 dark:text-gray-300 leading-relaxed">
                    Lindungi data finansial sensitif perusahaan Anda dengan otentikasi aman Single Sign-On (SSO Google) dan hak akses bertingkat untuk Admin, Akuntan, Gudang, dan Kasir.
                </p>
                <div class="pt-4">
                    <a
                        href={waLinkPenawaran}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-3 bg-gradient-to-r from-purple-600 to-indigo-600 text-white font-bold px-8 py-4 rounded-full shadow-lg shadow-purple-600/30 hover:shadow-purple-500/50 transition-all text-base"
                    >
                        <Icon name="mdi:whatsapp" class="text-xl" />
                        <span>Ajukan Penawaran BukuBatik</span>
                    </a>
                </div>
            </div>
            <div class="lg:col-span-7">
                <div class="rounded-2xl overflow-hidden shadow-2xl border border-gray-200 dark:border-gray-700 bg-gray-900 group">
                    <div class="flex items-center gap-2 px-4 py-2 bg-gray-800/90 border-b border-gray-700/80 text-xs text-gray-400 font-mono">
                        <span class="w-2.5 h-2.5 rounded-full bg-red-500 inline-block"></span>
                        <span class="w-2.5 h-2.5 rounded-full bg-yellow-500 inline-block"></span>
                        <span class="w-2.5 h-2.5 rounded-full bg-green-500 inline-block"></span>
                        <span class="ml-2">Portal Log Masuk Bebas Khawatir (SSO Google)</span>
                    </div>
                    <Image
                        src={loginImg}
                        alt="Portal Otentikasi dan Keamanan BukuBatik"
                        class="w-full h-auto object-cover transform group-hover:scale-102 transition-transform duration-500"
                        quality={95}
                    />
                </div>
            </div>
        </div>

    </div>
</section>
