---
import CtaButton from "@components/atoms/CtaButton.astro";

interface Props {
  title: string;
  line: string;
  primary: { label: string; href: string };
  secondary: { label: string; href: string };
  accent: "orange" | "blue";
  id?: string;
  class?: string;
}

const { title, line, primary, secondary, accent, id, class: customClass = "" } = Astro.props;
const background = accent === "orange" ? "bg-orange-600" : "bg-blue-600";
---

<section id={id} class:list={["py-16 md:py-20 text-white", background, customClass]}>
  <div class="mx-auto max-w-4xl px-5 text-center lg:px-8">
    <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight">{title}</h2>
    <p class="mx-auto mt-3 max-w-xl text-base text-white/80 sm:text-lg">{line}</p>
    <div class="mt-7 flex flex-wrap items-center justify-center gap-3">
      <CtaButton href={primary.href} variant="white" size="lg">{primary.label}</CtaButton>
      <CtaButton href={secondary.href} variant="ghost" size="lg" target={secondary.href.startsWith("mailto:") ? "_self" : undefined}>{secondary.label}</CtaButton>
    </div>
  </div>
</section>
