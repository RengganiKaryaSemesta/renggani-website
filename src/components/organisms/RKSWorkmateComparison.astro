---
import PlanBadge from "@components/atoms/PlanBadge.astro";
import FeatureCheckIcon from "@components/atoms/FeatureCheckIcon.astro";
import CtaButton from "@components/atoms/CtaButton.astro";

interface FeatureItem {
  name: string;
  starter: boolean | string;
  bisnis: boolean | string;
  enterprise: boolean | string;
  isSpecial?: boolean;
}

interface FeatureGroup {
  category: "presensi" | "operasional" | "payroll";
  title: string;
  items: FeatureItem[];
}

const plans = [
  {
    id: "starter",
    name: "Starter",
    capacity: "≤ 50",
    description: "Cocok untuk UMKM dan bisnis berkembang yang ingin presensi selfie GPS bebas repot.",
    isPopular: false,
    ctaText: "Pilih Starter",
    whatsappMsg:
      "Halo Renggani, saya tertarik dengan paket RKSWorkmate Starter (Kapasitas s/d 50 Karyawan). Mohon informasi penawaran dan cara aktivasinya.",
  },
  {
    id: "bisnis",
    name: "Bisnis",
    capacity: "≤ 125",
    description: "Pilihan terfavorit! Lengkap dengan Liveness Face Recognition, multi-cabang & manajemen shift.",
    isPopular: true,
    ctaText: "Pilih Bisnis",
    whatsappMsg:
      "Halo Renggani, saya tertarik dengan paket RKSWorkmate Bisnis (Kapasitas s/d 125 Karyawan dengan Face Recognition). Mohon penawaran dan jadwal demonya.",
  },
  {
    id: "enterprise",
    name: "Enterprise",
    capacity: "≤ 250",
    description: "Solusi end-to-end presensi + full automated payroll, BPJS, PPh 21 & auto-disbursement rekening.",
    isPopular: false,
    ctaText: "Pilih Enterprise",
    whatsappMsg:
      "Halo Renggani, saya tertarik dengan paket RKSWorkmate Enterprise (Kapasitas s/d 250 Karyawan dengan Full Payroll & Disbursement). Mohon informasi penawaran korporasi dan konsultasi teknis.",
  },
];

const featureGroups: FeatureGroup[] = [
  {
    category: "presensi",
    title: "Presensi Biometrik & Validasi Lokasi",
    items: [
      { name: "Kapasitas karyawan", starter: "≤ 50", bisnis: "≤ 125", enterprise: "≤ 250" },
      { name: "Absen selfie", starter: true, bisnis: true, enterprise: true },
      { name: "Validasi lokasi (GPS)", starter: true, bisnis: true, enterprise: true },
      { name: "Notifikasi keterlambatan", starter: true, bisnis: true, enterprise: true },
      { name: "Riwayat kehadiran", starter: true, bisnis: true, enterprise: true },
      { name: "Liveness detection", starter: false, bisnis: true, enterprise: true },
      { name: "Face recognition", starter: false, bisnis: true, enterprise: true },
    ],
  },
  {
    category: "operasional",
    title: "Manajemen SDM & Operasional Kerja",
    items: [
      { name: "Izin, sakit & cuti online", starter: false, bisnis: true, enterprise: true },
      { name: "Multi-cabang / multi-lokasi", starter: false, bisnis: true, enterprise: true },
      { name: "Shift & jadwal fleksibel", starter: false, bisnis: true, enterprise: true },
      { name: "Approval berjenjang", starter: false, bisnis: false, enterprise: true },
    ],
  },
  {
    category: "payroll",
    title: "Otomasi Payroll, Pajak & Keuangan",
    items: [
      { name: "Perhitungan gaji & lembur", starter: false, bisnis: false, enterprise: true },
      { name: "Perhitungan THR", starter: false, bisnis: false, enterprise: true },
      { name: "PPh 21 & BPJS", starter: false, bisnis: false, enterprise: true },
      { name: "Slip gaji digital", starter: false, bisnis: false, enterprise: true },
      { name: "Komponen gaji kustom", starter: false, bisnis: false, enterprise: true },
      { name: "Disbursement ke rekening", starter: false, bisnis: false, enterprise: true, isSpecial: true },
    ],
  },
];
---

<section id="komparasi-paket" class="py-20 lg:py-28 px-5 lg:px-20 bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-800">
  <div class="max-w-7xl mx-auto space-y-12 lg:space-y-16">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto space-y-4">
      <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 text-xs font-semibold tracking-wide uppercase">
        Matriks Komparasi Paket
      </span>
      <h2 class="text-3xl lg:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        Bandingkan Fitur Sesuai Skala Bisnis
      </h2>
      <p class="text-base lg:text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
        Pilih paket yang paling tepat untuk mengoptimalkan presensi karyawan dan operasional penggajian perusahaan Anda.
      </p>
    </div>

    <!-- Mobile Plan Switcher (Cards view for mobile) -->
    <div class="block lg:hidden space-y-8" id="mobile-plans-container">
      <div class="grid sm:grid-cols-3 gap-3 p-1.5 bg-slate-100 dark:bg-slate-800/80 rounded-2xl border border-slate-200 dark:border-slate-700" role="tablist">
        {
          plans.map((plan, idx) => (
            <button
              type="button"
              role="tab"
              aria-selected={idx === 1 ? "true" : "false"}
              aria-controls={`mobile-panel-${plan.id}`}
              id={`mobile-tab-${plan.id}`}
              class:list={[
                "tab-btn py-2.5 px-4 rounded-xl text-xs font-bold transition-all duration-200 text-center",
                idx === 1
                  ? "bg-emerald-600 text-white shadow-md shadow-emerald-600/30"
                  : "text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white",
              ]}
              data-plan-target={plan.id}
            >
              {plan.name} ({plan.capacity})
            </button>
          ))
        }
      </div>

      <!-- Mobile Tab Panels -->
      {
        plans.map((plan, idx) => (
          <div
            id={`mobile-panel-${plan.id}`}
            role="tabpanel"
            aria-labelledby={`mobile-tab-${plan.id}`}
            class:list={[
              "plan-panel p-6 rounded-3xl border bg-white dark:bg-slate-900 shadow-xl space-y-6 transition-all",
              plan.isPopular
                ? "border-emerald-500/50 shadow-emerald-500/10 ring-1 ring-emerald-500/40"
                : "border-slate-200 dark:border-slate-800",
              idx !== 1 && "hidden",
            ]}
          >
            <div class="flex items-center justify-between">
              <div>
                <span class="text-xs font-mono font-semibold uppercase text-slate-400">Paket Solusi</span>
                <h3 class="text-2xl font-bold text-slate-900 dark:text-white">{plan.name}</h3>
              </div>
              {plan.isPopular ? (
                <PlanBadge text="Paling Populer" isPopular={true} />
              ) : (
                <PlanBadge text={plan.capacity} variant="slate" />
              )}
            </div>

            <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700/60">
              <span class="text-xs text-slate-500 dark:text-slate-400">Kapasitas Maksimal</span>
              <div class="text-3xl font-extrabold text-emerald-600 dark:text-emerald-400 mt-0.5">
                {plan.capacity} <span class="text-base font-normal text-slate-500 dark:text-slate-400">Karyawan</span>
              </div>
              <p class="text-xs text-slate-600 dark:text-slate-300 mt-2 leading-relaxed">
                {plan.description}
              </p>
            </div>

            <div class="space-y-4 pt-2">
              <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400">Daftar Fitur Paket {plan.name}:</h4>
              <ul class="space-y-3 divide-y divide-slate-100 dark:divide-slate-800/80">
                {
                  featureGroups.flatMap((group) =>
                    group.items.map((item) => {
                      const isAvailable =
                        plan.id === "starter"
                          ? item.starter
                          : plan.id === "bisnis"
                            ? item.bisnis
                            : item.enterprise;
                      const hasValue = typeof isAvailable === "string";

                      return (
                        <li class="flex items-center justify-between pt-3 text-sm">
                          <span class:list={["text-slate-700 dark:text-slate-300", item.isSpecial && "font-bold text-emerald-600 dark:text-emerald-400"]}>
                            {item.name}
                          </span>
                          <div>
                            {hasValue ? (
                              <span class="font-bold text-slate-900 dark:text-white bg-slate-100 dark:bg-slate-800 px-2.5 py-1 rounded-lg text-xs">
                                {isAvailable}
                              </span>
                            ) : (
                              <FeatureCheckIcon
                                checked={Boolean(isAvailable)}
                                featureName={item.name}
                                planName={plan.name}
                              />
                            )}
                          </div>
                        </li>
                      );
                    })
                  )
                }
              </ul>
            </div>

            <div class="pt-4">
              <CtaButton
                href={`https://api.whatsapp.com/send?phone=6289512589756&text=${encodeURIComponent(plan.whatsappMsg)}`}
                variant={plan.isPopular ? "primary" : "whatsapp"}
                size="lg"
                class="w-full"
              >
                <span>Pilih Paket {plan.name}</span>
                <svg class="w-4 h-4 ml-1 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                </svg>
              </CtaButton>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Desktop Comparison Table -->
    <div class="hidden lg:block overflow-hidden rounded-3xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xl">
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse" id="desktop-matrix-table">
          <!-- Table Header -->
          <thead>
            <tr class="border-b border-slate-200 dark:border-slate-800 bg-slate-50/80 dark:bg-slate-950/80">
              <th scope="col" class="p-6 w-2/5 align-bottom">
                <span class="text-xs font-mono font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">
                  Fitur & Fungsionalitas
                </span>
                <h3 class="text-xl font-bold text-slate-900 dark:text-white mt-1">
                  Daftar Fitur Lengkap
                </h3>
              </th>
              {
                plans.map((plan) => (
                  <th
                    scope="col"
                    class:list={[
                      "p-6 w-1/5 text-center align-top relative transition-colors",
                      plan.isPopular
                        ? "bg-emerald-500/5 dark:bg-emerald-950/30 border-x border-emerald-500/30"
                        : "",
                    ]}
                  >
                    {plan.isPopular && (
                      <div class="absolute -top-0.5 left-1/2 -translate-x-1/2">
                        <PlanBadge text="Paling Populer" isPopular={true} />
                      </div>
                    )}
                    <div class="pt-3 space-y-1">
                      <div class="text-lg font-bold text-slate-900 dark:text-white">
                        {plan.name}
                      </div>
                      <div class="text-2xl font-extrabold text-emerald-600 dark:text-emerald-400">
                        {plan.capacity}
                      </div>
                      <span class="text-xs text-slate-500 dark:text-slate-400 block">Karyawan</span>
                    </div>
                  </th>
                ))
              }
            </tr>
          </thead>

          <!-- Table Body with Categorized Sections -->
          <tbody class="divide-y divide-slate-200 dark:divide-slate-800 text-sm">
            {
              featureGroups.map((group) => (
                <>
                  <!-- Category Header Row -->
                  <tr class="bg-slate-100/70 dark:bg-slate-950/90 font-semibold text-slate-700 dark:text-slate-300">
                    <td colspan="4" class="py-3.5 px-6 text-xs uppercase tracking-wider font-mono text-emerald-700 dark:text-emerald-400">
                      {group.title}
                    </td>
                  </tr>

                  <!-- Category Items -->
                  {group.items.map((item, index) => (
                    <tr
                      class:list={[
                        "hover:bg-slate-50/80 dark:hover:bg-slate-800/40 transition-colors",
                        index % 2 === 0 ? "bg-white dark:bg-slate-900" : "bg-slate-50/30 dark:bg-slate-900/40",
                      ]}
                    >
                      <th scope="row" class="py-4 px-6 font-medium text-slate-800 dark:text-slate-200">
                        <span class:list={[item.isSpecial && "font-bold text-emerald-700 dark:text-emerald-400 flex items-center gap-1.5"]}>
                          {item.isSpecial && (
                            <svg class="w-4 h-4 text-emerald-500 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
                              <path d="M12 2l2.4 7.4h7.6l-6.2 4.5 2.4 7.4-6.2-4.5-6.2 4.5 2.4-7.4-6.2-4.5h7.6z" />
                            </svg>
                          )}
                          {item.name}
                        </span>
                      </th>

                      <!-- Starter -->
                      <td class="py-4 px-6 text-center">
                        {typeof item.starter === "string" ? (
                          <span class="font-extrabold text-slate-900 dark:text-white bg-slate-100 dark:bg-slate-800 px-3 py-1 rounded-lg text-xs">
                            {item.starter}
                          </span>
                        ) : (
                          <FeatureCheckIcon checked={item.starter} featureName={item.name} planName="Starter" />
                        )}
                      </td>

                      <!-- Bisnis (Popular column highlight) -->
                      <td class="py-4 px-6 text-center bg-emerald-500/5 dark:bg-emerald-950/20 border-x border-emerald-500/20">
                        {typeof item.bisnis === "string" ? (
                          <span class="font-extrabold text-emerald-700 dark:text-emerald-300 bg-emerald-100 dark:bg-emerald-900/60 px-3 py-1 rounded-lg text-xs">
                            {item.bisnis}
                          </span>
                        ) : (
                          <FeatureCheckIcon checked={item.bisnis} featureName={item.name} planName="Bisnis" />
                        )}
                      </td>

                      <!-- Enterprise -->
                      <td class="py-4 px-6 text-center">
                        {typeof item.enterprise === "string" ? (
                          <span class="font-extrabold text-slate-900 dark:text-white bg-slate-100 dark:bg-slate-800 px-3 py-1 rounded-lg text-xs">
                            {item.enterprise}
                          </span>
                        ) : (
                          <FeatureCheckIcon checked={item.enterprise} featureName={item.name} planName="Enterprise" />
                        )}
                      </td>
                    </tr>
                  ))}
                </>
              ))
            }
          </tbody>

          <!-- Table Footer with CTAs -->
          <tfoot>
            <tr class="bg-slate-50/80 dark:bg-slate-950/80 border-t border-slate-200 dark:border-slate-800">
              <td class="p-6 text-xs text-slate-500 dark:text-slate-400">
                Pilih paket yang paling sesuai, Anda dapat melakukan upgrade skala kapasitas kapan saja.
              </td>
              {
                plans.map((plan) => (
                  <td
                    class:list={[
                      "p-6 text-center",
                      plan.isPopular ? "bg-emerald-500/5 dark:bg-emerald-950/30 border-x border-emerald-500/30" : "",
                    ]}
                  >
                    <CtaButton
                      href={`https://api.whatsapp.com/send?phone=6289512589756&text=${encodeURIComponent(plan.whatsappMsg)}`}
                      variant={plan.isPopular ? "primary" : "outline"}
                      size="sm"
                      class="w-full"
                    >
                      <span>{plan.ctaText}</span>
                    </CtaButton>
                  </td>
                ))
              }
            </tr>
          </tfoot>
        </table>
      </div>
    </div>
  </div>
</section>

<script>
  function setupMobilePlanTabs() {
    const tabButtons = document.querySelectorAll<HTMLButtonElement>(".tab-btn");
    const panels = document.querySelectorAll<HTMLElement>(".plan-panel");

    tabButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const targetId = button.dataset.planTarget;

        tabButtons.forEach((btn) => {
          btn.classList.remove("bg-emerald-600", "text-white", "shadow-md", "shadow-emerald-600/30");
          btn.classList.add("text-slate-600", "dark:text-slate-300");
          btn.setAttribute("aria-selected", "false");
        });

        button.classList.add("bg-emerald-600", "text-white", "shadow-md", "shadow-emerald-600/30");
        button.classList.remove("text-slate-600", "dark:text-slate-300");
        button.setAttribute("aria-selected", "true");

        panels.forEach((panel) => {
          if (panel.id === `mobile-panel-${targetId}`) {
            panel.classList.remove("hidden");
          } else {
            panel.classList.add("hidden");
          }
        });
      });
    });
  }

  document.addEventListener("astro:page-load", setupMobilePlanTabs);
  if (document.readyState === "complete" || document.readyState === "interactive") {
    setupMobilePlanTabs();
  }
</script>
