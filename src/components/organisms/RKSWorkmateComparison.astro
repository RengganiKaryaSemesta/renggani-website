---
import PlanBadge from "@components/atoms/PlanBadge.astro";
import FeatureCheckIcon from "@components/atoms/FeatureCheckIcon.astro";
import { Icon } from "astro-icon/components";

interface FeatureItem {
  name: string;
  starter: boolean | string;
  bisnis: boolean | string;
  enterprise: boolean | string;
  isSpecial?: boolean;
}

interface FeatureGroup {
  category: "presensi" | "operasional" | "payroll";
  title: string;
  items: FeatureItem[];
}

const plans = [
  {
    id: "starter",
    name: "Starter",
    price: "Rp200.000",
    capacity: "≤ 50",
    description: "Sangat cocok untuk UMKM dan bisnis berkembang yang ingin presensi selfie GPS bebas repot.",
    isPopular: false,
    highlights: [
      "Kapasitas s/d 50 Karyawan",
      "Absen Selfie & Validasi GPS Anti-Fake",
      "Notifikasi Keterlambatan Otomatis",
      "Riwayat Kehadiran Real-time",
      "1 Lokasi / Kantor Cabang",
    ],
    whatsappMsg:
      "Halo Renggani, saya tertarik dengan paket RKSWorkmate Starter (Rp200.000/bln - Kapasitas s/d 50 Karyawan). Mohon informasi penawaran dan jadwal demonya.",
  },
  {
    id: "bisnis",
    name: "Bisnis",
    price: "Rp500.000",
    capacity: "≤ 125",
    description: "Paling populer! Dilengkapi Liveness Face Recognition AI, multi-cabang & manajemen shift.",
    isPopular: true,
    highlights: [
      "Seluruh fitur paket Starter",
      "Kapasitas s/d 125 Karyawan",
      "Liveness Face Recognition AI",
      "Pengajuan Izin, Sakit & Cuti Online",
      "Multi-Cabang & Shift Fleksibel",
    ],
    whatsappMsg:
      "Halo Renggani, saya tertarik dengan paket RKSWorkmate Bisnis (Rp500.000/bln - Paling Populer). Mohon penawaran dan jadwal demonya.",
  },
  {
    id: "enterprise",
    name: "Enterprise",
    price: "Rp850.000",
    capacity: "≤ 250",
    description: "Solusi end-to-end presensi + full automated payroll, BPJS, PPh 21 & auto-disbursement rekening.",
    isPopular: false,
    highlights: [
      "Seluruh fitur paket Bisnis",
      "Kapasitas s/d 250 Karyawan",
      "Perhitungan Gaji, Lembur & THR Otomatis",
      "Kalkulasi Pajak PPh 21 & Iuran BPJS",
      "Slip Gaji Digital & Auto-Disbursement Bank",
    ],
    whatsappMsg:
      "Halo Renggani, saya tertarik dengan paket RKSWorkmate Enterprise (Rp850.000/bln - Full Payroll & Auto-Disbursement). Mohon informasi penawaran korporasi dan konsultasi teknis.",
  },
];

const featureGroups: FeatureGroup[] = [
  {
    category: "presensi",
    title: "Presensi Biometrik & Validasi Lokasi",
    items: [
      { name: "Kapasitas karyawan", starter: "≤ 50", bisnis: "≤ 125", enterprise: "≤ 250" },
      { name: "Absen selfie", starter: true, bisnis: true, enterprise: true },
      { name: "Validasi lokasi (GPS)", starter: true, bisnis: true, enterprise: true },
      { name: "Notifikasi keterlambatan", starter: true, bisnis: true, enterprise: true },
      { name: "Riwayat kehadiran", starter: true, bisnis: true, enterprise: true },
      { name: "Liveness detection", starter: false, bisnis: true, enterprise: true },
      { name: "Face recognition", starter: false, bisnis: true, enterprise: true },
    ],
  },
  {
    category: "operasional",
    title: "Manajemen SDM & Operasional Kerja",
    items: [
      { name: "Izin, sakit & cuti online", starter: false, bisnis: true, enterprise: true },
      { name: "Multi-cabang / multi-lokasi", starter: false, bisnis: true, enterprise: true },
      { name: "Shift & jadwal fleksibel", starter: false, bisnis: true, enterprise: true },
      { name: "Approval berjenjang", starter: false, bisnis: false, enterprise: true },
    ],
  },
  {
    category: "payroll",
    title: "Otomasi Payroll, Pajak & Keuangan",
    items: [
      { name: "Perhitungan gaji & lembur", starter: false, bisnis: false, enterprise: true },
      { name: "Perhitungan THR", starter: false, bisnis: false, enterprise: true },
      { name: "PPh 21 & BPJS", starter: false, bisnis: false, enterprise: true },
      { name: "Slip gaji digital", starter: false, bisnis: false, enterprise: true },
      { name: "Komponen gaji kustom", starter: false, bisnis: false, enterprise: true },
      { name: "Disbursement ke rekening", starter: false, bisnis: false, enterprise: true, isSpecial: true },
    ],
  },
];
---

<section id="komparasi-paket" class="py-24 px-5 lg:px-20 bg-slate-50 dark:bg-slate-950 font-roboto border-b border-slate-200 dark:border-slate-800 transition-colors duration-300">
  <div class="max-w-7xl mx-auto space-y-20">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto space-y-4">
      <span class="text-xs font-mono font-bold uppercase tracking-[0.2em] text-rose-900 dark:text-rose-400 bg-rose-900/10 dark:bg-rose-950/80 px-4 py-1.5 rounded-full border border-rose-900/20 dark:border-rose-900/40">
        SKEMA PAKET TRANSPARAN
      </span>
      <h2 class="text-4xl lg:text-5xl font-black dark:text-white text-slate-900 tracking-tight leading-none">
        Pilihan Tepat Sesuai Skala Tim Anda
      </h2>
      <p class="text-base lg:text-lg text-slate-600 dark:text-slate-400 leading-relaxed">
        Pilih paket yang sesuai dengan jumlah karyawan dan kebutuhan otomasi HR Anda saat ini. Skalabilitas mudah tanpa kendala migrasi.
      </p>
    </div>

    <!-- 3 Pricing Cards Grid (Identical Structure to BukuBatik) -->
    <div class="grid lg:grid-cols-3 gap-8 items-stretch pt-4">
      {plans.map((plan) => (
        <div 
          class={`relative flex flex-col justify-between p-8 lg:p-10 rounded-3xl border-2 transition-all duration-300 hover:shadow-2xl ${
            plan.isPopular 
              ? 'bg-white dark:bg-slate-900 border-rose-900 shadow-xl shadow-rose-900/10 dark:shadow-rose-900/5 lg:scale-105 z-10' 
              : 'bg-white dark:bg-slate-900 border-slate-200 dark:border-slate-800 hover:border-rose-300 dark:hover:border-rose-900/60'
          }`}
        >
          {plan.isPopular && (
            <div class="absolute -top-4 left-1/2 transform -translate-x-1/2">
              <PlanBadge text="Paling Populer" isPopular={true} variant="rose" />
            </div>
          )}

          <div>
            <!-- Header Card -->
            <div class="border-b border-slate-100 dark:border-slate-800/80 pb-6 mb-6">
              <h3 class="text-2xl font-black text-slate-900 dark:text-white">{plan.name}</h3>
              <p class="text-xs text-slate-500 dark:text-slate-400 mt-2 min-h-[36px]">{plan.description}</p>
            </div>

            <!-- Price Display -->
            <div class="mb-4">
              <span class="text-xs font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-wider block">Investasi Mulai</span>
              <div class="flex items-baseline gap-1 mt-1">
                <span class="text-3xl lg:text-4xl font-extrabold text-slate-900 dark:text-white font-mono tracking-tight">
                  {plan.price}
                </span>
                <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">/bulan</span>
              </div>
            </div>

            <!-- Capacity Display Badge -->
            <div class="mb-6 p-3 rounded-2xl bg-rose-50/60 dark:bg-rose-950/20 border border-rose-100 dark:border-rose-900/30 flex items-center justify-between">
              <span class="text-xs text-slate-600 dark:text-slate-400 font-medium">Kapasitas Maksimal</span>
              <span class="text-sm font-extrabold text-rose-900 dark:text-rose-300 font-mono">{plan.capacity} Karyawan</span>
            </div>

            <!-- Bullet Highlights -->
            <div class="space-y-3 pt-2 pb-6 border-t border-slate-100 dark:border-slate-800/60">
              <span class="text-xs font-bold text-slate-900 dark:text-white uppercase tracking-wider block">Fitur Utama:</span>
              <ul class="space-y-2.5">
                {plan.highlights.map((highlight) => (
                  <li class="flex items-start gap-2.5 text-xs lg:text-sm text-slate-600 dark:text-slate-300">
                    <Icon name="mdi:check-circle" class="text-rose-900 dark:text-rose-400 text-base shrink-0 mt-0.5" />
                    <span>{highlight}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <!-- Card WhatsApp Action Button -->
          <div class="pt-6 border-t border-slate-100 dark:border-slate-800/80">
            <a
              href={`https://api.whatsapp.com/send?phone=6289512589756&text=${encodeURIComponent(plan.whatsappMsg)}`}
              target="_blank"
              rel="noopener noreferrer"
              class={`w-full py-3.5 px-4 rounded-xl text-center text-xs lg:text-sm font-bold uppercase tracking-wider flex items-center justify-center gap-2 transition-all duration-200 ${
                plan.isPopular
                  ? 'bg-rose-900 hover:bg-rose-850 text-white shadow-lg shadow-rose-900/20 hover:shadow-rose-900/35 hover:-translate-y-0.5'
                  : 'bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-800 dark:text-slate-200 hover:-translate-y-0.5'
              }`}
            >
              <Icon name="mdi:whatsapp" class="text-lg" />
              <span>Pilih {plan.name}</span>
            </a>
          </div>
        </div>
      ))}
    </div>

    <!-- Comparison Matrix Table -->
    <div class="space-y-8 pt-8">
      <div class="text-center max-w-2xl mx-auto space-y-2">
        <h3 class="text-2xl lg:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
          Matriks Perbandingan 17 Fitur Lengkap
        </h3>
        <p class="text-sm text-slate-500 dark:text-slate-400">
          Tinjau seluruh kapabilitas teknis dan operasional secara detail antar paket RKSWorkmate.
        </p>
      </div>

      <!-- Desktop Matrix Table -->
      <div class="rounded-3xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xl overflow-hidden">
        <div class="overflow-x-auto">
          <table id="desktop-matrix-table" class="w-full text-left border-collapse min-w-[700px]">
            <!-- Table Head -->
            <thead>
              <tr class="border-b border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-950/80">
                <th scope="col" class="p-6 w-2/5 text-slate-900 dark:text-white font-bold text-base">
                  Fitur & Spesifikasi
                </th>
                {plans.map((plan) => (
                  <th 
                    scope="col" 
                    class={`p-6 w-1/5 text-center align-top relative transition-colors ${
                      plan.isPopular ? 'bg-rose-900/5 dark:bg-rose-950/20 border-x border-rose-900/20' : ''
                    }`}
                  >
                    <div class="space-y-1">
                      <div class="text-base font-bold text-slate-900 dark:text-white">{plan.name}</div>
                      <div class="text-xl font-extrabold text-rose-900 dark:text-rose-400 font-mono">{plan.price}</div>
                      <span class="text-xs text-slate-500 dark:text-slate-400 block font-semibold">{plan.capacity} Karyawan</span>
                    </div>
                  </th>
                ))}
              </tr>
            </thead>

            <!-- Table Body with Categorized Sections -->
            <tbody class="divide-y divide-slate-200 dark:divide-slate-800 text-sm">
              {featureGroups.map((group) => (
                <>
                  <!-- Category Header Row -->
                  <tr class="bg-slate-100/70 dark:bg-slate-950/90 font-semibold text-slate-700 dark:text-slate-300">
                    <td colspan="4" class="py-3.5 px-6 text-xs uppercase tracking-wider font-mono text-rose-900 dark:text-rose-400 font-bold">
                      {group.title}
                    </td>
                  </tr>

                  <!-- Category Items -->
                  {group.items.map((item, index) => (
                    <tr class={`hover:bg-slate-50/80 dark:hover:bg-slate-800/40 transition-colors ${
                      index % 2 === 0 ? 'bg-white dark:bg-slate-900' : 'bg-slate-50/30 dark:bg-slate-900/40'
                    }`}>
                      <th scope="row" class="py-4 px-6 font-medium text-slate-800 dark:text-slate-200">
                        <span class={item.isSpecial ? "font-bold text-rose-900 dark:text-rose-400 flex items-center gap-1.5" : ""}>
                          {item.name}
                        </span>
                      </th>

                      <!-- Starter -->
                      <td class="py-4 px-6 text-center">
                        {typeof item.starter === "string" ? (
                          <span class="font-extrabold text-slate-900 dark:text-white bg-slate-100 dark:bg-slate-800 px-3 py-1 rounded-lg text-xs">
                            {item.starter}
                          </span>
                        ) : (
                          <FeatureCheckIcon checked={item.starter} featureName={item.name} planName="Starter" />
                        )}
                      </td>

                      <!-- Bisnis (Popular column) -->
                      <td class="py-4 px-6 text-center bg-rose-900/5 dark:bg-rose-950/20 border-x border-rose-900/20">
                        {typeof item.bisnis === "string" ? (
                          <span class="font-extrabold text-rose-900 dark:text-rose-300 bg-rose-100 dark:bg-rose-950/60 px-3 py-1 rounded-lg text-xs">
                            {item.bisnis}
                          </span>
                        ) : (
                          <FeatureCheckIcon checked={item.bisnis} featureName={item.name} planName="Bisnis" />
                        )}
                      </td>

                      <!-- Enterprise -->
                      <td class="py-4 px-6 text-center">
                        {typeof item.enterprise === "string" ? (
                          <span class="font-extrabold text-slate-900 dark:text-white bg-slate-100 dark:bg-slate-800 px-3 py-1 rounded-lg text-xs">
                            {item.enterprise}
                          </span>
                        ) : (
                          <FeatureCheckIcon checked={item.enterprise} featureName={item.name} planName="Enterprise" />
                        )}
                      </td>
                    </tr>
                  ))}
                </>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>

  </div>
</section>
