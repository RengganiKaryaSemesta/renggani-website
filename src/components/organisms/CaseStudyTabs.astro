---
import StatTile from "@components/atoms/StatTile.astro";
import ScreenshotFrame from "@components/molecules/ScreenshotFrame.astro";
import type { ImageMetadata } from "astro";

interface Props {
  items: {
    id: string;
    tabTitle: string;
    tabSubtitle: string;
    badge: string;
    badgeState: string;
    headline: string;
    body: string;
    image: ImageMetadata;
    alt: string;
    caption: string;
    stats: { value: string; label: string }[];
    stack: string[];
  }[];
  accent?: "orange" | "blue";
  class?: string;
}

const { items, accent = "orange", class: customClass = "" } = Astro.props;
const activeStyles = {
  orange: "border-orange-600 text-orange-700",
  blue: "border-blue-600 text-blue-700",
};
const badgeStyles = {
  orange: "bg-orange-50 text-orange-700 border-orange-200",
  blue: "bg-blue-50 text-blue-700 border-blue-200",
};
---

<div class:list={["overflow-hidden rounded-3xl border border-slate-200/90 bg-white shadow-sm", customClass]} data-case-tabs data-accent={accent}>
  <div class="case-study-strip flex overflow-x-auto border-b border-slate-200 bg-slate-50/70" role="tablist" aria-label="Case studies">
    {items.map((item, index) => (
      <button
        id={`tab-${item.id}`}
        role="tab"
        aria-selected={index === 0 ? "true" : "false"}
        aria-controls={`panel-${item.id}`}
        data-tab-target={`panel-${item.id}`}
        class:list={[
          "min-w-[190px] flex-1 border-b-2 px-5 py-4 text-left transition-colors",
          index === 0 ? ["bg-white", activeStyles[accent]] : "border-transparent text-slate-600 hover:bg-slate-100 hover:text-slate-900",
        ]}
      >
        <span class="block text-sm font-bold">{item.tabTitle}</span>
        <span class="mt-0.5 block text-[11px] text-slate-500">{item.tabSubtitle}</span>
      </button>
    ))}
  </div>

  {items.map((item, index) => (
    <div id={`panel-${item.id}`} role="tabpanel" aria-labelledby={`tab-${item.id}`} hidden={index !== 0} class="p-6 md:p-8 lg:p-10">
      <div class="grid lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-5">
          <div class:list={["inline-flex items-center gap-2 rounded-full border px-3 py-1 text-xs font-bold", badgeStyles[accent]]}>
            <span>{item.badge}</span>
            <span class="h-1 w-1 rounded-full bg-current" aria-hidden="true"></span>
            <span>{item.badgeState}</span>
          </div>
          <h3 class="mt-4 text-2xl sm:text-3xl font-extrabold tracking-tight text-slate-900">{item.headline}</h3>
          <p class="mt-3 text-sm md:text-base text-slate-600">{item.body}</p>
          <div class="mt-6 grid grid-cols-2 gap-3">
            {item.stats.slice(0, 2).map((stat, statIndex) => (
              <StatTile value={stat.value} label={stat.label} tone={statIndex === 0 ? "emerald" : accent} />
            ))}
          </div>
          <div class="mt-5 flex flex-wrap gap-2">
            {item.stack.map((technology) => (
              <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-600">{technology}</span>
            ))}
          </div>
        </div>
        <div class="lg:col-span-7">
          <ScreenshotFrame image={item.image} alt={item.alt} caption={item.caption} />
        </div>
      </div>
    </div>
  ))}
</div>

<style>
  .case-study-strip { scrollbar-width: none; }
  .case-study-strip::-webkit-scrollbar { display: none; }
</style>

<script>
  const bindCaseStudyTabs = () => {
    document.querySelectorAll<HTMLElement>("[data-case-tabs]").forEach((root) => {
      if (root.dataset.tabsReady === "true") return;
      root.dataset.tabsReady = "true";
      root.addEventListener("click", (event) => {
        const target = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-tab-target]");
        if (!target) return;
        const panelId = target.dataset.tabTarget;
        if (!panelId) return;
        root.querySelectorAll<HTMLElement>("[role='tabpanel']").forEach((panel) => {
          panel.hidden = panel.id !== panelId;
        });
        root.querySelectorAll<HTMLButtonElement>("[data-tab-target]").forEach((tab) => {
          const selected = tab === target;
          const isBlue = root.dataset.accent === "blue";
          tab.setAttribute("aria-selected", String(selected));
          tab.classList.toggle("bg-white", selected);
          tab.classList.toggle("border-orange-600", selected && !isBlue);
          tab.classList.toggle("border-blue-600", selected && isBlue);
          tab.classList.toggle("text-orange-700", selected && !isBlue);
          tab.classList.toggle("text-blue-700", selected && isBlue);
          tab.classList.toggle("border-transparent", !selected);
          tab.classList.toggle("text-slate-600", !selected);
        });
      });
    });
  };
  document.addEventListener("DOMContentLoaded", bindCaseStudyTabs, { once: true });
  document.addEventListener("astro:page-load", bindCaseStudyTabs);
</script>
