---
import CtaButton from "@components/atoms/CtaButton.astro";

interface Props {
  eyebrow: string;
  title: { lead: string; accent: string };
  subtitle: string;
  primary: { label: string; href: string };
  secondary: { label: string; href: string };
  accent: "orange" | "blue";
  class?: string;
}

const { eyebrow, title, subtitle, primary, secondary, accent, class: customClass = "" } = Astro.props;
const accentStyles = {
  orange: { section: "from-orange-50/70 via-white to-slate-50", text: "text-orange-600", button: "orange" as const, wash: "bg-orange-200/25", orb: "bg-orange-400/20", underline: "bg-orange-600" },
  blue: { section: "from-blue-50/70 via-white to-slate-50", text: "text-blue-600", button: "blue" as const, wash: "bg-blue-200/25", orb: "bg-blue-400/20", underline: "bg-blue-600" },
};
const styles = accentStyles[accent];
---

<section class:list={["relative isolate overflow-hidden border-b border-slate-200/80 bg-gradient-to-br pt-28 pb-16 md:pt-32 md:pb-24", styles.section, customClass]} data-home-hero>
  <div class:list={["pointer-events-none absolute -right-32 top-20 -z-10 h-80 w-80 rounded-full blur-3xl", styles.wash]} aria-hidden="true"></div>
  <div class="pointer-events-none absolute -left-20 bottom-0 -z-10 h-56 w-56 rounded-full bg-sky-100/45 blur-3xl" aria-hidden="true"></div>
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <div class="grid items-center gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-8">
      <div class="max-w-xl space-y-6" data-hero-copy>
        <div class:list={["hero-reveal inline-flex items-center rounded-full border px-3.5 py-1.5 text-xs font-semibold", styles.text, accent === "orange" ? "border-orange-200 bg-orange-100/80" : "border-blue-200 bg-blue-100/80"]}>
          <span class="mr-2 h-1.5 w-1.5 rounded-full bg-current" aria-hidden="true"></span>
          {eyebrow}
        </div>
        <h1 class="hero-reveal hero-reveal-delay-1 text-4xl font-extrabold leading-[1.08] tracking-tight text-slate-950 sm:text-5xl lg:text-[4.25rem]">
          {title.lead} <span class:list={[styles.text, "relative inline-block"]}>{title.accent}<span class:list={["absolute -bottom-2 left-0 h-1 w-2/3 rounded-full opacity-25", styles.underline]}></span></span>
        </h1>
        <p class="hero-reveal hero-reveal-delay-2 max-w-lg text-base leading-relaxed text-slate-600 md:text-lg">{subtitle}</p>
        <div class="hero-reveal hero-reveal-delay-3 flex flex-wrap items-center gap-3 pt-1">
          <CtaButton href={primary.href} variant={styles.button} size="lg">{primary.label}</CtaButton>
          <CtaButton href={secondary.href} variant="white" size="lg" target={secondary.href.startsWith("#") ? "_self" : undefined}>{secondary.label}</CtaButton>
        </div>
      </div>
      <div class="hero-reveal hero-reveal-delay-2 min-w-0 lg:pl-4" data-hero-visual>
        <div class="relative mx-auto min-h-[28rem] max-w-2xl sm:min-h-[34rem]">
          <div class:list={["hero-orb absolute right-2 top-5 h-20 w-20 rounded-[2rem] blur-2xl", styles.orb]} aria-hidden="true"></div>
          <div class="hero-dashboard absolute right-0 top-8 z-10 w-[88%] sm:top-4">
            <slot name="visual" />
          </div>
          <div class="absolute bottom-0 left-0 z-20 transition-transform duration-500 hover:-translate-y-2 hover:rotate-0">
            <slot name="mobile-left" />
          </div>
          <div class="absolute bottom-3 right-0 z-20 transition-transform duration-500 hover:-translate-y-2 hover:rotate-0">
            <slot name="mobile-right" />
          </div>
          <div class="absolute bottom-8 left-1/2 z-30 hidden -translate-x-1/2 rounded-full border border-white/80 bg-white/90 px-4 py-2 text-xs font-semibold text-slate-700 shadow-xl backdrop-blur sm:flex sm:items-center sm:gap-2">
            <span class="h-2 w-2 rounded-full bg-emerald-500" aria-hidden="true"></span>
            Live production systems
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-reveal { opacity: 0; transform: translateY(18px); animation: hero-rise 700ms cubic-bezier(.22,1,.36,1) forwards; }
  .hero-reveal-delay-1 { animation-delay: 90ms; }
  .hero-reveal-delay-2 { animation-delay: 180ms; }
  .hero-reveal-delay-3 { animation-delay: 270ms; }
  .hero-dashboard { animation: dashboard-float 7s ease-in-out 900ms infinite; }
  .hero-orb { animation: orb-drift 8s ease-in-out infinite; }
  @keyframes hero-rise { to { opacity: 1; transform: translateY(0); } }
  @keyframes dashboard-float { 0%, 100% { transform: translateY(0) rotate(0deg); } 50% { transform: translateY(-8px) rotate(0.4deg); } }
  @keyframes orb-drift { 0%, 100% { transform: translate(0, 0); } 50% { transform: translate(-12px, 10px); } }
  @media (prefers-reduced-motion: reduce) {
    .hero-reveal, .hero-dashboard, .hero-orb { animation: none; opacity: 1; transform: none; }
  }
</style>
