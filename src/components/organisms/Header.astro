---
import { Image } from "astro:assets";
import logoColor from "@assets/logo_color.webp";
import logoWhite from "@assets/logo_white.webp";
import NavList from "@components/molecules/NavList";
import SideBarMenu from "@components/molecules/SideBarMenu";
import HeaderButtonContactUs from "@components/atoms/HeaderButtonContactUs";
import SideBarButton from "@components/atoms/SideBarButton";

interface Props {
    isSolid?: boolean;
}
const { isSolid: isSolidProp } = Astro.props;
const currentPathName = Astro.url.pathname;
const isSolid = isSolidProp || currentPathName.startsWith('/blogs') || currentPathName.startsWith('/kebijakan-privasi') || currentPathName.startsWith('/privacy-policy');
---

<div class="relative">
    <nav
        id="navbar"
        role="navigation"
        data-is-solid={isSolid ? "true" : "false"}
        class={`py-3 px-5 lg:px-20 fixed top-0 left-0 right-0 z-50 flex items-center justify-between transition-all duration-300 ${isSolid ? 'bg-white/90 dark:bg-gray-900/90 backdrop-blur-md shadow-sm' : 'bg-transparent'}`}
    >
        <Image
            loading={"eager"}
            src={logoWhite}
            alt={"logo renggani karya semesta"}
            width={130}
            height={51}
            id="logo-white"
            quality={100}
            class={`h-auto ${isSolid ? 'hidden' : 'dark:block'}`}
        />
        <Image
            loading={"eager"}
            src={logoColor}
            alt={"logo renggani karya semesta"}
            width={130}
            height={55}
            id="logo-color"
            class={`h-auto ${isSolid ? 'block' : 'hidden dark:hidden'}`}
        />
        <NavList client:load currentPathName={currentPathName} isSolid={isSolid} />
        <HeaderButtonContactUs client:load className="hidden lg:block" isSolid={isSolid} />
        <SideBarButton client:load isSolid={isSolid} />
    </nav>
    <SideBarMenu client:load currentPathName={currentPathName} />
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const logoWhite = document.getElementById("logo-white");
        const logoColor = document.getElementById("logo-color");
        const navbar = document.getElementById("navbar");
        const isSolid = navbar?.dataset.isSolid === 'true' || window.location.pathname.startsWith('/blogs') || window.location.pathname.startsWith('/kebijakan-privasi') || window.location.pathname.startsWith('/privacy-policy');
        
        function updateNavbar() {
            if (window.scrollY > 50 || isSolid) {
                navbar?.classList.add("bg-white/90", "dark:bg-gray-900/90", "backdrop-blur-md", "shadow-sm");
                navbar?.classList.remove("bg-transparent");
                
                logoColor?.classList.remove("hidden");
                logoColor?.classList.add("block");
                logoWhite?.classList.add("hidden");
                logoWhite?.classList.remove("dark:block");
            } else {
                navbar?.classList.remove("bg-white/90", "dark:bg-gray-900/90", "backdrop-blur-md", "shadow-sm");
                navbar?.classList.add("bg-transparent");
                
                logoColor?.classList.add("hidden");
                logoColor?.classList.remove("block");
                logoWhite?.classList.remove("hidden");
                logoWhite?.classList.add("dark:block");
            }
        }

        window.addEventListener("scroll", updateNavbar);
        updateNavbar();
    });
</script>
