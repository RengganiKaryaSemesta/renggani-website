---
import { Image } from "astro:assets";
import logoColor from "@assets/logo_color.webp";
import NavList from "@components/molecules/NavList";
import SideBarMenu from "@components/molecules/SideBarMenu";
import HeaderButtonContactUs from "@components/atoms/HeaderButtonContactUs";
import SideBarButton from "@components/atoms/SideBarButton";
import LanguageSwitcher from "@components/atoms/LanguageSwitcher";

interface Props {
    isSolid?: boolean;
}

const { isSolid: isSolidProp } = Astro.props;
const currentPathName = Astro.url.pathname;
const isSolid = isSolidProp || currentPathName.startsWith("/en");
---

<div class="relative">
    <nav
        id="navbar"
        role="navigation"
        data-is-solid={isSolid ? "true" : "false"}
        class="fixed left-1/2 top-3 z-50 flex w-[calc(100%-1.5rem)] max-w-7xl -translate-x-1/2 items-center justify-between rounded-full bg-white/90 px-3 py-2.5 shadow-[0_14px_40px_rgba(15,23,42,0.10)] ring-1 ring-slate-200/80 backdrop-blur-xl transition-all duration-300 lg:top-5 lg:px-4"
    >
        <a href={currentPathName.startsWith("/en") ? "/en/" : "/"} aria-label="Renggani Karya Semesta home" class="shrink-0 rounded-full p-1 transition-transform duration-200 hover:scale-[1.03]">
            <Image
                loading="eager"
                src={logoColor}
                alt="Logo Renggani Karya Semesta"
                width={logoColor.width}
                height={logoColor.height}
                quality={100}
                class="block h-auto w-28 sm:w-32"
            />
        </a>
        <NavList client:load currentPathName={currentPathName} isSolid={true} />
        <div class="hidden items-center gap-2 lg:flex">
            <LanguageSwitcher client:load currentPathName={currentPathName} isSolid={true} />
            <HeaderButtonContactUs client:load className="hidden lg:block" isSolid={true} currentPathName={currentPathName} />
        </div>
        <div class="flex items-center gap-1 lg:hidden">
            <LanguageSwitcher client:load currentPathName={currentPathName} isSolid={true} isMobile={true} />
            <SideBarButton client:load isSolid={true} />
        </div>
    </nav>
    <SideBarMenu client:load currentPathName={currentPathName} />
</div>

<script>
    document.addEventListener("astro:page-load", () => {
        const navbar = document.getElementById("navbar");
        if (!navbar || navbar.dataset.motionReady === "true") return;
        navbar.dataset.motionReady = "true";

        const updateNavbar = () => {
            navbar.classList.toggle("-translate-y-1", window.scrollY > 16);
            navbar.classList.toggle("shadow-[0_18px_48px_rgba(15,23,42,0.14)]", window.scrollY > 16);
        };

        window.addEventListener("scroll", updateNavbar, { passive: true });
        updateNavbar();
    });
</script>
