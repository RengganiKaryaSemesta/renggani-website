---
import { Image } from "astro:assets";
import bukuBatikImg from "@assets/buku-batik.png";
import { Icon } from "astro-icon/components";

const features = [
    {
        icon: "mdi:invoice-text-outline",
        title: "Penjualan & Faktur Otomatis",
        desc: "Kelola tagihan, faktur penjualan, pelacakan jatuh tempo, serta sisa piutang pelanggan secara akurat."
    },
    {
        icon: "mdi:cart-outline",
        title: "Pembelian & Inventaris Batik",
        desc: "Atur pesanan pembelian (PO), masuknya bahan baku batik, serta katalog produk dan stok gudang terintegrasi."
    },
    {
        icon: "mdi:cash-register",
        title: "Manajemen Biaya Operasional",
        desc: "Monitoring seluruh pengeluaran bisnis batik Anda, dari biaya produksi hingga operasional harian."
    },
    {
        icon: "mdi:book-open-page-variant-outline",
        title: "Jurnal Umum & Aset Tetap",
        desc: "Pencatatan pembukuan otomatis, jurnal umum, penyusutan aset tetap, serta debit & credit memos."
    },
    {
        icon: "mdi:bank-outline",
        title: "Monitoring Kas & Bank",
        desc: "Pantau arus kas (cash flow) masuk dan keluar secara real-time untuk menjaga likuiditas usaha."
    },
    {
        icon: "mdi:account-group-outline",
        title: "Kontak & Indeks Kesehatan Pelanggan",
        desc: "Database kontak pelanggan dan supplier dilengkapi fitur radar kesehatan performa transaksi & piutang."
    }
];

const waLinkPenawaran = "https://api.whatsapp.com/send?phone=6289512589756&text=Halo%20Renggani%2C%20saya%20tertarik%20dengan%20produk%20BukuBatik.%20Mohon%20informasi%20penawaran%20dan%20demo%20sistemnya.";
const waLinkKonsultasi = "https://api.whatsapp.com/send?phone=6285234104446&text=Halo%20Renggani%2C%20saya%20ingin%20konsultasi%20mengenai%20penggunaan%20BukuBatik%20untuk%20usaha%20saya.";
---

<section class="py-16 px-5 lg:px-20 bg-gray-50 dark:bg-gray-900 font-roboto relative overflow-hidden">
    <!-- Ambient Background Lighting -->
    <div class="absolute -top-40 right-0 w-96 h-96 bg-purple-600/15 rounded-full blur-[140px] pointer-events-none"></div>
    <div class="absolute bottom-10 left-0 w-96 h-96 bg-blue-600/15 rounded-full blur-[140px] pointer-events-none"></div>

    <div class="max-w-7xl mx-auto">
        <!-- Section Header -->
        <div class="text-center max-w-3xl mx-auto mb-16">
            <span class="text-xs lg:text-sm font-semibold tracking-wider text-purple-600 dark:text-purple-400 uppercase bg-purple-100 dark:bg-purple-950/60 px-4 py-1.5 rounded-full border border-purple-200 dark:border-purple-800/50 inline-block mb-3">
                Produk Unggulan Renggani
            </span>
            <h2 class="text-3xl lg:text-4xl font-bold dark:text-white text-gray-900 tracking-tight">
                BukuBatik — Sistem Akuntansi & Operasional Cerdas
            </h2>
            <p class="text-base lg:text-lg text-gray-600 dark:text-gray-400 mt-4 leading-relaxed">
                Kelola bisnis batik dan UMKM Anda jadi lebih pintar. Platform akuntansi serba bisa yang efisien, mudah digunakan, dan dirancang khusus untuk memenuhi kebutuhan pembukuan industri batik nasional.
            </p>
        </div>

        <!-- Main Product Card / Showcase Hero -->
        <div class="grid lg:grid-cols-12 gap-10 items-center bg-white dark:bg-gray-800/80 backdrop-blur-xl border border-gray-200 dark:border-gray-700/60 rounded-3xl p-6 lg:p-10 shadow-xl relative z-10 mb-20">
            <!-- Left Side: Product Details & Badges -->
            <div class="lg:col-span-6 space-y-6">
                <div class="inline-flex items-center gap-2 bg-gradient-to-r from-purple-600 to-indigo-600 text-white px-4 py-1.5 rounded-full text-xs font-medium shadow-md">
                    <Icon name="mdi:check-decagram" class="text-sm" />
                    <span>Terpercaya: Digunakan oleh 2,000+ UMKM</span>
                </div>

                <h3 class="text-3xl lg:text-4xl font-extrabold text-gray-900 dark:text-white leading-tight">
                    Kelola Bisnis Batik Jadi Lebih <span class="bg-gradient-to-r from-purple-600 to-indigo-500 bg-clip-text text-transparent">Pintar & Efisien</span>.
                </h3>

                <p class="text-gray-600 dark:text-gray-300 leading-relaxed text-sm lg:text-base">
                    BukuBatik hadir sebagai solusi pembukuan komprehensif. Mulai dari pencatatan faktur penjualan batik, pengawasan piutang jatuh tempo, manajemen inventaris bahan, hingga penyusunan laporan keuangan otomatis tanpa perlu keahlian akuntansi yang rumit.
                </p>

                <!-- Highlights List -->
                <ul class="space-y-3 pt-2 text-sm text-gray-700 dark:text-gray-300">
                    <li class="flex items-center gap-3">
                        <div class="w-6 h-6 rounded-full bg-purple-100 dark:bg-purple-900/50 text-purple-600 dark:text-purple-400 flex items-center justify-center shrink-0">
                            <Icon name="mdi:check-bold" class="text-sm" />
                        </div>
                        <span>Interface Dark & Light Mode Modern & Responsif</span>
                    </li>
                    <li class="flex items-center gap-3">
                        <div class="w-6 h-6 rounded-full bg-purple-100 dark:bg-purple-900/50 text-purple-600 dark:text-purple-400 flex items-center justify-center shrink-0">
                            <Icon name="mdi:check-bold" class="text-sm" />
                        </div>
                        <span>Otomatisasi Laporan Laba Rugi & Neraca Keuangan</span>
                    </li>
                    <li class="flex items-center gap-3">
                        <div class="w-6 h-6 rounded-full bg-purple-100 dark:bg-purple-900/50 text-purple-600 dark:text-purple-400 flex items-center justify-center shrink-0">
                            <Icon name="mdi:check-bold" class="text-sm" />
                        </div>
                        <span>Radar Analisis Performa & Tingkat Kesehatan Pelanggan</span>
                    </li>
                </ul>

                <!-- CTA Action Buttons -->
                <div class="flex flex-wrap gap-4 pt-4">
                    <a
                        href={waLinkPenawaran}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center justify-center gap-2.5 bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-700 hover:to-indigo-700 text-white font-semibold px-7 py-3.5 rounded-full shadow-lg shadow-purple-500/25 hover:shadow-purple-500/40 transition-all duration-300 transform hover:-translate-y-0.5 text-sm lg:text-base"
                    >
                        <Icon name="mdi:whatsapp" class="text-xl" />
                        <span>Ajukan Penawaran</span>
                    </a>
                    <a
                        href={waLinkKonsultasi}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center justify-center gap-2 bg-gray-100 hover:bg-gray-200 dark:bg-gray-700 dark:hover:bg-gray-600 text-gray-800 dark:text-white font-semibold px-6 py-3.5 rounded-full transition-all duration-300 text-sm lg:text-base"
                    >
                        <span>Konsultasi Gratis</span>
                        <Icon name="mdi:arrow-right" class="text-lg" />
                    </a>
                </div>
            </div>

            <!-- Right Side: Image Showcase Preview -->
            <div class="lg:col-span-6 relative">
                <div class="relative rounded-2xl overflow-hidden shadow-2xl border border-purple-500/20 group">
                    <Image
                        src={bukuBatikImg}
                        alt="Tampilan Sistem Akuntansi BukuBatik"
                        class="w-full h-auto object-cover transform group-hover:scale-105 transition-transform duration-500"
                        quality={95}
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-gray-950/70 via-transparent to-transparent opacity-80 group-hover:opacity-60 transition-opacity"></div>
                    <div class="absolute bottom-4 left-4 right-4 p-4 bg-white/10 dark:bg-gray-900/60 backdrop-blur-md rounded-xl border border-white/20 text-white">
                        <p class="font-semibold text-sm">Dashboard & Sistem Akuntansi BukuBatik</p>
                        <p class="text-xs text-gray-300">Tampilan intuitif dengan manajemen penjualan, biaya, dan piutang.</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Features Grid -->
        <div class="mb-16">
            <div class="text-center max-w-2xl mx-auto mb-12">
                <h3 class="text-2xl lg:text-3xl font-bold dark:text-white text-gray-900">
                    Fitur Utama BukuBatik
                </h3>
                <p class="text-sm lg:text-base text-gray-600 dark:text-gray-400 mt-2">
                    Dirancang lengkap untuk memenuhi siklus akuntansi dan operasional bisnis Anda.
                </p>
            </div>

            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
                {features.map((item) => (
                    <div class="bg-white dark:bg-gray-800/60 p-6 rounded-2xl border border-gray-200 dark:border-gray-700/60 hover:border-purple-500 dark:hover:border-purple-500/60 transition-all duration-300 hover:shadow-xl group">
                        <div class="w-12 h-12 rounded-xl bg-purple-100 dark:bg-purple-900/40 text-purple-600 dark:text-purple-400 flex items-center justify-center mb-5 group-hover:bg-purple-600 group-hover:text-white transition-colors duration-300">
                            <Icon name={item.icon} class="text-2xl" />
                        </div>
                        <h4 class="text-lg font-bold text-gray-900 dark:text-white mb-2">
                            {item.title}
                        </h4>
                        <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed">
                            {item.desc}
                        </p>
                    </div>
                ))}
            </div>
        </div>

        <!-- Custom Product Solutions Section -->
        <div class="bg-gradient-to-r from-blue-900 via-indigo-900 to-purple-950 rounded-3xl p-8 lg:p-12 text-white relative overflow-hidden shadow-2xl">
            <div class="absolute right-0 bottom-0 opacity-10 pointer-events-none">
                <Icon name="mdi:cellphone-link" class="text-[300px]" />
            </div>
            <div class="relative z-10 max-w-3xl space-y-4">
                <span class="text-xs font-semibold uppercase tracking-wider bg-white/10 text-purple-200 px-3.5 py-1 rounded-full border border-white/20 inline-block">
                    Solusi Custom Software
                </span>
                <h3 class="text-2xl lg:text-4xl font-bold">
                    Butuh Produk Software Khusus Sesuai Alur Bisnis Anda?
                </h3>
                <p class="text-gray-300 text-sm lg:text-base leading-relaxed">
                    Selain produk siap pakai seperti BukuBatik, tim Renggani Karya Semesta berpengalaman membangun solusi ERP, CRM, E-Commerce, dan Aplikasi Mobile custom tailored khusus untuk skala industri Anda.
                </p>
                <div class="pt-4">
                    <a
                        href={waLinkPenawaran}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-2 bg-white text-gray-900 hover:bg-purple-50 font-bold px-7 py-3.5 rounded-full transition-all duration-300 shadow-lg text-sm lg:text-base"
                    >
                        <Icon name="mdi:whatsapp" class="text-xl text-green-600" />
                        <span>Ajukan Penawaran Kebutuhan Custom</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
