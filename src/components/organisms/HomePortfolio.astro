---
import PortfolioHomeContent from "@components/molecules/PortfolioHomeContent";
import PortfolioHomeButtonCategory from "@components/atoms/PortfolioHomeButtonCategory";
import laboutiqueImg from "@assets/laboutique.png";
import webappsRestoandaImg from "@assets/webapps-restoanda.png";
import valeriaImg from "@assets/valeria.png";
import sysBookingImg from "@assets/sys-booking.png";
import gciImg from "@assets/gci.png";
import plnbekasiImg from "@assets/plnbekasi.png";
import mobileMajangAksiImg from "@assets/mobile-majang-aksi.jpg";
import mobileRestoandaImg from "@assets/mobile-restoanda.png";
import santiImg from "@assets/santi.png";
import bukuBatikImg from "@assets/buku-batik.png";
import dlhImg from "@assets/dlh.png";
import { getCollection } from "astro:content";

const portfolioImageMap: Record<string, ImageMetadata> = {
    "../../assets/laboutique.png": laboutiqueImg,
    "../../assets/webapps-restoanda.png": webappsRestoandaImg,
    "../../assets/valeria.png": valeriaImg,
    "../../assets/sys-booking.png": sysBookingImg,
    "../../assets/gci.png": gciImg,
    "../../assets/plnbekasi.png": plnbekasiImg,
    "../../assets/mobile-majang-aksi.jpg": mobileMajangAksiImg,
    "../../assets/mobile-restoanda.png": mobileRestoandaImg,
    "../../assets/santi.png": santiImg,
    "../../assets/buku-batik.png": bukuBatikImg,
    "../../assets/dlh.png": dlhImg,
};

const rawPortfolios = await getCollection("portfolios");
const portfolios = rawPortfolios.map((item) => {
    const rawImg = item.data.image;
    const imgObj = typeof rawImg === "string" ? portfolioImageMap[rawImg] : rawImg;
    const resolvedSrc = imgObj && typeof imgObj === "object" && "src" in imgObj ? imgObj.src : String(rawImg);
    const resolvedWidth = imgObj && typeof imgObj === "object" && "width" in imgObj ? imgObj.width : 500;
    const resolvedHeight = imgObj && typeof imgObj === "object" && "height" in imgObj ? imgObj.height : 500;
    const resolvedFormat = imgObj && typeof imgObj === "object" && "format" in imgObj ? (imgObj.format as any) : "webp";

    return {
        id: item.id,
        slug: item.id,
        body: item.body,
        collection: item.collection,
        data: {
            title: item.data.title,
            category: item.data.category,
            created_at: item.data.created_at,
            image: {
                src: resolvedSrc,
                width: resolvedWidth,
                height: resolvedHeight,
                format: resolvedFormat
            }
        }
    };
});
portfolios.sort((a, b) => new Date(b.data.created_at).getTime() - new Date(a.data.created_at).getTime());
const categories = [
    "Terbaru",
    "Web Apps",
    "Mobile Apps",
    "Desktop Apps",
    "Website",
    "Website Design",
    "ERP",
    "CRM",
    "E-Learning",
    "E-Commerce",
    "IoT",
    "Artificial Intelligence",
    "BOT",
];
---

<section
    class="min-h-[500px] backdrop-blur-md z-10 relative bg-gray-50 py-10 dark:bg-gray-900"
>
    <div
        class="absolute h-52 from-blue-800 to-gray-50 right-0 bottom-0 blur-[180px] bg-gradient-to-tl dark:blur-[180px] dark:to-gray-900 w-1/2"
    >
    </div>
    <div
        class="absolute w-64 h-52 bg-cyan-500 left-0 bottom-0 dark:hidden blur-[180px]"
    >
    </div>
    <article class="relative px-5 border-blue-100 dark:border-gray-700 border-b-2 mb-5 lg:px-20">
        <p
            class="text-xs lg:text-base dark:text-white dark:border-gray-200 text-blue-800 font-medium font-roboto border-b-2 border-blue-800 inline pb-2"
        >
            Portofolio Kami
        </p>
        <div class="grid lg:grid-cols-2 lg:gap-10 mb-10">
            <h2
                class="lg:text-4xl text-2xl font-bold font-roboto mt-5 dark:text-white"
            >
                Proyek Unggulan Kami
            </h2>
            <p class="lg:text-lg text-sm dark:text-gray-500">
                Setiap proyek dirancang untuk menginspirasi dan memberikan hasil
                luar biasa bagi klien kami.
            </p>
        </div>
        <swiper-container
            class="swiper-portfolio"
            controller-control=".swiper-portfolio"
            slides-per-view="auto"
            space-between="20"
            mousewheel="true"
            free-mode="true"
        >
            {
                categories.map((data, index) => (
                    <swiper-slide key={index} class="pb-5 w-max">
                        <PortfolioHomeButtonCategory
                            client:visible
                            category={data}
                        />
                    </swiper-slide>
                ))
            }
        </swiper-container>
    </article>
    <PortfolioHomeContent client:visible portfolios={portfolios} />
</section>
<script>
    import { register } from "swiper/element/bundle";
    register();
</script>
