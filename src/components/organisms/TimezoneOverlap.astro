---
import SectionHeader from "@components/molecules/SectionHeader.astro";

interface Props {
  title: string;
  description?: string;
  rows: { city: string; zone: string; offset: string; window: string; overlapLabel: string; startPct: number; widthPct: number; tone: "emerald" | "blue" }[];
  id?: string;
  class?: string;
}

const { title, description, rows, id, class: customClass = "" } = Astro.props;
---

<section id={id} class:list={["py-16 md:py-24 bg-slate-50 border-y border-slate-200/80", customClass]}>
  <div class="max-w-6xl mx-auto px-5 lg:px-8">
    <SectionHeader title={title} description={description} />
    <div class="mt-10 rounded-3xl border border-slate-200/80 bg-white p-6 md:p-8">
      <div class="space-y-7">
        {rows.map((row) => (
          <div class="grid gap-3 md:grid-cols-[10rem_1fr_auto] md:items-center">
            <div class="w-40 shrink-0">
              <p class="font-bold text-slate-900">{row.city}</p>
              <p class="text-xs text-slate-500">{row.zone} - {row.offset}</p>
            </div>
            <div>
              <div class="relative h-8 rounded-full bg-slate-100">
                <div
                  class:list={["absolute inset-y-0 rounded-full", row.tone === "emerald" ? "bg-emerald-500/80" : "bg-blue-600/80"]}
                  style={`left:${row.startPct}%; width:${row.widthPct}%`}
                ></div>
              </div>
              <p class="mt-2 text-[11px] text-slate-500">{row.window}</p>
            </div>
            <p class:list={["text-xs font-semibold md:text-right", row.tone === "emerald" ? "text-emerald-700" : "text-blue-700"]}>{row.overlapLabel}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
