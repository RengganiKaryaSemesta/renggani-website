---
interface Props {
  href: string;
  variant?: "primary" | "secondary" | "whatsapp" | "outline";
  size?: "sm" | "md" | "lg";
  target?: string;
  rel?: string;
  class?: string;
  id?: string;
}

const {
  href,
  variant = "primary",
  size = "md",
  target = "_blank",
  rel = "noopener noreferrer",
  class: customClass = "",
  id,
} = Astro.props;

const sizeStyles = {
  sm: "px-4 py-2 text-xs font-semibold rounded-lg gap-1.5",
  md: "px-5 py-2.5 text-sm font-semibold rounded-xl gap-2",
  lg: "px-7 py-3.5 text-base font-bold rounded-2xl gap-2.5",
};

const variantStyles = {
  primary:
    "bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white shadow-lg shadow-emerald-600/25 hover:shadow-emerald-500/40 hover:-translate-y-0.5 active:translate-y-0 active:scale-[0.98]",
  whatsapp:
    "bg-emerald-600 hover:bg-emerald-500 text-white shadow-lg shadow-emerald-600/25 hover:shadow-emerald-500/35 hover:-translate-y-0.5 active:translate-y-0 active:scale-[0.98]",
  secondary:
    "bg-slate-900 dark:bg-white text-white dark:text-slate-900 hover:bg-slate-800 dark:hover:bg-slate-100 shadow-sm hover:-translate-y-0.5 active:translate-y-0 active:scale-[0.98]",
  outline:
    "border border-slate-300 dark:border-slate-700 hover:border-emerald-500 dark:hover:border-emerald-400 text-slate-700 dark:text-slate-200 hover:text-emerald-600 dark:hover:text-emerald-400 bg-white/60 dark:bg-slate-900/60 backdrop-blur-sm",
};
---

<a
  href={href}
  target={target}
  rel={rel}
  id={id}
  class:list={[
    "inline-flex items-center justify-center transition-all duration-200 text-center select-none cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2",
    sizeStyles[size],
    variantStyles[variant],
    customClass,
  ]}
>
  <slot />
</a>
