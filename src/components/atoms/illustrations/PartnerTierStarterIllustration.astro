---
interface Props {
  class?: string;
}

const { class: customClass = '' } = Astro.props;
---

<div class:list={['w-full max-w-xs mx-auto select-none', customClass]} aria-hidden="true">
  <svg viewBox="0 0 320 160" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto">
    <defs>
      <linearGradient id="starterGrad" x1="0" y1="0" x2="320" y2="160" gradientUnits="userSpaceOnUse">
        <stop stop-color="#F0F9FF" />
        <stop offset="1" stop-color="#E0F2FE" />
      </linearGradient>
    </defs>

    <!-- Background card -->
    <rect width="320" height="160" rx="16" fill="url(#starterGrad)" stroke="#BAE6FD" stroke-width="1.5" />

    <!-- Center illustration: Link / Share / 1-3 Client Seedling -->
    <g transform="translate(40, 20)">
      <!-- Main Tablet/Screen -->
      <rect x="50" y="15" width="140" height="90" rx="12" fill="#FFFFFF" stroke="#0284C7" stroke-width="1.5" />
      <rect x="58" y="23" width="124" height="16" rx="6" fill="#F0F9FF" />
      
      <!-- Referral Link pill -->
      <circle cx="70" cy="31" r="4" fill="#0284C7" />
      <rect x="80" y="28" width="60" height="6" rx="3" fill="#BAE6FD" />

      <!-- Client Nodes connecting -->
      <circle cx="85" cy="70" r="14" fill="#E0F2FE" stroke="#0284C7" stroke-width="1.5" />
      <path d="M80 74 C80 70 82 68 85 68 C88 68 90 70 90 74 M85 66 A3 3 0 1 0 85 60 A3 3 0 0 0 85 66" stroke="#0284C7" stroke-width="1.5" stroke-linecap="round" />

      <!-- Arrow Flow -->
      <path d="M105 70 H130" stroke="#0284C7" stroke-width="2" stroke-dasharray="3 3" />
      <polygon points="132,70 126,67 126,73" fill="#0284C7" />

      <!-- Success Check Node -->
      <circle cx="150" cy="70" r="14" fill="#0284C7" />
      <path d="M144 70 L148 74 L156 66" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    </g>

    <!-- Floating 5% Badge -->
    <g transform="translate(195, 20)">
      <rect width="90" height="34" rx="17" fill="#0284C7" filter="drop-shadow(0 4px 6px rgba(2, 132, 199, 0.25))" />
      <text x="45" y="22" fill="#FFFFFF" font-family="system-ui" font-size="13" font-weight="700" text-anchor="middle">Tier 5%</text>
    </g>

    <!-- Label Subtext -->
    <text x="160" y="142" fill="#0369A1" font-family="system-ui" font-size="11" font-weight="600" text-anchor="middle">1 - 3 Klien Aktif Berlangganan</text>
  </svg>
</div>
