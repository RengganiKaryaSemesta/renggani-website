---
interface Props {
  class?: string;
}

const { class: customClass = '' } = Astro.props;
---

<div class:list={['relative w-full max-w-2xl mx-auto select-none', customClass]} aria-hidden="true">
  <svg
    viewBox="0 0 680 480"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    class="w-full h-auto drop-shadow-xl"
  >
    <defs>
      <linearGradient id="heroBgGrad" x1="50" y1="30" x2="630" y2="450" gradientUnits="userSpaceOnUse">
        <stop stop-color="#1E3A8A" stop-opacity="0.08" />
        <stop offset="1" stop-color="#0284C7" stop-opacity="0.02" />
      </linearGradient>

      <linearGradient id="cardGrad" x1="0" y1="0" x2="360" y2="240" gradientUnits="userSpaceOnUse">
        <stop stop-color="#FFFFFF" />
        <stop offset="1" stop-color="#F8FAFC" />
      </linearGradient>

      <linearGradient id="blueGlow" x1="0" y1="0" x2="1" y2="1">
        <stop stop-color="#2563EB" />
        <stop offset="1" stop-color="#1D4ED8" />
      </linearGradient>

      <linearGradient id="emeraldGlow" x1="0" y1="0" x2="1" y2="1">
        <stop stop-color="#10B981" />
        <stop offset="1" stop-color="#059669" />
      </linearGradient>

      <linearGradient id="amberGlow" x1="0" y1="0" x2="1" y2="1">
        <stop stop-color="#F59E0B" />
        <stop offset="1" stop-color="#D97706" />
      </linearGradient>

      <filter id="softShadow" x="-10%" y="-10%" width="125%" height="125%" filterUnits="userSpaceOnUse">
        <feDropShadow dx="0" dy="12" stdDeviation="16" flood-color="#0F172A" flood-opacity="0.08" />
      </filter>

      <filter id="pillShadow" x="-20%" y="-20%" width="140%" height="140%" filterUnits="userSpaceOnUse">
        <feDropShadow dx="0" dy="6" stdDeviation="8" flood-color="#0F172A" flood-opacity="0.1" />
      </filter>
    </defs>

    <!-- Subtle Ambient Geometry & Grid Lines -->
    <rect x="20" y="20" width="640" height="440" rx="28" fill="url(#heroBgGrad)" stroke="#E2E8F0" stroke-width="1.5" stroke-dasharray="6 6" />
    <circle cx="340" cy="240" r="180" stroke="#CBD5E1" stroke-width="1" stroke-opacity="0.5" />
    <circle cx="340" cy="240" r="230" stroke="#CBD5E1" stroke-width="1" stroke-opacity="0.3" stroke-dasharray="4 8" />

    <!-- Central SaaS Dashboard Canvas -->
    <g filter="url(#softShadow)">
      <rect x="150" y="70" width="380" height="250" rx="18" fill="url(#cardGrad)" stroke="#CBD5E1" stroke-width="1.5" />

      <!-- Dashboard Window Header -->
      <rect x="150" y="70" width="380" height="38" rx="18" fill="#F1F5F9" />
      <rect x="150" y="88" width="380" height="20" fill="#F1F5F9" />
      <circle cx="174" cy="89" r="5" fill="#EF4444" />
      <circle cx="190" cy="89" r="5" fill="#F59E0B" />
      <circle cx="206" cy="89" r="5" fill="#10B981" />
      <rect x="230" y="81" width="160" height="16" rx="8" fill="#E2E8F0" />
      <text x="250" y="93" fill="#64748B" font-family="monospace" font-size="9" font-weight="600">rks.partner/portal</text>

      <!-- Dashboard Chart & UI Rows -->
      <!-- Mini Metric Block 1 -->
      <rect x="174" y="124" width="95" height="52" rx="10" fill="#FFFFFF" stroke="#E2E8F0" />
      <text x="186" y="142" fill="#64748B" font-family="system-ui" font-size="9" font-weight="500">Klien Aktif</text>
      <text x="186" y="163" fill="#0F172A" font-family="system-ui" font-size="16" font-weight="700">18 Klien</text>

      <!-- Mini Metric Block 2 -->
      <rect x="281" y="124" width="115" height="52" rx="10" fill="#FFFFFF" stroke="#E2E8F0" />
      <text x="293" y="142" fill="#64748B" font-family="system-ui" font-size="9" font-weight="500">Tier Kemitraan</text>
      <rect x="293" y="148" width="85" height="18" rx="9" fill="#FEF3C7" />
      <text x="303" y="161" fill="#B45309" font-family="system-ui" font-size="10" font-weight="700">Strategis 25%</text>

      <!-- Mini Metric Block 3 -->
      <rect x="408" y="124" width="102" height="52" rx="10" fill="#FFFFFF" stroke="#E2E8F0" />
      <text x="420" y="142" fill="#64748B" font-family="system-ui" font-size="9" font-weight="500">Payout Bulan Ini</text>
      <text x="420" y="163" fill="#059669" font-family="system-ui" font-size="14" font-weight="700">Rp4.850.000</text>

      <!-- Revenue Growth Area Chart (SVG Path) -->
      <rect x="174" y="190" width="336" height="110" rx="10" fill="#FFFFFF" stroke="#E2E8F0" />
      <line x1="190" y1="270" x2="495" y2="270" stroke="#F1F5F9" stroke-width="1.5" />
      <line x1="190" y1="240" x2="495" y2="240" stroke="#F1F5F9" stroke-width="1.5" />
      <line x1="190" y1="210" x2="495" y2="210" stroke="#F1F5F9" stroke-width="1.5" />

      <!-- Area Path -->
      <path d="M190 270 L230 255 L280 245 L340 230 L390 205 L450 185 L495 160 L495 285 L190 285 Z" fill="#3B82F6" fill-opacity="0.1" />
      <!-- Line Path -->
      <path d="M190 270 L230 255 L280 245 L340 230 L390 205 L450 185 L495 160" stroke="#2563EB" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
      <circle cx="495" cy="160" r="5" fill="#2563EB" stroke="#FFFFFF" stroke-width="2" />
    </g>

    <!-- Floating Node Left: BukuBatik Product Card -->
    <g filter="url(#pillShadow)">
      <rect x="50" y="190" width="165" height="120" rx="16" fill="#FFFFFF" stroke="#E2E8F0" stroke-width="1.5" />
      <rect x="66" y="206" width="34" height="34" rx="8" fill="#DBEAFE" />
      <path d="M78 227 L88 215 L84 231 L90 231" stroke="#1D4ED8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      <text x="108" y="222" fill="#0F172A" font-family="system-ui" font-size="12" font-weight="700">BukuBatik</text>
      <text x="108" y="235" fill="#64748B" font-family="system-ui" font-size="9">Cloud Accounting</text>
      
      <line x1="66" y1="252" x2="199" y2="252" stroke="#F1F5F9" stroke-width="1.5" />
      <rect x="66" y="262" width="70" height="18" rx="6" fill="#EFF6FF" />
      <text x="73" y="275" fill="#1D4ED8" font-family="system-ui" font-size="9" font-weight="600">Recurring 25%</text>
      <text x="66" y="296" fill="#059669" font-family="system-ui" font-size="11" font-weight="700">Rp75.000 / bln</text>
    </g>

    <!-- Floating Node Right: RKSWorkmate Product Card -->
    <g filter="url(#pillShadow)">
      <rect x="470" y="200" width="170" height="120" rx="16" fill="#FFFFFF" stroke="#E2E8F0" stroke-width="1.5" />
      <rect x="486" y="216" width="34" height="34" rx="8" fill="#DCFCE7" />
      <path d="M497 236 V228 A6 6 0 0 1 509 228 V236 M494 240 H512" stroke="#059669" stroke-width="2" stroke-linecap="round" />
      <text x="528" y="232" fill="#0F172A" font-family="system-ui" font-size="12" font-weight="700">RKSWorkmate</text>
      <text x="528" y="245" fill="#64748B" font-family="system-ui" font-size="9">Smart HR & Payroll</text>
      
      <line x1="486" y1="262" x2="624" y2="262" stroke="#F1F5F9" stroke-width="1.5" />
      <rect x="486" y="272" width="70" height="18" rx="6" fill="#F0FDF4" />
      <text x="493" y="285" fill="#059669" font-family="system-ui" font-size="9" font-weight="600">Recurring 25%</text>
      <text x="486" y="306" fill="#059669" font-family="system-ui" font-size="11" font-weight="700">Rp87.500 / bln</text>
    </g>

    <!-- Connecting Dynamic Flow Cables / Data Beams -->
    <path d="M215 250 C260 250 250 210 280 200" stroke="#3B82F6" stroke-width="2" stroke-dasharray="4 4" fill="none" opacity="0.8" />
    <circle cx="248" cy="235" r="4" fill="#2563EB" />
    
    <path d="M470 260 C430 260 440 220 408 210" stroke="#10B981" stroke-width="2" stroke-dasharray="4 4" fill="none" opacity="0.8" />
    <circle cx="439" cy="242" r="4" fill="#10B981" />

    <!-- Bottom Center Highlight: Payout Settlement Badge -->
    <g filter="url(#softShadow)">
      <rect x="180" y="350" width="320" height="88" rx="20" fill="#0F172A" stroke="#1E293B" stroke-width="1.5" />
      
      <!-- Icon Shield / Check -->
      <circle cx="218" cy="394" r="22" fill="#1E293B" />
      <path d="M210 394 L216 400 L228 388" stroke="#10B981" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />

      <text x="252" y="384" fill="#94A3B8" font-family="system-ui" font-size="11" font-weight="500">Pencairan Otomatis ke Rekening</text>
      <text x="252" y="407" fill="#FFFFFF" font-family="system-ui" font-size="18" font-weight="700">Komisi Rutin Tiap Bulan</text>

      <!-- Verified Pill -->
      <rect x="415" y="380" width="70" height="26" rx="13" fill="#10B981" fill-opacity="0.15" stroke="#10B981" stroke-width="1" />
      <text x="428" y="397" fill="#34D399" font-family="system-ui" font-size="10" font-weight="700">100% PASTI</text>
    </g>

    <!-- Top Floating Sparkles & Indicators -->
    <g>
      <!-- Sparkle top-left -->
      <path d="M120 100 L124 110 L134 114 L124 118 L120 128 L116 118 L106 114 L116 110 Z" fill="#F59E0B" opacity="0.7" />
      <!-- Star top-right -->
      <circle cx="580" cy="110" r="18" fill="#DBEAFE" />
      <path d="M575 110 H585 M580 105 V115" stroke="#2563EB" stroke-width="2" stroke-linecap="round" />
    </g>
  </svg>
</div>
