---
interface Props {
  class?: string;
}

const { class: customClass = '' } = Astro.props;
---

<div class:list={['w-full max-w-xs mx-auto select-none', customClass]} aria-hidden="true">
  <svg viewBox="0 0 320 160" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto">
    <defs>
      <linearGradient id="proGrad" x1="0" y1="0" x2="320" y2="160" gradientUnits="userSpaceOnUse">
        <stop stop-color="#ECFDF5" />
        <stop offset="1" stop-color="#D1FAE5" />
      </linearGradient>
    </defs>

    <!-- Background Card -->
    <rect width="320" height="160" rx="16" fill="url(#proGrad)" stroke="#A7F3D0" stroke-width="1.5" />

    <!-- Center illustration: Multi-node network & ascending growth graph -->
    <g transform="translate(30, 20)">
      <!-- Main Hub Screen -->
      <rect x="55" y="15" width="150" height="90" rx="12" fill="#FFFFFF" stroke="#059669" stroke-width="1.5" />
      <rect x="63" y="23" width="134" height="16" rx="6" fill="#F0FDF4" />
      
      <!-- Network Nodes in Header -->
      <circle cx="75" cy="31" r="4" fill="#059669" />
      <circle cx="90" cy="31" r="4" fill="#10B981" />
      <circle cx="105" cy="31" r="4" fill="#34D399" />
      <rect x="120" y="28" width="65" height="6" rx="3" fill="#A7F3D0" />

      <!-- Ascending Bar Chart -->
      <rect x="75" y="72" width="14" height="22" rx="4" fill="#A7F3D0" />
      <rect x="97" y="62" width="14" height="32" rx="4" fill="#6EE7B7" />
      <rect x="119" y="52" width="14" height="42" rx="4" fill="#34D399" />
      <rect x="141" y="44" width="14" height="50" rx="4" fill="#059669" />

      <!-- Trend line arrow -->
      <path d="M75 66 L100 56 L122 46 L148 38" stroke="#047857" stroke-width="2" stroke-linecap="round" />
      <polygon points="152,36 144,35 147,43" fill="#047857" />
    </g>

    <!-- Floating 15% Badge -->
    <g transform="translate(195, 20)">
      <rect width="95" height="34" rx="17" fill="#059669" filter="drop-shadow(0 4px 6px rgba(5, 150, 105, 0.25))" />
      <text x="47" y="22" fill="#FFFFFF" font-family="system-ui" font-size="13" font-weight="700" text-anchor="middle">Tier 15%</text>
    </g>

    <!-- Label Subtext -->
    <text x="160" y="142" fill="#065F46" font-family="system-ui" font-size="11" font-weight="600" text-anchor="middle">4 - 10 Klien Aktif Berlangganan</text>
  </svg>
</div>
