---
interface Props {
  class?: string;
}

const { class: customClass = '' } = Astro.props;
---

<div class:list={['w-full max-w-xs mx-auto select-none', customClass]} aria-hidden="true">
  <svg viewBox="0 0 320 160" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto">
    <defs>
      <linearGradient id="eliteGrad" x1="0" y1="0" x2="320" y2="160" gradientUnits="userSpaceOnUse">
        <stop stop-color="#FFFBEB" />
        <stop offset="1" stop-color="#FEF3C7" />
      </linearGradient>
    </defs>

    <!-- Background Card -->
    <rect width="320" height="160" rx="16" fill="url(#eliteGrad)" stroke="#FDE68A" stroke-width="1.5" />

    <!-- Center illustration: Enterprise building & Golden Crown Vault -->
    <g transform="translate(35, 20)">
      <!-- Enterprise Dashboard Canvas -->
      <rect x="50" y="15" width="150" height="90" rx="12" fill="#FFFFFF" stroke="#D97706" stroke-width="1.5" />
      <rect x="58" y="23" width="134" height="16" rx="6" fill="#FFFBEB" />

      <!-- VIP Gold Emblem in header -->
      <circle cx="70" cy="31" r="5" fill="#D97706" />
      <polygon points="70,28 72,33 68,33" fill="#FFFFFF" />
      <rect x="82" y="28" width="70" height="6" rx="3" fill="#FDE68A" />

      <!-- Corporate Architecture & Crown/Shield -->
      <!-- Left Building -->
      <rect x="75" y="55" width="22" height="40" rx="3" fill="#FEF3C7" stroke="#D97706" stroke-width="1" />
      <rect x="80" y="62" width="4" height="4" fill="#D97706" />
      <rect x="88" y="62" width="4" height="4" fill="#D97706" />
      <rect x="80" y="72" width="4" height="4" fill="#D97706" />
      <rect x="88" y="72" width="4" height="4" fill="#D97706" />

      <!-- Center Tower with Shield -->
      <rect x="105" y="44" width="30" height="51" rx="4" fill="#F59E0B" />
      <!-- Star/Crown emblem -->
      <path d="M120 54 L123 60 L129 60 L124 64 L126 70 L120 66 L114 70 L116 64 L111 60 L117 60 Z" fill="#FFFFFF" />
      <rect x="115" y="76" width="10" height="19" rx="2" fill="#B45309" />

      <!-- Right Building -->
      <rect x="143" y="60" width="22" height="35" rx="3" fill="#FEF3C7" stroke="#D97706" stroke-width="1" />
      <rect x="148" y="66" width="4" height="4" fill="#D97706" />
      <rect x="156" y="66" width="4" height="4" fill="#D97706" />
      <rect x="148" y="76" width="4" height="4" fill="#D97706" />
      <rect x="156" y="76" width="4" height="4" fill="#D97706" />
    </g>

    <!-- Floating 25% Badge -->
    <g transform="translate(195, 20)">
      <rect width="95" height="34" rx="17" fill="#D97706" filter="drop-shadow(0 4px 6px rgba(217, 119, 6, 0.25))" />
      <text x="47" y="22" fill="#FFFFFF" font-family="system-ui" font-size="13" font-weight="700" text-anchor="middle">Tier 25%</text>
    </g>

    <!-- Label Subtext -->
    <text x="160" y="142" fill="#92400E" font-family="system-ui" font-size="11" font-weight="600" text-anchor="middle">&gt; 10 Klien Aktif / Enterprise</text>
  </svg>
</div>
