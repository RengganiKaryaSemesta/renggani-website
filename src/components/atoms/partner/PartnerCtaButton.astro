---
interface Props {
  href: string;
  variant?: 'primary' | 'whatsapp' | 'secondary' | 'outline' | 'emerald' | 'dark-outline';
  size?: 'sm' | 'md' | 'lg';
  target?: string;
  rel?: string;
  class?: string;
  id?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  target = '_blank',
  rel = 'noopener noreferrer',
  class: customClass = '',
  id,
} = Astro.props;

const sizeStyles = {
  sm: 'px-4 py-2 text-xs font-semibold rounded-lg gap-2',
  md: 'px-5 py-2.5 text-sm font-semibold rounded-xl gap-2',
  lg: 'px-7 py-3.5 text-base font-bold rounded-xl gap-2.5',
};

const variantStyles = {
  primary:
    'bg-blue-800 hover:bg-blue-900 text-white shadow-md shadow-blue-900/20 hover:shadow-lg hover:shadow-blue-900/30 hover:-translate-y-0.5 active:translate-y-0 active:scale-[0.98]',
  emerald:
    'bg-emerald-600 hover:bg-emerald-700 text-white shadow-md shadow-emerald-600/20 hover:shadow-lg hover:shadow-emerald-600/30 hover:-translate-y-0.5 active:translate-y-0 active:scale-[0.98]',
  whatsapp:
    'bg-emerald-600 hover:bg-emerald-700 text-white shadow-md shadow-emerald-600/25 hover:shadow-lg hover:shadow-emerald-600/35 hover:-translate-y-0.5 active:translate-y-0 active:scale-[0.98]',
  secondary:
    'bg-slate-900 hover:bg-slate-800 text-white dark:bg-white dark:text-slate-900 dark:hover:bg-slate-100 shadow-sm hover:-translate-y-0.5 active:translate-y-0 active:scale-[0.98]',
  outline:
    'border border-slate-300 dark:border-slate-700 hover:border-blue-700 text-slate-800 dark:text-slate-200 hover:text-blue-800 dark:hover:text-blue-300 bg-white/90 dark:bg-slate-900/90 backdrop-blur-sm hover:-translate-y-0.5 active:translate-y-0 active:scale-[0.98]',
  'dark-outline':
    'border border-white/30 hover:border-emerald-400 text-white hover:text-emerald-300 bg-white/10 hover:bg-white/15 backdrop-blur-sm shadow-sm hover:-translate-y-0.5 active:translate-y-0 active:scale-[0.98]',
};
---

<a
  href={href}
  target={target}
  rel={rel}
  id={id}
  class:list={[
    'inline-flex items-center justify-center transition-all duration-200 text-center select-none cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2',
    sizeStyles[size],
    variantStyles[variant],
    customClass,
  ]}
>
  <slot />
</a>
