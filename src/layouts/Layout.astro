---
import Header from "@components/organisms/Header.astro";
import Footer from "@components/organisms/Footer.astro";
import { ClientRouter } from "astro:transitions";
import SpeedInsights from "@vercel/speed-insights/astro";
import Analytics from "@vercel/analytics/astro";
import "../styles/global.css";

interface Props {
    title: string;
    description: string;
    image?: string;
    type?: string;
    isSolid?: boolean;
    keywords?: string;
    lang?: string;
}

const { 
    title, 
    description, 
    image = "/og-image.jpg", 
    type = "website",
    isSolid,
    keywords = "CV Renggani Karya Semesta, pengembangan web, pengembangan perangkat lunak, software house, e-commerce, website gratis, jasa pembuatan website, pembuatan aplikasi, IT solutions, solusi teknologi, teknologi informasi, web development, software development, mobile app development, jasa IT, digital marketing, desain web, website profesional, hosting web, manajemen konten, integrasi sistem, layanan IT, Banyuwangi, Bali",
    lang = Astro.currentLocale ?? "id",
} = Astro.props;

const siteURL = Astro.site ? Astro.site.origin : "https://rengganikaryasemesta.com";
let pathname = Astro.url.pathname;
if (!pathname.endsWith("/")) {
    pathname = `${pathname}/`;
}
const canonicalURL = new URL(pathname, siteURL).href;
const imageURL = image.startsWith("http") ? image : new URL(image, siteURL).href;

const isEn = lang === "en" || pathname.startsWith("/en/");
const ogLocale = isEn ? "en_AU" : "id_ID";
const enPathname = pathname.startsWith("/en/") ? pathname : `/en${pathname}`;
const idPathname = pathname.startsWith("/en/") ? pathname.replace(/^\/en/, "") || "/" : pathname;
---

<!doctype html>
<html lang={lang} class="light">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/svg+xml" href="/favicon.webp" />
        <link rel="canonical" href={canonicalURL} />
        <link rel="alternate" hreflang="id" href={new URL(idPathname, siteURL).href} />
        <link rel="alternate" hreflang="en" href={new URL(enPathname, siteURL).href} />
        <link rel="alternate" hreflang="x-default" href={new URL(idPathname, siteURL).href} />
        <meta name="generator" content={Astro.generator} />
        <ClientRouter />

        <!-- Primary Meta Tags -->
        <title>{title}</title>
        <meta name="title" content={title} />
        <meta name="description" content={description} />
        <meta name="robots" content="index, follow, max-image-preview:large" />
        <meta name="keywords" content={keywords} />

        <!-- Open Graph / Facebook / WhatsApp Meta Tags -->
        <meta property="og:site_name" content="CV. Renggani Karya Semesta" />
        <meta property="og:type" content={type} />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={imageURL} />
        <meta property="og:image:secure_url" content={imageURL} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:type" content="image/jpeg" />
        <meta property="og:image:alt" content={title} />
        <meta property="og:locale" content={ogLocale} />
        <meta property="fb:app_id" content="852463347946532" />

        <!-- Twitter Meta Tags -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:url" content={canonicalURL} />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={imageURL} />

        <!-- Google Site Verification -->
        <meta
            name="google-site-verification"
            content="7dviPrN0hKnhLyHuHhuvoUEt7caxYqUziESI7ZsUJDQ"
        />

        <!-- Global JSON-LD Schema (Organization & WebSite) -->
        <script is:inline type="application/ld+json" set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@graph": [
                {
                    "@type": "Organization",
                    "@id": "https://rengganikaryasemesta.com/#organization",
                    "name": "CV. Renggani Karya Semesta",
                    "url": "https://rengganikaryasemesta.com/",
                    "logo": {
                        "@type": "ImageObject",
                        "url": "https://rengganikaryasemesta.com/logo_color.webp",
                        "caption": "CV. Renggani Karya Semesta"
                    },
                    "description": "Software house terkemuka di Indonesia yang menyediakan solusi pengembangan web, aplikasi mobile, ERP, dan produk software unggulan seperti BukuBatik dan RKSWorkmate.",
                    "address": {
                        "@type": "PostalAddress",
                        "streetAddress": "Jl. Kemiren, Kemiren, Kec. Glagah",
                        "addressLocality": "Kabupaten Banyuwangi",
                        "addressRegion": "Jawa Timur",
                        "postalCode": "68432",
                        "addressCountry": "ID"
                    },
                    "contactPoint": {
                        "@type": "ContactPoint",
                        "telephone": "+6289512589756",
                        "contactType": "customer service",
                        "availableLanguage": ["Indonesian", "English"]
                    },
                    "sameAs": [
                        "https://www.instagram.com/rengganiks/",
                        "https://www.youtube.com/@rengganikaryasemesta"
                    ]
                },
                {
                    "@type": "WebSite",
                    "@id": "https://rengganikaryasemesta.com/#website",
                    "url": "https://rengganikaryasemesta.com/",
                    "name": "CV. Renggani Karya Semesta",
                    "publisher": {
                        "@id": "https://rengganikaryasemesta.com/#organization"
                    },
                    "inLanguage": "id-ID"
                }
            ]
        })} />

        <slot name="head" />
    </head>

    <body>
        <Header isSolid={isSolid} />
        <slot />
        <Footer />
        <SpeedInsights />
        <Analytics />
    </body>
</html>
