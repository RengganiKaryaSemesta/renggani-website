{
  "name": "rengganikaryasemesta-website",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check --minimum-severity hint && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint .",
    "check": "astro check --minimum-severity hint",
    "test:e2e": "playwright test",
    "audit:strict": "npm audit --audit-level=high",
    "precommit": "npm run audit:strict && astro check --minimum-severity hint && eslint .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,mjs,ts,tsx,astro}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/node": "^11.0.3",
    "@astrojs/react": "^4.0.2",
    "@astrojs/tailwind": "^6.0.2",
    "@astrojs/vercel": "^11.0.4",
    "@iconify-json/mdi": "^1.2.3",
    "@nanostores/react": "^0.7.3",
    "@sanity/astro": "^3.5.0",
    "@sanity/image-url": "^2.1.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^2.0.0",
    "astro": "^7.1.6",
    "astro-icon": "^1.1.5",
    "astro-portabletext": "^0.13.0",
    "groq": "^6.8.0",
    "nanostores": "^0.11.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "swiper": "^14.0.7",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "yargs-parser": "^21.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@typescript-eslint/parser": "^8.24.1",
    "eslint": "^9.21.0",
    "eslint-plugin-astro": "^1.3.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "sass": "^1.85.0"
  },
  "overrides": {
    "@astrojs/tailwind": {
      "astro": "$astro"
    },
    "@sanity/astro": {
      "astro": "$astro"
    },
    "js-yaml": "^4.1.0",
    "path-to-regexp": "^8.0.0",
    "undici": "^7.28.1",
    "uuid": "^11.1.1",
    "smol-toml": "^1.6.1",
    "esbuild": "^0.25.0",
    "sharp": "^0.35.0"
  }
}
